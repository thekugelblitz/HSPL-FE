---
import Layout from './Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
}

const { title, description, heading } = Astro.props;
---

<Layout title={title} description={description}>
  <Navbar />
  <main class="flex-1">
    <section class="relative bg-background pt-32 pb-16 border-b border-border/40">
      <div class="absolute inset-0 bg-primary/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
      <div class="container mx-auto px-4 max-w-4xl text-center relative z-10">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-6">
          {heading}
        </h1>
        <p class="text-xl text-muted-foreground">
          {description}
        </p>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="container mx-auto px-4 max-w-4xl">
        <div class="prose prose-lg dark:prose-invert max-w-none">
          <slot />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
