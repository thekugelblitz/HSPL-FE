---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import FloatingLeadWidget from '../components/blocks/FloatingLeadWidget.astro';
import ExitIntentModal from '../components/blocks/ExitIntentModal.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const { 
  title, 
  description = "HostingSpell provides ultra-fast NVMe cloud web hosting with free migration and 24/7 expert support.",
  image = "/og-image.png",
  canonical = Astro.url.href
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Preload Primary Variable Font for 0ms First Contentful Paint -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    
    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    
    <!-- Security -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="X-DNS-Prefetch-Control" content="on" />
    
    <!-- DNS Prefetch for external domains used in nav/footer -->
    <link rel="dns-prefetch" href="https://manage.hostingspell.com" />
    <link rel="dns-prefetch" href="https://wa.me" />
    
    <!-- Theme Color (matches dark nav bar) -->
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    
    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HostingSpell" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    
    <!-- Organization Structured Data for Google Knowledge Panel -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "HostingSpell",
      "url": "https://hostingspell.com",
      "logo": "https://hostingspell.com/logo-light.png",
      "description": "Ultra-fast NVMe cloud web hosting with free migration and 24/7 expert support.",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+91-94095-94000",
        "contactType": "sales",
        "availableLanguage": ["English", "Hindi"]
      },
      "sameAs": [
        "https://twitter.com/hostingspell"
      ]
    })} />
    
    <ClientRouter fallback="swap" />
    
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined') {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            return stored;
          }
          if (stored === 'system') {
            return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
      
      if (typeof localStorage !== 'undefined') {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
          if (localStorage.getItem('theme') === 'system') {
            document.documentElement.classList[e.matches ? 'add' : 'remove']('dark');
          }
        });
      }
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased">
    <slot />

    <FloatingLeadWidget />
    <ExitIntentModal />
    
    <script>
      document.addEventListener('astro:after-swap', () => {
        const stored = localStorage.getItem('theme');
        let theme = stored;
        if (!theme || theme === 'system') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.classList[theme === 'dark' ? 'add' : 'remove']('dark');
        window.scrollTo({ top: 0, behavior: 'instant' });
      });
    </script>
  </body>
</html>
