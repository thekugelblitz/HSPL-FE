---
// src/layouts/ProductPageTemplate.astro
// Consistent 5-section layout for all product pages (cloud, vps, reseller, etc.)
// Enforces the decluttered, transformation-focused structure from the implementation plan.

import Layout from './Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import FounderGuarantee from '../components/blocks/FounderGuarantee.astro';
import FaqAccordion from '../components/blocks/FaqAccordion.astro';
import ExitIntentModal from '../components/blocks/ExitIntentModal.astro';
import { StickyMobileBuyBar } from '../components/blocks/StickyMobileBuyBar';
import { Check, ArrowRight } from 'lucide-react';

interface Props {
  title: string;
  description?: string;
  
  // Hero section
  heroTag?: string;
  heroHeadline: string;
  heroSubheadline: string;
  heroCtaText?: string;
  heroCtaHref?: string;
  heroCheckpoints?: string[];
  heroPriceAnchor?: string;
  
  // FAQ
  faqs?: Array<{ question: string; answer: string }>;
  
  // Mobile sticky bar
  mobilePlanName?: string;
  mobilePlanPrice?: string;
  mobilePlanHref?: string;
}

const {
  title,
  description,
  heroTag = "Cloud Hosting",
  heroHeadline,
  heroSubheadline,
  heroCtaText = "See Plans",
  heroCtaHref = "#plans",
  heroCheckpoints = [],
  heroPriceAnchor,
  faqs = [],
  mobilePlanName,
  mobilePlanPrice,
  mobilePlanHref,
} = Astro.props;
---

<Layout title={title} description={description}>
  <Navbar />
  <main class="bg-background overflow-hidden flex-1">
    
    {/* ─── Section 1: Transformation Hero ─── */}
    <section class="relative overflow-hidden bg-background pt-16 pb-20 border-b border-border/40">
      <div class="absolute inset-0 bg-grid-pattern opacity-20 pointer-events-none"></div>
      <div class="absolute left-1/2 top-0 -z-0 h-[500px] w-[800px] -translate-x-1/2 -translate-y-1/3 rounded-full bg-primary/15 blur-[120px]"></div>
      
      <div class="container relative mx-auto max-w-screen-xl px-4 sm:px-8 z-10">
        <div class="max-w-3xl">
          {/* Tag */}
          <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-primary mb-5">
            <span class="flex h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
            {heroTag}
          </div>
          
          {/* Headline */}
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] mb-5">
            <Fragment set:html={heroHeadline} />
          </h1>
          
          {/* Subheadline */}
          <p class="text-base sm:text-lg text-muted-foreground font-medium max-w-2xl mb-6 leading-relaxed">
            {heroSubheadline}
          </p>
          
          {/* Checkpoints */}
          {heroCheckpoints.length > 0 && (
            <ul class="space-y-2.5 text-sm font-semibold text-foreground mb-6">
              {heroCheckpoints.map(cp => (
                <li class="flex items-center gap-2.5">
                  <div class="p-1 rounded-full bg-emerald-500/15 text-emerald-500 border border-emerald-500/30">
                    <Check className="w-3.5 h-3.5" />
                  </div>
                  <span>{cp}</span>
                </li>
              ))}
            </ul>
          )}
          
          {/* CTA */}
          <div class="flex flex-col sm:flex-row items-start gap-4">
            <a href={heroCtaHref} class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-primary hover:bg-primary/90 text-white font-bold text-base shadow-lg shadow-primary/25 transition-all">
              <span>{heroCtaText}</span>
              <ArrowRight className="w-4 h-4" />
            </a>
          </div>
          
          {/* Price Anchor */}
          {heroPriceAnchor && (
            <p class="text-xs font-medium text-muted-foreground mt-4">
              {heroPriceAnchor}
            </p>
          )}
        </div>
      </div>
    </section>
    
    {/* ─── Section 2: Key Outcomes (page provides via slot) ─── */}
    <slot name="outcomes" />
    
    {/* ─── Section 3: Pricing Plans (page provides via slot) ─── */}
    <slot name="pricing" />
    
    {/* ─── Section 4: Tech Specs / Deep-Dive (page provides via slot) ─── */}
    <slot name="details" />
    
    {/* ─── Section 5: Guarantee + FAQ ─── */}
    <FounderGuarantee />
    
    {faqs.length > 0 && (
      <section class="py-20 border-t border-border/40">
        <div class="container mx-auto px-4 max-w-screen-xl">
          <div class="text-center max-w-2xl mx-auto mb-12">
            <h2 class="text-3xl font-extrabold tracking-tight mb-3">Common Questions</h2>
            <p class="text-muted-foreground">Quick answers to help you make a confident decision.</p>
          </div>
          <div class="max-w-3xl mx-auto">
            <FaqAccordion faqs={faqs} />
          </div>
        </div>
      </section>
    )}
    
    {/* ─── Contextual CRO: Exit intent + sticky mobile bar (product pages only) ─── */}
    <ExitIntentModal />
    {mobilePlanName && mobilePlanPrice && mobilePlanHref && (
      <StickyMobileBuyBar client:media="(max-width: 768px)" />
    )}
    
    {/* Default slot for any extra content the page wants to add */}
    <slot />
  </main>
  <Footer />
</Layout>
