---
const year = new Date().getFullYear();
---
<footer class="border-t border-border/40 bg-muted/20">
  <div class="mx-auto max-w-screen-2xl px-4 sm:px-8 py-16">
    
    {/* Certified Partnerships & Industry Awards */}
    <div class="pb-10 mb-12 border-b border-border/30">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="text-center lg:text-left">
          <div class="text-xs font-black uppercase tracking-widest text-primary mb-1">Industry Recognitions</div>
          <h4 class="text-base font-black text-foreground">Accredited Partnerships & Awards</h4>
          <p class="text-xs text-muted-foreground mt-1 max-w-md">HostingSpell is an authorized cPanel Partner, Linode Solutions Partner, and a double award-winning host certified by HostAdvice.</p>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 w-full lg:w-auto">
          {/* Badge 1: cPanel Partner */}
          <div class="glass-card border border-border/50 p-4 rounded-2xl flex items-center gap-3.5 text-left hover:scale-[1.02] hover:border-[#FF6C2C]/30 transition-all duration-300 shadow-sm w-full sm:max-w-[260px] bg-card/40">
            <div class="p-2 rounded-xl bg-background border border-border/50 flex items-center justify-center shrink-0 w-11 h-11">
              <svg class="h-6 w-auto text-[#FF6C2C] fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
