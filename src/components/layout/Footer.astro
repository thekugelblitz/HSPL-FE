              </svg>
            </div>
            <div>
              <div class="text-[9px] font-black uppercase tracking-widest text-muted-foreground/80">Certified Partner</div>
              <div class="text-sm font-black text-foreground">cPanel®</div>
              <div class="text-[9px] font-bold text-orange-400">Authorized Partner</div>
            </div>
          </div>

          {/* Badge 2: Linode Partner */}
          <div class="glass-card border border-border/50 p-4 rounded-2xl flex items-center gap-3.5 text-left hover:scale-[1.02] hover:border-[#00A95C]/30 transition-all duration-300 shadow-sm w-full sm:max-w-[260px] bg-card/40">
            <div class="p-2 rounded-xl bg-background border border-border/50 flex items-center justify-center shrink-0 w-11 h-11">
              <svg class="h-6 w-auto text-[#00A95C] fill-current" viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg">
                <g>
                  <path d="M250 38.3L64.2 145.6v214.7L250 467.5l185.8-107.2V145.6L250 38.3zm136.2 301.6L250 417l-136.2-77.1V165.7L250 88.6l136.2 77.1v174.2z"/>
                  <path d="M250 148.9l-83.7 47.4v94.8l83.7 47.4 83.7-47.4v-94.8L250 148.9zm34.1 123l-34.1 19.3-34.1-19.3v-38.6l34.1-19.3 34.1 19.3v38.6z"/>
                </g>
              </svg>
            </div>
            <div>
              <div class="text-[9px] font-black uppercase tracking-widest text-muted-foreground/80">Cloud Integration</div>
              <div class="text-sm font-black text-foreground">Linode</div>
              <div class="text-[9px] font-bold text-emerald-400">Solutions Partner</div>
            </div>
          </div>

          {/* Badge 3: HostAdvice Top 10 */}
          <div class="glass-card border border-border/50 p-4 rounded-2xl flex items-center gap-3.5 text-left hover:scale-[1.02] hover:border-amber-500/30 transition-all duration-300 shadow-sm w-full sm:max-w-[260px] bg-card/40">
            <div class="p-2 rounded-xl bg-background border border-border/50 flex items-center justify-center shrink-0 w-11 h-11">
              <svg class="h-6 w-auto text-amber-500 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L2 22h20L12 2zm0 3.99L18.66 19H5.34L12 5.99z"/>
                <path d="M12 9l1.1 2.3 2.5.4-1.8 1.8.4 2.5-2.2-1.2-2.2 1.2.4-2.5-1.8-1.8 2.5-.4L12 9z"/>
              </svg>
            </div>
            <div>
              <div class="text-[9px] font-black uppercase tracking-widest text-muted-foreground/80">HostAdvice Award</div>
              <div class="text-sm font-black text-foreground">Top 10 Reseller</div>
              <div class="text-[9px] font-bold text-amber-500">2021 - 2026</div>
            </div>
          </div>

          {/* Badge 4: HostAdvice User Recommended */}
          <div class="glass-card border border-border/50 p-4 rounded-2xl flex items-center gap-3.5 text-left hover:scale-[1.02] hover:border-emerald-500/30 transition-all duration-300 shadow-sm w-full sm:max-w-[260px] bg-card/40">
            <div class="p-2 rounded-xl bg-background border border-border/50 flex items-center justify-center shrink-0 w-11 h-11">
              <svg class="h-6 w-auto text-emerald-400 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2c-3.86 0-7 3.14-7 7 0 2.24 1.05 4.22 2.69 5.5l-1.69 5.5 6-3 6 3-1.69-5.5C17.95 13.22 19 11.24 19 9c0-3.86-3.14-7-7-7zm0 10.5c-1.93 0-3.5-1.57-3.5-3.5s1.57-3.5 3.5-3.5 3.5 1.57 3.5 3.5-1.57 3.5-3.5 3.5z"/>
              </svg>
            </div>
            <div>
              <div class="text-[9px] font-black uppercase tracking-widest text-muted-foreground/80">HostAdvice Award</div>
              <div class="text-sm font-black text-foreground">Recommended</div>
              <div class="text-[9px] font-bold text-emerald-400">2021 - 2026</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-8 xl:gap-12">
      <div class="col-span-2 lg:col-span-2">
        <a class="flex items-center space-x-2 mb-6" href="/">
          <img src="/logo.png" alt="HostingSpell" class="h-10 object-contain dark:hidden" />
          <img src="/logo-light.png" alt="HostingSpell" class="h-10 object-contain hidden dark:block" />
        </a>
        <p class="text-sm text-muted-foreground mb-6">
          Fast, secure, and developer-centric cloud web hosting platform. Powered by NVMe SSD, LiteSpeed Enterprise, and 24/7 expert human support.
        </p>

        {/* Live Network Status Indicator */}
        <a href="/network-status" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-xs font-semibold text-emerald-400 hover:bg-emerald-500/20 transition-all mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>🟢 All Systems Operational (99.99%)</span>
        </a>

        <div class="flex items-center gap-4 text-muted-foreground">
          <a href="#" class="hover:text-primary transition-colors" aria-label="Twitter"><svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg></a>
          <a href="#" class="hover:text-primary transition-colors" aria-label="GitHub"><svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg></a>
          <a href="#" class="hover:text-primary transition-colors" aria-label="Instagram"><svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg></a>
        </div>
      </div>
      
      <div>
        <h3 class="font-bold mb-4 text-sm tracking-wide">Hosting & Services</h3>
        <ul class="space-y-3 text-sm text-muted-foreground">
          <li><a href="/cloud-hosting" class="hover:text-primary transition-colors">Cloud NVMe Hosting</a></li>
          <li><a href="/premium-hosting" class="hover:text-primary transition-colors">cPanel Premium Hosting</a></li>
          <li><a href="/wordpress-hosting" class="hover:text-primary transition-colors">Managed WordPress</a></li>
          <li><a href="/nodejs-hosting" class="hover:text-primary transition-colors">Node.js Hosting</a></li>
          <li><a href="/python-hosting" class="hover:text-primary transition-colors">Python Hosting</a></li>
          <li><a href="/vps" class="hover:text-primary transition-colors">KVM VPS Hosting</a></li>
          <li><a href="/reseller" class="hover:text-primary transition-colors">Reseller WHM Hosting</a></li>
          <li><a href="/combo-hosting" class="hover:text-primary transition-colors">Combo Free Domain</a></li>
          <li><a href="/pricing" class="hover:text-primary transition-colors">Full Pricing Matrix</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-bold mb-4 text-sm tracking-wide">Domains</h3>
        <ul class="space-y-3 text-sm text-muted-foreground">
          <li><a href="/domain" class="hover:text-primary transition-colors">Register Domain</a></li>
          <li><a href="/domain" class="hover:text-primary transition-colors">Transfer Domain</a></li>
          <li><a href="/domain" class="hover:text-primary transition-colors">Domain TLD Pricing</a></li>
          <li><a href="/domain" class="hover:text-primary transition-colors">Free DNS Management</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-bold mb-4 text-sm tracking-wide">Company</h3>
        <ul class="space-y-3 text-sm text-muted-foreground">
          <li><a href="/about" class="hover:text-primary transition-colors">About Us</a></li>
          <li><a href="/contact" class="hover:text-primary transition-colors">Contact Support</a></li>
          <li><a href="/blog" class="hover:text-primary transition-colors">Engineering Blog</a></li>
          <li><a href="/affiliates" class="hover:text-primary transition-colors">Affiliate Program</a></li>
          <li><a href="/showcase" class="hover:text-primary transition-colors">Client Showcase</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-bold mb-4 text-sm tracking-wide">Resources</h3>
        <ul class="space-y-3 text-sm text-muted-foreground">
          <li><a href="https://manage.hostingspell.com" target="_blank" rel="noopener" class="hover:text-primary transition-colors">Client Portal</a></li>
          <li><a href="https://manage.hostingspell.com/submitticket.php" target="_blank" rel="noopener" class="hover:text-primary transition-colors">Submit Ticket</a></li>
          <li><a href="/knowledgebase" class="hover:text-primary transition-colors">Knowledgebase</a></li>
          <li><a href="/network-status" class="hover:text-primary transition-colors">System Status</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-bold mb-4 text-sm tracking-wide">Legal & Policies</h3>
        <ul class="space-y-3 text-sm text-muted-foreground">
          <li><a href="/terms" class="hover:text-primary transition-colors">Terms of Service</a></li>
          <li><a href="/privacy" class="hover:text-primary transition-colors">Privacy Policy</a></li>
          <li><a href="/refund" class="hover:text-primary transition-colors">Refund Guarantee</a></li>
          <li><a href="/acceptable-use" class="hover:text-primary transition-colors">Acceptable Use Policy</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-border/40 flex flex-col md:flex-row items-center justify-between text-sm text-muted-foreground">
      <p>&copy; {year} HostingSpell. All rights reserved. cPanel® and LiteSpeed® are registered trademarks of their respective owners.</p>
      <div class="flex items-center gap-4 mt-4 md:mt-0 text-xs">
        <span class="text-muted-foreground">Datacenters: US • IN • DE • SG</span>
      </div>
    </div>
  </div>
</footer>
