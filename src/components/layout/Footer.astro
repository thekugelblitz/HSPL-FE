    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-8 xl:gap-12">
      <div class="col-span-2 lg:col-span-2">
        <a class="flex items-center space-x-2 mb-6" href="/">
          <img
