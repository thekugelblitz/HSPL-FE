---
import { Button } from "@/components/ui/button";
import MegaMenu from "./MegaMenu.astro";
import { ThemeToggle } from "../ui/ThemeToggle";
---

<div class="bg-primary text-primary-foreground text-center text-xs py-1.5 font-medium relative z-50">
  <a href="/pricing" class="hover:underline flex items-center justify-center gap-2">
    🎉 Get 10% OFF on all Hosting plans for new users.
  </a>
</div>

<header class="sticky top-0 z-40 w-full border-b border-border/40 bg-background/80 backdrop-blur-md">
  <div class="container flex h-[4.5rem] max-w-screen-2xl items-center justify-between mx-auto px-4 sm:px-8">
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center gap-2 group">
        <img src="/logo.png" alt="HostingSpell" class="h-8 object-contain dark:hidden" />
        <img src="/logo-light.png" alt="HostingSpell" class="h-8 object-contain hidden dark:block" />
      </a>
      
      <MegaMenu />
    </div>

    <div class="flex items-center gap-4">
      <div class="hidden lg:flex items-center gap-2 mr-4 text-sm font-semibold text-emerald-600 dark:text-emerald-500 hover:text-emerald-700 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <a href="tel:+919409594000">+91 94095 94000</a>
      </div>

      <div class="flex items-center gap-2 border-l border-border/40 pl-4">
        <div class="font-medium text-sm text-foreground/80 mr-2 border border-border rounded-md px-2 py-1 flex items-center gap-1 bg-muted/30">
          <span>₹</span> INR
        </div>
        
        <ThemeToggle client:load />

        <a href="https://manage.hostingspell.com/login">
          <Button variant="default" className="font-semibold px-6 shadow-md shadow-primary/20">
            LOGIN
          </Button>
        </a>
      </div>
    </div>
  </div>
</header>
