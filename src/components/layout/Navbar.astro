---
import { Button } from "@/components/ui/button";
import MegaMenu from "./MegaMenu.astro";
import { ThemeToggle } from "../ui/ThemeToggle";
import { MobileMenu } from "./MobileMenu";
import { PhoneCall, Sparkles, User, ArrowRight, Tag } from 'lucide-react';
---

{/* Single Unified Top Promo & Utility Bar */}
<div class="bg-gradient-to-r from-[#0073EC] via-blue-600 to-indigo-600 text-white text-xs py-2 px-4 flex items-center justify-between z-50 relative border-b border-blue-400/20 shadow-md">
  <div class="container mx-auto max-w-screen-2xl flex items-center justify-between gap-4">
    
    {/* Left Promo Offer */}
    <div class="flex items-center gap-2.5 min-w-0">
      <span class="inline-flex items-center gap-1 bg-white/20 text-white font-extrabold px-2.5 py-0.5 rounded-full text-[10px] uppercase tracking-wider shrink-0 backdrop-blur-sm shadow-sm">
        <Sparkles class="w-3 h-3 text-amber-300 animate-pulse" />
        <span>75% OFF + AI BUILDER</span>
      </span>
      
      <a href="/ai-website-builder" class="hover:underline flex items-center gap-2 min-w-0 font-semibold text-white/95 text-xs">
        <span class="truncate">Save 75% on Cloud NVMe Hosting + Free Domain • Try Remixer AI Website Builder</span>
        <span class="hidden sm:inline-flex items-center gap-1 bg-white text-[#0073EC] hover:bg-zinc-100 font-extrabold px-2.5 py-0.5 rounded-full text-[10px] uppercase tracking-wider shrink-0 transition-transform hover:scale-105 shadow-sm">
          <span>Try Free</span>
          <ArrowRight class="w-3 h-3" />
        </span>
      </a>
    </div>

    {/* Right Quick Utility Links */}
    <div class="hidden md:flex items-center gap-4 text-xs font-medium text-white/90 shrink-0">
      <a href="/knowledgebase" class="hover:text-white transition-colors">Knowledgebase</a>
      <span class="text-white/30">•</span>
      <a href="/blog" class="hover:text-white transition-colors">News</a>
      <span class="text-white/30">•</span>
      <a href="/contact" class="hover:text-white transition-colors">Support</a>
    </div>

  </div>
</div>

{/* DreamHost Black Header Navigation Bar */}
<header class="sticky top-0 z-50 w-full bg-black/95 text-white backdrop-blur-xl border-b border-zinc-800/80 transition-colors">
  <div class="container flex h-18 max-w-screen-2xl items-center justify-between mx-auto px-4 sm:px-8">
    
    {/* Left Logo & Brand */}
    <div class="flex items-center gap-4 lg:gap-8">
      <MobileMenu client:idle />
      <a href="/" class="flex items-center gap-2 group transition-transform hover:scale-105">
        <img src="/logo-light.png" alt="HostingSpell" class="h-5.5 sm:h-6 lg:h-6.5 object-contain transition-all" width="150" height="26" decoding="async" />
      </a>
      
      {/* Clean Mega Menu */}
      <MegaMenu />
    </div>

    {/* Right Action Bar & High-Converting CTAs */}
    <div class="flex items-center gap-3 sm:gap-4">
      {/* 24/7 WhatsApp & Phone Support */}
      <a 
        href="https://wa.me/919409594000" 
        target="_blank"
        rel="noopener noreferrer"
        class="hidden xl:flex items-center gap-1.5 text-xs font-bold text-emerald-400 hover:text-emerald-300 transition-colors px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 shadow-sm"
        title="24/7 WhatsApp Chat & Phone Call Support: +91 94095 94000"
      >
        <svg class="w-4 h-4 text-emerald-400 fill-emerald-400 shrink-0" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.99c-.002 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        <span>+91 94095 94000</span>
      </a>

      {/* Currency & Theme Toggle */}
      <div class="flex items-center gap-2">
        <div class="hidden md:flex font-extrabold text-xs text-zinc-300 border border-zinc-800 rounded-xl px-2.5 py-1.5 items-center gap-1 bg-zinc-900 shadow-inner">
          <span class="text-blue-400 font-black">₹</span> INR
        </div>
        
        <ThemeToggle client:idle />
      </div>

      {/* Client Portal Button (DreamHost Royal Blue) */}
      <a href="https://manage.hostingspell.com/login" target="_blank" rel="noopener noreferrer" class="hidden sm:block">
        <Button size="sm" className="bg-[#0073EC] hover:bg-[#005bb5] text-white font-extrabold text-xs px-4 py-2 rounded-xl shadow-lg shadow-blue-500/20 transition-all flex items-center gap-1.5">
          <User class="w-3.5 h-3.5" />
          <span>Client Portal</span>
        </Button>
      </a>
    </div>

  </div>
</header>
