---
import { Button } from "@/components/ui/button";
import MegaMenu from "./MegaMenu.astro";
import { ThemeToggle } from "../ui/ThemeToggle";
import { MobileMenu } from "./MobileMenu";
import { PhoneCall, Sparkles, User, ArrowRight, ShieldCheck, Headphones } from 'lucide-react';
import { CurrencySwitcher } from "../pricing/CurrencySwitcher";
---

{/* Sleek Top Promo & Utility Bar */}
<div class="bg-[#0073EC] text-white text-xs py-2 px-4 flex items-center justify-between z-50 relative border-b border-blue-400/20">
  <div class="container mx-auto max-w-screen-2xl flex items-center justify-between gap-4">
    
    {/* Left Promo Offer */}
    <div class="flex items-center gap-2.5 min-w-0">
      <span class="inline-flex items-center gap-1 bg-white/20 text-white font-extrabold px-2.5 py-0.5 rounded-full text-[10px] uppercase tracking-wider shrink-0 backdrop-blur-sm shadow-sm">
        <Sparkles class="w-3 h-3 text-amber-300 animate-pulse" />
        <span>75% OFF + FREE DOMAIN</span>
      </span>
      
      <a href="/cloud-hosting" class="hover:underline flex items-center gap-2 min-w-0 font-semibold text-white/95 text-xs">
        <span class="truncate">Save 75% on High-Speed NVMe Cloud Hosting + Free SSL & Daily Backups</span>
        <span class="hidden sm:inline-flex items-center gap-1 bg-white text-[#0073EC] hover:bg-white/90 font-extrabold px-2.5 py-0.5 rounded-full text-[10px] uppercase tracking-wider shrink-0 transition-transform hover:scale-105 shadow-sm">
          <span>Claim Offer</span>
          <ArrowRight class="w-3 h-3" />
        </span>
      </a>
    </div>

    {/* Right Quick Utility Links */}
    <div class="hidden md:flex items-center gap-4 text-xs font-medium text-white/90 shrink-0">
      <a href="/ai-website-builder" class="hover:text-white transition-colors flex items-center gap-1">
        <Sparkles class="w-3 h-3 text-amber-300" />
        <span>AI Builder</span>
      </a>
      <span class="text-white/30">•</span>
      <a href="/knowledgebase" class="hover:text-white transition-colors">Docs</a>
      <span class="text-white/30">•</span>
      <a href="/blog" class="hover:text-white transition-colors">Blog</a>
      <span class="text-white/30">•</span>
      <a href="/contact" class="hover:text-white transition-colors">Support</a>
    </div>

  </div>
</div>

{/* Persistent Adaptive Header Navigation Bar - Apple GlobalNav Specification */}
<header class="sticky top-0 z-50 w-full bg-white/80 dark:bg-[#161617]/80 text-zinc-900 dark:text-white backdrop-blur-[20px] backdrop-saturate-[180%] border-b border-black/[0.08] dark:border-white/[0.1] transform-gpu">
  <div class="container flex h-16 max-w-screen-2xl items-center justify-between mx-auto px-4 sm:px-8">
    
    {/* Left Logo & Brand Navigation */}
    <div class="flex items-center gap-4 lg:gap-8">
      <a href="/" class="flex items-center gap-2 group transition-transform hover:scale-[1.02]">
        <img src="/logo.png" alt="HostingSpell" class="h-6 sm:h-6.5 object-contain transition-all dark:hidden" width="150" height="26" decoding="async" />
        <img src="/logo-light.png" alt="HostingSpell" class="h-6 sm:h-6.5 object-contain transition-all hidden dark:block" width="150" height="26" decoding="async" />
      </a>
      
      {/* Clean Mega Menu */}
      <MegaMenu />
    </div>

    {/* Right Action Bar */}
    <div class="flex items-center gap-2 sm:gap-3">
      {/* 24/7 WhatsApp Support Badge */}
      <a 
        href="https://wa.me/919409594000" 
        target="_blank"
        rel="noopener noreferrer"
        class="hidden xl:flex items-center gap-1.5 text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:opacity-80 transition-opacity px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 shadow-sm"
        title="24/7 WhatsApp Support: +91 94095 94000"
      >
        <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.99c-.002 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        <span>+91 94095 94000</span>
      </a>

      {/* Currency & Theme Toggle */}
      <div class="flex items-center gap-1.5 sm:gap-2">
        <CurrencySwitcher client:load />
        
        <div class="hidden md:flex">
          <ThemeToggle client:idle />
        </div>
      </div>

      {/* Client Portal Button */}
      <a href="https://manage.hostingspell.com/login" target="_blank" rel="noopener noreferrer" class="hidden sm:block">
        <Button size="sm" className="bg-[#0073EC] hover:bg-[#005bb5] text-white font-extrabold text-xs px-4 py-2 rounded-xl shadow-md shadow-blue-500/20 transition-all flex items-center gap-1.5">
          <User class="w-3.5 h-3.5" />
          <span>Client Portal</span>
        </Button>
      </a>

      {/* DreamHost Style Mobile Navigation Menu Toggle */}
      <MobileMenu client:idle />
    </div>

  </div>
</header>

