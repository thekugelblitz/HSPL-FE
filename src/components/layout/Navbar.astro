---
import { Button } from "@/components/ui/button";
import MegaMenu from "./MegaMenu.astro";
import { ThemeToggle } from "../ui/ThemeToggle";
import { MobileMenu } from "./MobileMenu";
import { PhoneCall, Sparkles, User } from 'lucide-react';
---

<header class="sticky top-0 z-50 w-full bg-background/90 backdrop-blur-xl border-b border-transparent transition-colors">
  <div class="container flex h-18 max-w-screen-2xl items-center justify-between mx-auto px-4 sm:px-8">
    
    {/* Left Logo & Brand */}
    <div class="flex items-center gap-4 lg:gap-8">
      <MobileMenu client:load />
      <a href="/" class="flex items-center gap-2 group transition-transform hover:scale-105">
        <img src="/logo.png" alt="HostingSpell" class="h-8 object-contain dark:hidden" />
        <img src="/logo-light.png" alt="HostingSpell" class="h-8 object-contain hidden dark:block" />
      </a>
      
      {/* Clean Uncluttered Mega Menu */}
      <MegaMenu />
    </div>

    {/* Right Action Bar & High-Converting CTAs */}
    <div class="flex items-center gap-3 sm:gap-4">
      {/* Sleek Support Contact Trigger */}
      <a 
        href="tel:+919409594000" 
        class="hidden xl:flex items-center gap-2 text-xs font-bold text-emerald-500 hover:text-emerald-400 transition-colors px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 shadow-sm"
        title="24/7 Sales & Support Hotline"
      >
        <PhoneCall class="w-3.5 h-3.5 animate-pulse" />
        <span>+91 94095 94000</span>
      </a>

      {/* Currency & Theme */}
      <div class="flex items-center gap-2 pl-2">
        <div class="hidden md:flex font-extrabold text-xs text-foreground/80 border border-border/60 rounded-xl px-2.5 py-1.5 items-center gap-1 bg-muted/40 shadow-inner">
          <span class="text-primary font-black">₹</span> INR
        </div>
        
        <ThemeToggle client:load />
      </div>

      {/* Client Portal Button */}
      <a href="https://manage.hostingspell.com/login" target="_blank" rel="noopener noreferrer">
        <Button size="sm" className="bg-primary hover:opacity-90 text-primary-foreground font-extrabold text-xs px-4 py-2 rounded-xl shadow-lg shadow-primary/25 transition-all flex items-center gap-1.5">
          <User class="w-3.5 h-3.5" />
          <span>Client Portal</span>
        </Button>
      </a>
    </div>

  </div>
</header>
