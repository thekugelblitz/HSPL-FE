---
import { Button } from "@/components/ui/button";
import MegaMenu from "./MegaMenu.astro";
import { ThemeToggle } from "../ui/ThemeToggle";
import { MobileMenu } from "./MobileMenu";
import { User, ArrowRight, PhoneCall, Sparkles } from 'lucide-react';
import { RegionSelector } from "../i18n/RegionSelector";
---

{/* Top Utility Bar with Direct Phone / WhatsApp, Region Selector & Promo (Hosting.com Standard) */}
<div class="bg-zinc-950 dark:bg-zinc-950 text-zinc-300 text-xs py-1.5 px-4 z-50 relative border-b border-zinc-800">
  <div class="container mx-auto max-w-screen-2xl flex items-center justify-between gap-4">
    
    {/* Left Promo Offer */}
    <a href="/pricing" class="hover:text-white transition-colors flex items-center gap-2 min-w-0 font-medium">
      <span class="inline-flex items-center gap-1 bg-emerald-500/20 text-emerald-400 font-bold px-2 py-0.5 rounded text-[10px] uppercase tracking-wider shrink-0">
        75% OFF
      </span>
      <span class="truncate">NVMe Cloud & AI Hosting — Starting at $0.89/mo</span>
      <ArrowRight class="w-3 h-3 shrink-0 text-zinc-500 hidden sm:inline" />
    </a>

    {/* Right Country/Region Selector, Support & Direct Phone Info */}
    <div class="flex items-center gap-2.5 sm:gap-3.5 text-xs font-medium text-zinc-400 shrink-0">
      
      {/* Top Utility Bar Region Selector */}
      <div class="hidden sm:block">
        <RegionSelector client:load variant="utility" />
      </div>

      <span class="text-zinc-700 hidden sm:inline">·</span>

      <a 
        href="tel:+919409594000" 
        class="text-zinc-300 hover:text-white flex items-center gap-1.5 transition-colors font-semibold"
        title="24/7 Phone Support: +91 94095 94000"
      >
        <PhoneCall class="w-3 h-3 text-emerald-400" />
        <span class="hidden md:inline">24/7 Sales:</span>
        <span class="text-white font-mono font-bold">+91 94095 94000</span>
      </a>

      <span class="text-zinc-700 hidden lg:inline">·</span>
      <a href="/ai-website-builder" class="hover:text-white transition-colors hidden lg:flex items-center gap-1">
        <Sparkles class="w-3 h-3 text-amber-300" />
        <span>AI Builder</span>
      </a>

      <span class="text-zinc-700 hidden md:inline">·</span>
      <a href="/knowledgebase" class="hover:text-white transition-colors hidden md:inline">Docs</a>

      <span class="text-zinc-700 hidden md:inline">·</span>
      <a href="/contact" class="hover:text-white transition-colors hidden md:inline">Contact</a>
    </div>

  </div>
</div>

{/* Clean Header Navigation */}
<header class="sticky top-0 z-50 w-full bg-white/85 dark:bg-[#0A0A0A]/85 text-zinc-900 dark:text-white backdrop-blur-xl backdrop-saturate-[180%] border-b border-black/[0.06] dark:border-white/[0.08] transform-gpu">
  <div class="container flex h-14 max-w-screen-2xl items-center justify-between mx-auto px-4 sm:px-8">
    
    {/* Logo + MegaMenu */}
    <div class="flex items-center gap-6 lg:gap-8">
      <a href="/" class="flex items-center gap-2 group transition-transform hover:scale-[1.02]">
        <img src="/logo.png" alt="HostingSpell" class="h-5 sm:h-6 object-contain transition-all dark:hidden" width="150" height="26" loading="eager" fetchpriority="high" decoding="async" />
        <img src="/logo-light.png" alt="HostingSpell" class="h-5 sm:h-6 object-contain transition-all hidden dark:block" width="150" height="26" loading="eager" fetchpriority="high" decoding="async" />
      </a>
      
      <MegaMenu />
    </div>

    {/* Right Action Bar */}
    <div class="flex items-center gap-2 sm:gap-3">
      
      <div class="hidden sm:flex">
        <ThemeToggle client:idle />
      </div>

      <a href="https://manage.hostingspell.com/login" target="_blank" rel="noopener noreferrer" class="hidden sm:block">
        <Button size="sm" className="bg-primary hover:bg-primary/90 text-white font-bold text-xs px-4 h-8 rounded-lg shadow-sm transition-all flex items-center gap-1.5 cursor-pointer">
          <User class="w-3.5 h-3.5" />
          <span>Log In</span>
        </Button>
      </a>

      <MobileMenu client:idle />
    </div>

  </div>
</header>
