---
// src/components/blocks/FinalCta.astro
// High-Converting Final Conversion / Bottom Closer CTA Section
import { ArrowRight, ShieldCheck, Zap, RefreshCw, Lock, Sparkles, CheckCircle2 } from 'lucide-react';
---

<section class="py-20 md:py-28 bg-[#0073EC] text-white relative overflow-hidden">
  {/* Ambient Visual Background Effects */}
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(255,255,255,0.15),transparent_60%)] pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-blue-900/40 rounded-full blur-3xl pointer-events-none"></div>
  
  <div class="container mx-auto px-4 max-w-screen-xl relative z-10 text-center">
    
    {/* Live Status Indicator */}
    <div class="inline-flex items-center gap-2 mb-6 bg-white/10 backdrop-blur-md px-4 py-2 rounded-full border border-white/20 text-xs sm:text-sm font-bold uppercase tracking-wider">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-400"></span>
      </span>
      <span>24/7 Migration Specialists & Systems Online</span>
    </div>

    {/* Big Converting Headline */}
    <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black mb-6 tracking-tight max-w-4xl mx-auto leading-[1.15]">
      Ready to Experience True High-Speed Cloud Hosting?
    </h2>

    <p class="text-blue-100 text-base sm:text-xl max-w-2xl mx-auto mb-10 leading-relaxed font-medium">
      Join 135,000+ businesses and creators who trust HostingSpell. Launch your website in 60 seconds with pure NVMe performance and zero risk.
    </p>

    {/* Primary & Secondary Action CTAs */}
    <div class="flex flex-col sm:flex-row justify-center items-center gap-4 mb-12">
      <a href="#pricing" class="w-full sm:w-auto">
        <button class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-white text-[#0073EC] font-extrabold text-base shadow-2xl hover:bg-blue-50 transition-all duration-200 hover:scale-[1.02] active:scale-100 flex items-center justify-center gap-2 cursor-pointer">
          <span>Choose Your Plan (Save up to 75%)</span>
          <ArrowRight class="w-5 h-5" />
        </button>
      </a>

      <a href="https://manage.hostingspell.com/submitticket.php?step=2&deptid=1" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto">
        <button class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-blue-700/60 hover:bg-blue-700/80 text-white font-extrabold text-base border border-white/20 backdrop-blur-md transition-all duration-200 hover:scale-[1.02] active:scale-100 flex items-center justify-center gap-2 cursor-pointer">
          <span>Request Free Migration &rarr;</span>
        </button>
      </a>
    </div>

    {/* Reassurance Value Badges */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto pt-8 border-t border-white/15 text-left sm:text-center text-xs sm:text-sm font-semibold text-blue-100">
      <div class="flex items-center justify-center gap-2 bg-white/5 p-3 rounded-xl border border-white/10 backdrop-blur-xs">
        <ShieldCheck class="w-4 h-4 text-emerald-300 shrink-0" />
        <span>30-Day Money-Back</span>
      </div>
      <div class="flex items-center justify-center gap-2 bg-white/5 p-3 rounded-xl border border-white/10 backdrop-blur-xs">
        <Zap class="w-4 h-4 text-amber-300 shrink-0" />
        <span>Instant 60s Setup</span>
      </div>
      <div class="flex items-center justify-center gap-2 bg-white/5 p-3 rounded-xl border border-white/10 backdrop-blur-xs">
        <RefreshCw class="w-4 h-4 text-emerald-300 shrink-0" />
        <span>100% Free Migration</span>
      </div>
      <div class="flex items-center justify-center gap-2 bg-white/5 p-3 rounded-xl border border-white/10 backdrop-blur-xs">
        <Lock class="w-4 h-4 text-blue-200 shrink-0" />
        <span>Free SSL & DDoS Shield</span>
      </div>
    </div>

  </div>
</section>
