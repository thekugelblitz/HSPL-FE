---
import { Check } from 'lucide-react';
---

<section class="py-24 bg-muted/20 relative overflow-hidden">
  <div class="container mx-auto px-4 max-w-screen-xl">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-bold mb-4">Why Pay More for Less?</h2>
      <p class="text-muted-foreground max-w-2xl mx-auto">Compare the actual cost of putting together a premium hosting stack yourself vs getting everything pre-configured with HostingSpell.</p>
    </div>

    <div class="max-w-5xl mx-auto flex flex-col lg:flex-row items-center gap-8 lg:gap-0 relative">
      
      {/* Left Column: Industry Standard */}
      <div class="w-full lg:w-1/2 bg-card border border-border rounded-2xl p-8 shadow-sm">
        <h3 class="font-bold text-xl mb-6 text-center text-foreground/80">Other Providers (Hidden Costs)</h3>
        
        <div class="space-y-4">
          <div class="flex justify-between items-center py-2 border-b border-border/50">
            <span class="text-muted-foreground">Base Hosting</span>
            <span class="font-medium text-foreground">₹425 / Mo</span>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-border/50">
            <span class="text-muted-foreground">cPanel License</span>
            <span class="font-medium text-foreground">₹2,200 / Mo</span>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-border/50">
            <span class="text-muted-foreground">Linode Object Storage</span>
            <span class="font-medium text-foreground">₹1,700 / Mo</span>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-border/50">
            <span class="text-muted-foreground">CloudLinux OS & Imunify360</span>
            <span class="font-medium text-foreground">₹2,550 / Mo</span>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-border/50">
            <span class="text-muted-foreground">LiteSpeed Enterprise</span>
            <span class="font-medium text-foreground">₹3,825 / Mo</span>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-border/50">
            <span class="text-muted-foreground">JetBackup & Softaculous</span>
            <span class="font-medium text-foreground">₹930 / Mo</span>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-border/50">
            <span class="text-muted-foreground">Sysadmin Support (24/7)</span>
            <span class="font-medium text-foreground">₹3,400 / Mo</span>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-border/50">
            <span class="text-muted-foreground">Your Time & Sanity</span>
            <span class="font-medium text-primary italic">Priceless</span>
          </div>
        </div>

        <div class="mt-6 text-right">
          <div class="text-sm text-muted-foreground">Total Estimated Cost</div>
          <div class="text-3xl font-bold text-destructive">₹16,305 <span class="text-lg text-muted-foreground font-normal">/ Month</span></div>
        </div>
      </div>

      {/* VS Badge */}
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 hidden lg:flex items-center justify-center w-16 h-16 rounded-full bg-destructive text-white font-black text-xl border-4 border-background z-10 shadow-xl shadow-destructive/20">
        VS
      </div>

      {/* Right Column: HostingSpell */}
      <div class="w-full lg:w-1/2 bg-gradient-to-br from-primary to-blue-600 text-white rounded-2xl p-8 shadow-xl relative lg:-ml-4 z-0">
        <div class="mb-6 flex items-center justify-center">
          <img 
            src="/logo-light.png" 
            alt="HostingSpell" 
            class="h-7 sm:h-8 object-contain drop-shadow-md" 
            width="170" 
            height="30" 
            decoding="async" 
          />
        </div>
        
        <ul class="space-y-4 mb-8">
          {[
            "24/7 Support team",
            "Free SSL certificate",
            "cPanel Control panel",
            "CloudLinux + Imunify360 Security",
            "One-Click application installer",
            "Drag&Drop SiteBuilder",
            "100% Uptime mark",
            "30-day money-back guarantee",
            "Free website migration",
            "Daily backup system",
            "Latest PHP versions",
            "Unlimited bandwidth & emails"
          ].map((feature) => (
            <li class="flex items-center gap-3">
              <div class="bg-white/20 rounded-full p-0.5 shrink-0">
                <Check className="w-4 h-4 text-white" />
              </div>
              <span class="text-primary-foreground text-sm font-medium">{feature}</span>
            </li>
          ))}
        </ul>

        <div class="mt-auto border-t border-white/20 pt-6">
          <div class="flex justify-between items-end mb-4">
            <div>
              <div class="text-sm text-primary-foreground/80">Total Cost</div>
              <div class="text-xs font-semibold bg-white/20 px-2 py-1 rounded text-white mt-1 inline-block">Zero Hidden Fees</div>
            </div>
            <div class="text-right">
              <div class="text-4xl font-extrabold text-white">₹85 <span class="text-lg font-medium text-primary-foreground/80">/ Mo</span></div>
            </div>
          </div>
          
          <div class="text-center font-bold text-yellow-300 text-sm tracking-wide mb-6">
            + Up to 80% SAVINGS vs. the Industry
          </div>

          <a href="/pricing" class="block w-full bg-white text-primary text-center font-bold py-3 rounded-lg hover:bg-white/90 transition-colors shadow-lg">
            View Plans
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
