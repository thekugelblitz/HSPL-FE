---
// src/components/blocks/ProblemSolutionGrid.astro
// 3-column problem → outcome grid
// Psychology rules: #4 (solve pain), #9 (results), #2 (transformation), #18 (customer as hero)
import { Zap, Shield, Headphones } from 'lucide-react';
---

<section class="py-20 border-b border-border/40">
  <div class="container mx-auto px-4 max-w-screen-xl">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">Stop Worrying About Your Hosting</h2>
      <p class="text-muted-foreground text-base font-medium">Three problems every website owner faces — and how we solve each one.</p>
    </div>

    <div class="grid sm:grid-cols-3 gap-6 max-w-5xl mx-auto">
      
      {/* Problem 1: Speed */}
      <div class="rounded-2xl border border-border/60 bg-card/60 p-7 space-y-5 hover:border-primary/40 transition-colors group">
        <div class="p-3 bg-primary/10 text-primary rounded-xl w-fit group-hover:bg-primary group-hover:text-white transition-colors">
          <Zap className="w-5 h-5" />
        </div>
        
        <div>
          <p class="text-xs font-bold text-destructive/80 uppercase tracking-wider mb-2">The Problem</p>
          <p class="text-sm text-muted-foreground leading-relaxed">Slow hosting kills your Google rankings and drives visitors away before they convert.</p>
        </div>

        <div class="border-t border-border/40 pt-4">
          <p class="text-xs font-bold text-emerald-500 uppercase tracking-wider mb-2">Your Outcome</p>
          <p class="text-base font-bold text-foreground">Your pages load in under 1 second</p>
          <p class="text-xs text-muted-foreground mt-1">LiteSpeed Enterprise + NVMe SSDs deliver 10× faster response times than traditional hosts.</p>
        </div>
      </div>

      {/* Problem 2: Security & Reliability */}
      <div class="rounded-2xl border border-border/60 bg-card/60 p-7 space-y-5 hover:border-primary/40 transition-colors group">
        <div class="p-3 bg-primary/10 text-primary rounded-xl w-fit group-hover:bg-primary group-hover:text-white transition-colors">
          <Shield className="w-5 h-5" />
        </div>
        
        <div>
          <p class="text-xs font-bold text-destructive/80 uppercase tracking-wider mb-2">The Problem</p>
          <p class="text-sm text-muted-foreground leading-relaxed">Malware, downtime, and data loss can destroy months of work overnight.</p>
        </div>

        <div class="border-t border-border/40 pt-4">
          <p class="text-xs font-bold text-emerald-500 uppercase tracking-wider mb-2">Your Outcome</p>
          <p class="text-base font-bold text-foreground">Your site is protected 24/7 on autopilot</p>
          <p class="text-xs text-muted-foreground mt-1">Imunify360 AI blocks threats, daily backups via JetBackup, and free SSL certificates — all included.</p>
        </div>
      </div>

      {/* Problem 3: Support */}
      <div class="rounded-2xl border border-border/60 bg-card/60 p-7 space-y-5 hover:border-primary/40 transition-colors group">
        <div class="p-3 bg-primary/10 text-primary rounded-xl w-fit group-hover:bg-primary group-hover:text-white transition-colors">
          <Headphones className="w-5 h-5" />
        </div>
        
        <div>
          <p class="text-xs font-bold text-destructive/80 uppercase tracking-wider mb-2">The Problem</p>
          <p class="text-sm text-muted-foreground leading-relaxed">When something breaks at 2 AM, chatbots and ticket queues won't fix your revenue-losing downtime.</p>
        </div>

        <div class="border-t border-border/40 pt-4">
          <p class="text-xs font-bold text-emerald-500 uppercase tracking-wider mb-2">Your Outcome</p>
          <p class="text-base font-bold text-foreground">A real engineer responds in under 5 minutes</p>
          <p class="text-xs text-muted-foreground mt-1">24/7 human SLA support via live chat, ticket, and WhatsApp — no bots, no waiting.</p>
        </div>
      </div>

    </div>
  </div>
</section>
