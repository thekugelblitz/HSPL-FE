---
import { datacenters } from '../../lib/data';
import { Server, Globe, Shield, Activity } from 'lucide-react';
---

<section class="py-20 bg-background relative overflow-hidden border-t border-border/40">
  <div class="absolute inset-0 bg-grid-pattern opacity-10 pointer-events-none"></div>
  <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-semibold uppercase tracking-wider mb-4">
        <Globe class="w-3.5 h-3.5" />
        Global Infrastructure
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
        Powered by Enterprise Tier-4 Datacenters
      </h2>
      <p class="text-muted-foreground text-lg">
        Deploy your applications in strategic locations worldwide for sub-20ms ultra-low latency and 99.99% high availability.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {datacenters.map((dc) => (
        <div class="glass-card rounded-2xl p-6 glow-card transition-all duration-300 hover:-translate-y-1">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <span class="text-2xl">{dc.flag}</span>
              <div>
                <h3 class="font-bold text-base leading-tight">{dc.city}</h3>
                <p class="text-xs text-muted-foreground">{dc.country}</p>
              </div>
            </div>
            <span class="inline-flex items-center gap-1 text-[11px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
              <Activity class="w-3 h-3" />
              {dc.status}
            </span>
          </div>

          <div class="space-y-3 pt-2 border-t border-border/40 text-xs">
            <div class="flex items-center justify-between text-muted-foreground">
              <span>Region Code</span>
              <span class="font-mono font-semibold text-foreground">{dc.code}</span>
            </div>
            <div class="flex items-center justify-between text-muted-foreground">
              <span>Avg Latency</span>
              <span class="font-mono font-semibold text-emerald-400">{dc.latency}</span>
            </div>
            <div class="pt-2 text-muted-foreground border-t border-border/30">
              <span class="block text-[10px] uppercase font-bold text-muted-foreground/80 mb-1">Hardware Cluster</span>
              <p class="text-foreground/90 font-medium leading-relaxed">{dc.specs}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
