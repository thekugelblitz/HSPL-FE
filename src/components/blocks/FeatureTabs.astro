---
// src/components/blocks/FeatureTabs.astro
// Zero-JS Native Tab Switcher for Instant Load
import { Server, Globe, Cpu, Check, ArrowRight } from "lucide-react";

const tabsData = [
  {
    id: "hosting",
    label: "Hosting",
    icon: Server,
    title: "Optimized Cloud Hosting for Every Need",
    description: "Launch your website in minutes with our high-performance cloud infrastructure. Pre-configured for speed and security.",
    image: "https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&q=80&w=1200",
    features: [
      "NVMe SSD Storage",
      "Free SSL Certificates",
      "LiteSpeed Web Server",
      "Daily Automated Backups"
    ],
    cta: "View Hosting Plans",
    href: "/cloud-hosting"
  },
  {
    id: "domains",
    label: "Domains",
    icon: Globe,
    title: "Secure Your Perfect Domain Name",
    description: "Your digital identity starts here. Register, transfer, or manage your domains with our easy-to-use control panel.",
    image: "https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&q=80&w=1200",
    features: [
      "Free WHOIS Privacy",
      "Instant Activation",
      "DNS Management",
      "Domain Forwarding"
    ],
    cta: "Search Domains",
    href: "/domain"
  },
  {
    id: "vps",
    label: "VPS",
    icon: Cpu,
    title: "Dedicated Power & Complete Control",
    description: "Scale your applications with dedicated resources. Root access and custom server configurations available.",
    image: "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&q=80&w=1200",
    features: [
      "Full Root Access",
      "Dedicated IP Address",
      "KVM Virtualization",
      "Custom OS Installation"
    ],
    cta: "Deploy a Server",
    href: "/vps"
  }
];
---

<section class="py-24 bg-background" id="feature-tabs-section">
  <div class="container mx-auto px-4 max-w-screen-xl">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 tracking-tight">Hosting That Grows With You</h2>
      <p class="text-muted-foreground max-w-2xl mx-auto">Everything you need to build, scale, and manage your online presence in one place.</p>
    </div>

    {/* Tab Navigation Buttons */}
    <div class="flex justify-center mb-12">
      <div class="inline-flex bg-muted/50 p-1.5 rounded-xl border border-border/50" role="tablist">
        {tabsData.map((tab, idx) => {
          const TabIcon = tab.icon;
          return (
            <button
              type="button"
              role="tab"
              data-tab-target={tab.id}
              aria-selected={idx === 0 ? "true" : "false"}
              class={`hs-tab-btn flex items-center gap-2 px-6 py-3 rounded-lg text-sm font-semibold transition-all duration-200 cursor-pointer ${
                idx === 0
                  ? "bg-background text-foreground shadow-sm ring-1 ring-border"
                  : "text-muted-foreground hover:text-foreground hover:bg-muted"
              }`}
            >
              <TabIcon class={`w-4 h-4 ${idx === 0 ? "text-primary" : ""}`} />
              <span>{tab.label}</span>
            </button>
          );
        })}
      </div>
    </div>

    {/* Tab Panels */}
    <div class="bg-card border border-border rounded-2xl p-8 md:p-12 shadow-sm relative overflow-hidden">
      {tabsData.map((tab, idx) => {
        const IconComponent = tab.icon;
        return (
          <div
            id={`tab-panel-${tab.id}`}
            role="tabpanel"
            class={`hs-tab-panel grid md:grid-cols-2 gap-12 items-center ${idx === 0 ? "block" : "hidden"}`}
          >
            {/* Left Content */}
            <div class="space-y-8 z-10 relative text-left">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold">
                <IconComponent class="w-4 h-4" />
                <span>{tab.label} Services</span>
              </div>
              
              <div>
                <h3 class="text-3xl font-bold mb-4">{tab.title}</h3>
                <p class="text-muted-foreground text-lg leading-relaxed">
                  {tab.description}
                </p>
              </div>

              <div class="grid sm:grid-cols-2 gap-4">
                {tab.features.map((feature) => (
                  <div class="flex items-center gap-3">
                    <div class="bg-primary/10 p-1 rounded-full shrink-0">
                      <Check class="w-4 h-4 text-primary" />
                    </div>
                    <span class="font-medium text-sm text-foreground/80">{feature}</span>
                  </div>
                ))}
              </div>

              <div class="pt-4">
                <a 
                  href={tab.href}
                  class="inline-flex items-center gap-2 px-8 h-12 rounded-xl bg-primary text-primary-foreground font-bold text-base hover:opacity-90 transition-opacity shadow-md shadow-primary/20"
                >
                  <span>{tab.cta}</span>
                  <ArrowRight class="w-4 h-4" />
                </a>
              </div>
            </div>

            {/* Right Content - Visual */}
            <div class="relative h-[400px] rounded-xl overflow-hidden shadow-2xl z-10 border border-border/50">
              <img 
                src={tab.image} 
                alt={tab.title}
                width="600"
                height="400"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-background/80 to-transparent"></div>
            </div>
          </div>
        );
      })}
      
      {/* Decorative background element */}
      <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-primary/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3 pointer-events-none"></div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('feature-tabs-section');
    if (!section) return;

    const buttons = section.querySelectorAll('.hs-tab-btn');
    const panels = section.querySelectorAll('.hs-tab-panel');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-tab-target');

        buttons.forEach((b) => {
          b.setAttribute('aria-selected', 'false');
          b.className = 'hs-tab-btn flex items-center gap-2 px-6 py-3 rounded-lg text-sm font-semibold transition-all duration-200 cursor-pointer text-muted-foreground hover:text-foreground hover:bg-muted';
          const icon = b.querySelector('svg');
          if (icon) icon.classList.remove('text-primary');
        });

        panels.forEach((p) => p.classList.add('hidden'));

        btn.setAttribute('aria-selected', 'true');
        btn.className = 'hs-tab-btn flex items-center gap-2 px-6 py-3 rounded-lg text-sm font-semibold transition-all duration-200 cursor-pointer bg-background text-foreground shadow-sm ring-1 ring-border';
        const activeIcon = btn.querySelector('svg');
        if (activeIcon) activeIcon.classList.add('text-primary');

        const activePanel = document.getElementById(`tab-panel-${targetId}`);
        if (activePanel) activePanel.classList.remove('hidden');
      });
    });
  });
</script>
