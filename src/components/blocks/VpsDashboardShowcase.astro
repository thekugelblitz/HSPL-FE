---
import { Terminal, Cpu, Zap, Shield, RefreshCw, Activity, ArrowRight, ExternalLink } from 'lucide-react';
---

<section class="py-20 bg-background relative overflow-hidden border-t border-border/40">
  {/* Ambient Background Blur Elements */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-purple-600/10 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute top-0 right-0 w-96 h-96 bg-indigo-500/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
    
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-purple-500/30 bg-purple-500/10 text-xs font-bold text-purple-400 backdrop-blur-sm">
        <Terminal class="w-3.5 h-3.5 text-purple-400" />
        <span>Virtualizor End-User Control Panel</span>
      </div>
      
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-foreground">
        Complete Server Control with <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-indigo-400 to-emerald-400">
          Virtualizor VPS Dashboard
        </span>
      </h2>
      
      <p class="text-base sm:text-lg text-muted-foreground font-medium">
        Take total control of your KVM virtual private server with 1-click power actions, out-of-band HTML5 VNC console, live resource analytics, and instant OS reinstalls.
      </p>
    </div>

    {/* 2-Column Split: Feature Grid Left & Dashboard Screenshot Right */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      {/* Left Feature Column (5 cols) */}
      <div class="lg:col-span-5 space-y-6">
        <div class="p-5 rounded-2xl bg-card border border-border/80 hover:border-purple-500/40 transition-all shadow-md group">
          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-purple-500/10 text-purple-500 dark:text-purple-400 border border-purple-500/20 group-hover:scale-105 transition-transform shrink-0">
              <Terminal class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-base font-extrabold text-foreground group-hover:text-purple-500 transition-colors">HTML5 VNC & SSH Access</h3>
              <p class="text-xs text-muted-foreground mt-1 leading-relaxed">Access your server out-of-band directly from your web browser anytime, even if network configs change.</p>
            </div>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-card border border-border/80 hover:border-purple-500/40 transition-all shadow-md group">
          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-indigo-500/10 text-indigo-500 dark:text-indigo-400 border border-indigo-500/20 group-hover:scale-105 transition-transform shrink-0">
              <Zap class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-base font-extrabold text-foreground group-hover:text-purple-500 transition-colors">Instant 1-Click Power Actions</h3>
              <p class="text-xs text-muted-foreground mt-1 leading-relaxed">Boot, reboot, shutdown, or hard reset your VPS node in seconds with zero latency.</p>
            </div>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-card border border-border/80 hover:border-purple-500/40 transition-all shadow-md group">
          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-emerald-500/10 text-emerald-500 dark:text-emerald-400 border border-emerald-500/20 group-hover:scale-105 transition-transform shrink-0">
              <Activity class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-base font-extrabold text-foreground group-hover:text-purple-500 transition-colors">Real-Time Resource Analytics</h3>
              <p class="text-xs text-muted-foreground mt-1 leading-relaxed">Monitor CPU usage, RAM allocation, NVMe disk I/O, and bandwidth consumption live with historical graphs.</p>
            </div>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-card border border-border/80 hover:border-purple-500/40 transition-all shadow-md group">
          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-cyan-500/10 text-cyan-500 dark:text-cyan-400 border border-cyan-500/20 group-hover:scale-105 transition-transform shrink-0">
              <RefreshCw class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-base font-extrabold text-foreground group-hover:text-purple-500 transition-colors">1-Click OS & ISO Reinstall</h3>
              <p class="text-xs text-muted-foreground mt-1 leading-relaxed">Switch between AlmaLinux, Ubuntu, Debian, Rocky Linux, or custom ISO images in under 60 seconds.</p>
            </div>
          </div>
        </div>
      </div>

      {/* Right Screenshot Showcase Column (7 cols) */}
      <div class="lg:col-span-7 relative">
        {/* Glow backdrop behind frame */}
        <div class="absolute -inset-1 bg-gradient-to-r from-purple-600 via-indigo-600 to-emerald-500 rounded-3xl opacity-30 blur-xl"></div>
        
        {/* Browser Window Container */}
        <div class="relative rounded-2xl bg-zinc-950 border border-zinc-800 shadow-2xl overflow-hidden">
          
          {/* Top Browser Bar */}
          <div class="px-4 py-3 bg-zinc-900/90 border-b border-zinc-800 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
            </div>
            
            {/* Address Bar */}
            <div class="flex items-center gap-2 px-3 py-1 rounded-lg bg-zinc-950/80 border border-zinc-800 text-[11px] font-mono text-zinc-400 max-w-sm w-full truncate">
              <span class="text-emerald-400">https://</span>
              <span class="text-zinc-200 truncate">vps-panel.hostingspell.com:4083</span>
            </div>

            <div class="text-[10px] font-extrabold text-purple-400 bg-purple-500/10 px-2 py-0.5 rounded border border-purple-500/20 shrink-0">
              VIRTUALIZOR KVM
            </div>
          </div>

          {/* Screenshot Container */}
          <div class="relative bg-zinc-950 p-2 sm:p-3 overflow-hidden group">
            <img 
              src="/dashboards/virtualizor-vps-dashboard.png" 
              alt="Virtualizor VPS End-User Control Panel Dashboard"
              class="w-full h-auto rounded-xl object-cover shadow-lg border border-zinc-800/80 group-hover:scale-[1.01] transition-transform duration-300"
              width="1200"
              height="675"
              loading="lazy"
              decoding="async"
            />

            {/* Floating Live Callout Badges */}
            <div class="absolute top-6 left-6 hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900/90 border border-emerald-500/30 text-xs font-bold text-emerald-400 shadow-xl backdrop-blur-md">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>KVM Hypervisor Operational</span>
            </div>

            <div class="absolute bottom-6 right-6 hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900/90 border border-purple-500/30 text-xs font-bold text-purple-300 shadow-xl backdrop-blur-md">
              <Zap class="w-3.5 h-3.5 text-purple-400" />
              <span>Full Root & VNC Access</span>
            </div>
          </div>

          {/* Bottom Info Bar */}
          <div class="px-5 py-3 bg-zinc-900/90 border-t border-zinc-800 flex items-center justify-between text-xs text-zinc-400 font-medium">
            <span>Enterprise KVM Virtualization</span>
            <span class="text-emerald-400 font-extrabold flex items-center gap-1">
              <span>100% Uptime Mark</span>
            </span>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>
