---
// src/components/blocks/FeatureCard.astro
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card";
import { 
  Server, Shield, Zap, RefreshCw, Rocket, Database, Layout, ShoppingCart, 
  Layers, TrendingUp, Package, Sliders, Globe, Cpu, HardDrive, Check, Lock, 
  Activity, TrendingDown, ShieldCheck, Users, Mail, Headphones, MessageSquare, 
  Phone, CreditCard, ShieldAlert, Sparkles, Code, MonitorSmartphone, Terminal, 
  BookOpen, HelpCircle 
} from "lucide-react";

interface Props {
  title: string;
  description: string;
  iconName?: string;
  icon?: string;
}

const { title, description, iconName, icon } = Astro.props;

const rawKey = (iconName || icon || 'Server').trim();

const iconMap: Record<string, any> = {
  Server, Shield, Zap, RefreshCw, Rocket, Database, Layout, ShoppingCart,
  Layers, TrendingUp, Package, Sliders, Globe, Cpu, HardDrive, Check, Lock,
  Activity, TrendingDown, ShieldCheck, Users, Mail, Headphones, MessageSquare,
  Phone, CreditCard, ShieldAlert, Sparkles, Code, MonitorSmartphone, Terminal,
  BookOpen, HelpCircle,
  'server': Server,
  'shield': Shield,
  'zap': Zap,
  'refresh-cw': RefreshCw,
  'rocket': Rocket,
  'database': Database,
  'layout': Layout,
  'shopping-cart': ShoppingCart,
  'layers': Layers,
  'trending-up': TrendingUp,
  'package': Package,
  'sliders': Sliders,
  'globe': Globe,
  'cpu': Cpu,
  'hard-drive': HardDrive,
  'check': Check,
  'lock': Lock,
  'activity': Activity,
  'trending-down': TrendingDown,
  'shield-check': ShieldCheck,
  'users': Users,
  'mail': Mail,
  'headphones': Headphones,
  'message-square': MessageSquare,
  'phone': Phone,
  'credit-card': CreditCard,
  'shield-alert': ShieldAlert,
  'sparkles': Sparkles,
  'code': Code,
  'monitor-smartphone': MonitorSmartphone,
  'terminal': Terminal,
  'book-open': BookOpen,
  'help-circle': HelpCircle
};

const Icon = iconMap[rawKey] || Server;
---

<Card className="border-zinc-800 bg-[#141518] hover:border-blue-500/50 shadow-md hover:shadow-xl transition-all duration-300 text-white">
  <CardHeader className="p-6">
    <div class="h-10 w-10 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center mb-4">
      <Icon class="h-5 w-5 text-blue-400" />
    </div>
    <CardTitle className="text-lg font-extrabold text-white">{title}</CardTitle>
  </CardHeader>
  <CardContent className="px-6 pb-6 pt-0">
    <CardDescription className="text-sm text-zinc-300 leading-relaxed">{description}</CardDescription>
  </CardContent>
</Card>
