---
import { LayoutGrid, Zap, Shield, Globe, HardDrive, Cpu, CheckCircle2, Lock } from 'lucide-react';
---

<section class="py-20 bg-background relative overflow-hidden border-t border-border/40">
  {/* Ambient Background Blur Elements */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-blue-600/10 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute top-0 right-0 w-96 h-96 bg-cyan-500/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
    
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-blue-500/30 bg-blue-500/10 text-xs font-bold text-blue-400 backdrop-blur-sm">
        <LayoutGrid class="w-3.5 h-3.5 text-blue-400" />
        <span>Industry-Standard Control Panel</span>
      </div>
      
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-foreground">
        Manage Your Website Effortlessly with <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-400 to-cyan-400">
          cPanel Control Panel
        </span>
      </h2>
      
      <p class="text-base sm:text-lg text-muted-foreground font-medium">
        Experience the gold standard in web hosting control panels. Manage email accounts, MySQL databases, domain DNS records, SSL certificates, and 1-click app installations seamlessly.
      </p>
    </div>

    {/* 2-Column Split: Feature Grid Left & Dashboard Screenshot Right */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      {/* Left Feature Column (5 cols) */}
      <div class="lg:col-span-5 space-y-6">
        <div class="p-5 rounded-2xl bg-card border border-border/80 hover:border-blue-500/40 transition-all shadow-md group">
          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-blue-500/10 text-blue-500 dark:text-blue-400 border border-blue-500/20 group-hover:scale-105 transition-transform shrink-0">
              <Zap class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-base font-extrabold text-foreground group-hover:text-blue-500 transition-colors">LiteSpeed LSCache Control</h3>
              <p class="text-xs text-muted-foreground mt-1 leading-relaxed">Built-in LSCache manager directly in cPanel for 10x faster WordPress & e-commerce load speeds.</p>
            </div>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-card border border-border/80 hover:border-blue-500/40 transition-all shadow-md group">
          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-cyan-500/10 text-cyan-500 dark:text-cyan-400 border border-cyan-500/20 group-hover:scale-105 transition-transform shrink-0">
              <LayoutGrid class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-base font-extrabold text-foreground group-hover:text-blue-500 transition-colors">Softaculous 1-Click Installer</h3>
              <p class="text-xs text-muted-foreground mt-1 leading-relaxed">Deploy WordPress, WooCommerce, Laravel, Joomla, and 400+ web applications in under 30 seconds.</p>
            </div>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-card border border-border/80 hover:border-blue-500/40 transition-all shadow-md group">
          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-emerald-500/10 text-emerald-500 dark:text-emerald-400 border border-emerald-500/20 group-hover:scale-105 transition-transform shrink-0">
              <Shield class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-base font-extrabold text-foreground group-hover:text-blue-500 transition-colors">Imunify360 AI Firewall</h3>
              <p class="text-xs text-muted-foreground mt-1 leading-relaxed">Automated malware scanning, web application firewall (WAF), and proactive brute-force protection.</p>
            </div>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-card border border-border/80 hover:border-blue-500/40 transition-all shadow-md group">
          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-indigo-500/10 text-indigo-500 dark:text-indigo-400 border border-indigo-500/20 group-hover:scale-105 transition-transform shrink-0">
              <Lock class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-base font-extrabold text-foreground group-hover:text-blue-500 transition-colors">AutoSSL & File Manager</h3>
              <p class="text-xs text-muted-foreground mt-1 leading-relaxed">Automated Let's Encrypt SSL generation and powerful web-based file editor for complete convenience.</p>
            </div>
          </div>
        </div>
      </div>

      {/* Right Screenshot Showcase Column (7 cols) */}
      <div class="lg:col-span-7 relative">
        {/* Glow backdrop behind frame */}
        <div class="absolute -inset-1 bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-400 rounded-3xl opacity-30 blur-xl"></div>
        
        {/* Browser Window Container */}
        <div class="relative rounded-2xl bg-zinc-950 border border-zinc-800 shadow-2xl overflow-hidden">
          
          {/* Top Browser Bar */}
          <div class="px-4 py-3 bg-zinc-900/90 border-b border-zinc-800 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
            </div>
            
            {/* Address Bar */}
            <div class="flex items-center gap-2 px-3 py-1 rounded-lg bg-zinc-950/80 border border-zinc-800 text-[11px] font-mono text-zinc-400 max-w-sm w-full truncate">
              <span class="text-emerald-400">https://</span>
              <span class="text-zinc-200 truncate">cpanel.yourdomain.com:2083</span>
            </div>

            <div class="text-[10px] font-extrabold text-blue-400 bg-blue-500/10 px-2 py-0.5 rounded border border-blue-500/20 shrink-0">
              cPanel & WHM
            </div>
          </div>

          {/* Screenshot Container */}
          <div class="relative bg-zinc-950 p-2 sm:p-3 overflow-hidden group">
            <img 
              src="/dashboards/cpanel-tools-dashboard.png" 
              alt="cPanel Tools & Management Dashboard"
              class="w-full h-auto rounded-xl object-cover shadow-lg border border-zinc-800/80 group-hover:scale-[1.01] transition-transform duration-300"
              width="1200"
              height="675"
              loading="lazy"
              decoding="async"
            />

            {/* Floating Live Callout Badges */}
            <div class="absolute top-6 left-6 hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900/90 border border-blue-500/30 text-xs font-bold text-blue-400 shadow-xl backdrop-blur-md">
              <Zap class="w-3.5 h-3.5 text-amber-400 animate-pulse" />
              <span>LiteSpeed LSCache Active</span>
            </div>

            <div class="absolute bottom-6 right-6 hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900/90 border border-emerald-500/30 text-xs font-bold text-emerald-400 shadow-xl backdrop-blur-md">
              <Shield class="w-3.5 h-3.5 text-emerald-400" />
              <span>Imunify360 AI Guarded</span>
            </div>
          </div>

          {/* Bottom Info Bar */}
          <div class="px-5 py-3 bg-zinc-900/90 border-t border-zinc-800 flex items-center justify-between text-xs text-zinc-400 font-medium">
            <span>Powered by LiteSpeed Enterprise</span>
            <span class="text-blue-400 font-extrabold flex items-center gap-1">
              <span>Pure NVMe SSD Storage</span>
            </span>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>
