---
import { Layers, Shield, Users, Settings, Server, CheckCircle2, ArrowRight, ExternalLink } from 'lucide-react';
---

<section class="py-20 bg-background relative overflow-hidden border-t border-border/40">
  {/* Ambient Background Blur Elements */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-indigo-600/10 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute top-0 right-0 w-96 h-96 bg-purple-500/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
    
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-indigo-500/30 bg-indigo-500/10 text-xs font-bold text-indigo-400 backdrop-blur-sm">
        <Layers class="w-3.5 h-3.5 text-indigo-400" />
        <span>100% White-Label Agency Management</span>
      </div>
      
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-foreground">
        Complete Admin Command with <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-purple-400 to-emerald-400">
          WHM (Web Host Manager)
        </span>
      </h2>
      
      <p class="text-base sm:text-lg text-muted-foreground font-medium">
        Create, manage, and scale independent cPanel hosting accounts for your clients. Set custom package limits, brand your control panel, and automate billing effortlessly under your own domain name.
      </p>
    </div>

    {/* 2-Column Split: Feature Grid Left & Dashboard Screenshot Right */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      {/* Left Feature Column (5 cols) */}
      <div class="lg:col-span-5 space-y-6">
        <div class="p-5 rounded-2xl bg-card border border-border/80 hover:border-indigo-500/40 transition-all shadow-md group">
          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-indigo-500/10 text-indigo-500 dark:text-indigo-400 border border-indigo-500/20 group-hover:scale-105 transition-transform shrink-0">
              <Shield class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-base font-extrabold text-foreground group-hover:text-indigo-500 transition-colors">100% White-Label Branding</h3>
              <p class="text-xs text-muted-foreground mt-1 leading-relaxed">Customize logos, themes, and nameservers (ns1/ns2.yourbrand.com) so HostingSpell remains completely invisible to your clients.</p>
            </div>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-card border border-border/80 hover:border-indigo-500/40 transition-all shadow-md group">
          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-purple-500/10 text-purple-500 dark:text-purple-400 border border-purple-500/20 group-hover:scale-105 transition-transform shrink-0">
              <Users class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-base font-extrabold text-foreground group-hover:text-indigo-500 transition-colors">Multi-Account Provisioning</h3>
              <p class="text-xs text-muted-foreground mt-1 leading-relaxed">Create, modify, suspend, or terminate client cPanel accounts instantly from your WHM dashboard in 1 click.</p>
            </div>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-card border border-border/80 hover:border-indigo-500/40 transition-all shadow-md group">
          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-emerald-500/10 text-emerald-500 dark:text-emerald-400 border border-emerald-500/20 group-hover:scale-105 transition-transform shrink-0">
              <Settings class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-base font-extrabold text-foreground group-hover:text-indigo-500 transition-colors">Custom Tiered Hosting Packages</h3>
              <p class="text-xs text-muted-foreground mt-1 leading-relaxed">Define custom disk space, monthly bandwidth, email quota, and MySQL database limits for your agency packages.</p>
            </div>
          </div>
        </div>

        <div class="p-5 rounded-2xl bg-card border border-border/80 hover:border-indigo-500/40 transition-all shadow-md group">
          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-cyan-500/10 text-cyan-500 dark:text-cyan-400 border border-cyan-500/20 group-hover:scale-105 transition-transform shrink-0">
              <Server class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-base font-extrabold text-foreground group-hover:text-indigo-500 transition-colors">Free WHMCS Billing Integration</h3>
              <p class="text-xs text-muted-foreground mt-1 leading-relaxed">Automate client orders, invoicing, support ticketing, and cPanel account creation seamlessly with WHMCS.</p>
            </div>
          </div>
        </div>
      </div>

      {/* Right Screenshot Showcase Column (7 cols) */}
      <div class="lg:col-span-7 relative">
        {/* Glow backdrop behind frame */}
        <div class="absolute -inset-1 bg-gradient-to-r from-indigo-600 via-purple-600 to-emerald-400 rounded-3xl opacity-30 blur-xl"></div>
        
        {/* Browser Window Container */}
        <div class="relative rounded-2xl bg-zinc-950 border border-zinc-800 shadow-2xl overflow-hidden">
          
          {/* Top Browser Bar */}
          <div class="px-4 py-3 bg-zinc-900/90 border-b border-zinc-800 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
            </div>
            
            {/* Address Bar */}
            <div class="flex items-center gap-2 px-3 py-1 rounded-lg bg-zinc-950/80 border border-zinc-800 text-[11px] font-mono text-zinc-400 max-w-sm w-full truncate">
              <span class="text-emerald-400">https://</span>
              <span class="text-zinc-200 truncate">whm.youragencybrand.com:2087</span>
            </div>

            <div class="text-[10px] font-extrabold text-indigo-400 bg-indigo-500/10 px-2 py-0.5 rounded border border-indigo-500/20 shrink-0">
              WHM ADMIN
            </div>
          </div>

          {/* Screenshot Container */}
          <div class="relative bg-zinc-950 p-2 sm:p-3 overflow-hidden group">
            <img 
              src="/dashboards/whm-favorites-dashboard.webp" 
              alt="WHM Web Host Manager Admin Favorites Dashboard"
              class="w-full h-auto rounded-xl object-cover shadow-lg border border-zinc-800/80 group-hover:scale-[1.01] transition-transform duration-300"
              width="1200"
              height="675"
              loading="lazy"
              decoding="async"
            />

            {/* Floating Live Callout Badges */}
            <div class="absolute top-6 left-6 hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900/90 border border-indigo-500/30 text-xs font-bold text-indigo-400 shadow-xl backdrop-blur-md">
              <Shield class="w-3.5 h-3.5 text-indigo-400" />
              <span>100% White-Label Private DNS</span>
            </div>

            <div class="absolute bottom-6 right-6 hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900/90 border border-emerald-500/30 text-xs font-bold text-emerald-400 shadow-xl backdrop-blur-md">
              <Users class="w-3.5 h-3.5 text-emerald-400" />
              <span>Unlimited cPanel Accounts</span>
            </div>
          </div>

          {/* Bottom Info Bar */}
          <div class="px-5 py-3 bg-zinc-900/90 border-t border-zinc-800 flex items-center justify-between text-xs text-zinc-400 font-medium">
            <span>WHM Admin Dashboard v118</span>
            <span class="text-indigo-400 font-extrabold flex items-center gap-1">
              <span>Automated WHMCS Provisioning</span>
            </span>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>
