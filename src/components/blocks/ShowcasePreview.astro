---
import { Button } from "@/components/ui/button";

const previewClients = [
  {
    name: "Bookflow",
    industry: "E-Commerce",
    image: "https://staging.2hs.in/showcase/showcase-bookflow.png"
  },
  {
    name: "Digicloudify",
    industry: "Cloud & IT Services",
    image: "https://staging.2hs.in/showcase/showcase-digicloudify.png"
  },
  {
    name: "Zorba Stays",
    industry: "Tourism",
    image: "https://staging.2hs.in/showcase/showcase-zorbastays.png"
  }
];
---

<section class="py-24 bg-background relative overflow-hidden border-t border-border/40">
  <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
    <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
      <div class="max-w-2xl">
        <span class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-sm font-semibold text-primary mb-4">
          Client Showcase
        </span>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Trusted by 110,000+ Websites</h2>
        <p class="text-muted-foreground text-lg">
          From solo founders to enterprise teams — see who is building on HostingSpell.
        </p>
      </div>
      <div>
        <a href="/showcase">
          <Button variant="outline" className="h-12 px-6 rounded-xl font-bold hidden md:inline-flex">
            View All Projects &rarr;
          </Button>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {previewClients.map(client => (
        <div class="bg-card rounded-2xl border border-border/50 p-6 shadow-sm hover:shadow-lg transition-all hover:-translate-y-1">
          <div class="w-full bg-white dark:bg-zinc-100 rounded-xl p-4 border border-border/20 h-28 flex items-center justify-center relative mb-4">
            <img src={client.image} alt={client.name} class="max-h-16 w-auto object-contain" />
          </div>
          <div class="flex items-center justify-between">
            <h3 class="font-bold">{client.name}</h3>
            <span class="text-xs font-semibold text-muted-foreground bg-muted px-2 py-1 rounded-md">{client.industry}</span>
          </div>
        </div>
      ))}
    </div>
    
    <div class="mt-8 text-center md:hidden">
      <a href="/showcase">
        <Button variant="outline" className="w-full h-12 rounded-xl font-bold">
          View All Projects &rarr;
        </Button>
      </a>
    </div>
  </div>
  
  <div class="absolute right-0 top-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/5 rounded-full blur-[100px] pointer-events-none"></div>
</section>
