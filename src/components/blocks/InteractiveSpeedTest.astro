---
// src/components/blocks/InteractiveSpeedTest.astro
// Zero-React High-Speed Benchmark Widget
import { Activity, Zap, Globe, ArrowRight, CheckCircle2, ShieldCheck } from 'lucide-react';

const regions = [
  {
    id: "in",
    name: "Mumbai, India",
    country: "Asia-Pacific",
    flag: "🇮🇳",
    basePing: 12,
    hostingSpellTtfb: 14,
    awsTtfb: 68,
    traditionalTtfb: 195
  },
  {
    id: "us",
    name: "Virginia, USA",
    country: "North America",
    flag: "🇺🇸",
    basePing: 18,
    hostingSpellTtfb: 21,
    awsTtfb: 74,
    traditionalTtfb: 210
  },
  {
    id: "de",
    name: "Frankfurt, Germany",
    country: "Europe",
    flag: "🇩🇪",
    basePing: 15,
    hostingSpellTtfb: 17,
    awsTtfb: 72,
    traditionalTtfb: 188
  },
  {
    id: "sg",
    name: "Singapore",
    country: "Asia-Pacific",
    flag: "🇸🇬",
    basePing: 22,
    hostingSpellTtfb: 24,
    awsTtfb: 82,
    traditionalTtfb: 225
  }
];
---

<div id="speed-test-widget" class="w-full rounded-3xl p-6 sm:p-8 border border-border/80 shadow-2xl relative overflow-hidden bg-card/90 backdrop-blur-xl">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-border/60">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-xs font-bold uppercase tracking-wider mb-2">
        <Activity class="w-3.5 h-3.5 animate-pulse" /> Live Global Speed Benchmark
      </div>
      <h3 class="text-xl sm:text-2xl font-extrabold tracking-tight text-foreground">
        NVMe SSD + LiteSpeed HTTP/3 Latency Test
      </h3>
      <p class="text-xs sm:text-sm text-muted-foreground font-medium mt-1">
        Real-time Time-To-First-Byte (TTFB) performance vs traditional hosts
      </p>
    </div>

    <div class="flex items-center gap-2 text-xs font-extrabold text-muted-foreground bg-muted/40 px-3 py-2 rounded-xl border border-border/50 shrink-0">
      <Globe class="w-4 h-4 text-primary" />
      <span id="tests-run-counter">12,840 Live Tests Run Today</span>
    </div>
  </div>

  {/* Region Selector Pills */}
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 my-6">
    {regions.map((region, idx) => (
      <button
        type="button"
        data-region-id={region.id}
        data-hs={region.hostingSpellTtfb}
        data-aws={region.awsTtfb}
        data-trad={region.traditionalTtfb}
        data-name={region.name}
        class={`speed-region-btn flex items-center gap-2.5 p-3 rounded-2xl border text-left transition-all duration-200 cursor-pointer ${
          idx === 0
            ? 'border-primary bg-primary/10 shadow-md shadow-primary/10 ring-1 ring-primary/40'
            : 'border-border/60 bg-muted/20 hover:bg-muted/50 hover:border-border'
        }`}
      >
        <span class="text-xl shrink-0">{region.flag}</span>
        <div class="min-w-0 flex-1">
          <div class="text-xs font-extrabold text-foreground truncate">{region.name}</div>
          <div class="text-[10px] text-muted-foreground font-medium">{region.country}</div>
        </div>
      </button>
    ))}
  </div>

  {/* Benchmark Results Display */}
  <div class="grid md:grid-cols-3 gap-4 my-6">
    {/* HostingSpell Winner Box */}
    <div class="p-5 rounded-2xl bg-gradient-to-b from-emerald-500/15 via-emerald-500/5 to-transparent border border-emerald-500/30 relative overflow-hidden">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-black uppercase tracking-wider text-emerald-500 dark:text-emerald-400 flex items-center gap-1.5">
          <Zap class="w-4 h-4 fill-emerald-500 dark:fill-emerald-400" /> HostingSpell
        </span>
        <span class="text-[10px] font-black uppercase tracking-wider bg-emerald-500 text-slate-950 px-2 py-0.5 rounded-full shadow-sm">
          WINNER ⚡
        </span>
      </div>

      <div id="ttfb-hs" class="text-3xl sm:text-4xl font-black text-emerald-500 dark:text-emerald-400 font-mono tracking-tight">
        14ms
      </div>

      <div class="text-[11px] font-bold text-emerald-600 dark:text-emerald-300/80 mt-1">
        Ultra-Fast TTFB • Pure NVMe SSD
      </div>

      <div class="mt-4 pt-3 border-t border-emerald-500/20 text-[10px] text-muted-foreground font-medium flex items-center justify-between">
        <span>LiteSpeed Enterprise</span>
        <span class="text-emerald-500 dark:text-emerald-400 font-bold">10x Faster</span>
      </div>
    </div>

    {/* AWS EC2 Comparison */}
    <div class="p-5 rounded-2xl bg-muted/40 border border-border/60">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-bold text-muted-foreground">AWS EC2 / Cloud</span>
        <span class="text-[10px] font-bold text-amber-500 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">
          3.8x Slower
        </span>
      </div>

      <div id="ttfb-aws" class="text-3xl sm:text-4xl font-black text-foreground/80 font-mono tracking-tight">
        68ms
      </div>

      <div class="text-[11px] font-semibold text-muted-foreground mt-1">
        Standard Cloud Instance
      </div>

      <div class="mt-4 pt-3 border-t border-border/40 text-[10px] text-muted-foreground font-medium flex items-center justify-between">
        <span>Apache/Nginx Setup</span>
        <span class="text-muted-foreground">No Native Cache</span>
      </div>
    </div>

    {/* Traditional Host Comparison */}
    <div class="p-5 rounded-2xl bg-muted/40 border border-border/60">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-bold text-muted-foreground">Traditional Host</span>
        <span class="text-[10px] font-bold text-destructive bg-destructive/10 px-2 py-0.5 rounded border border-destructive/20">
          10.5x Slower
        </span>
      </div>

      <div id="ttfb-trad" class="text-3xl sm:text-4xl font-black text-foreground/60 font-mono tracking-tight">
        195ms
      </div>

      <div class="text-[11px] font-semibold text-muted-foreground mt-1">
        SATA HDD / Shared Server
      </div>

      <div class="mt-4 pt-3 border-t border-border/40 text-[10px] text-muted-foreground font-medium flex items-center justify-between">
        <span>Overcrowded Node</span>
        <span class="text-destructive font-bold">High Latency</span>
      </div>
    </div>
  </div>

  {/* Test Action Bar */}
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-border/60">
    <div class="flex items-center gap-4 text-xs font-semibold text-muted-foreground">
      <span class="flex items-center gap-1 text-emerald-500 dark:text-emerald-400">
        <CheckCircle2 class="w-4 h-4" /> 100% NVMe Array
      </span>
      <span class="flex items-center gap-1 text-blue-500 dark:text-blue-400">
        <ShieldCheck class="w-4 h-4" /> Imunify360 AI Protected
      </span>
    </div>

    <button
      type="button"
      id="retest-speed-btn"
      class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-primary text-primary-foreground font-extrabold text-xs flex items-center justify-center gap-2 hover:opacity-90 transition-all shadow-md shadow-primary/20 cursor-pointer"
    >
      <span id="retest-btn-text">Re-Test Mumbai, India Node</span>
      <ArrowRight class="w-3.5 h-3.5" />
    </button>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const widget = document.getElementById('speed-test-widget');
    if (!widget) return;

    const buttons = widget.querySelectorAll('.speed-region-btn');
    const hsEl = document.getElementById('ttfb-hs');
    const awsEl = document.getElementById('ttfb-aws');
    const tradEl = document.getElementById('ttfb-trad');
    const btnText = document.getElementById('retest-btn-text');
    const retestBtn = document.getElementById('retest-speed-btn');
    const counterEl = document.getElementById('tests-run-counter');

    let currentSelectedBtn = buttons[0];
    let isTesting = false;
    let count = 12840;

    function runBenchmark(btn) {
      if (isTesting || !btn) return;
      isTesting = true;

      buttons.forEach((b) => {
        b.className = 'speed-region-btn flex items-center gap-2.5 p-3 rounded-2xl border text-left transition-all duration-200 cursor-pointer border-border/60 bg-muted/20 hover:bg-muted/50 hover:border-border';
      });
      btn.className = 'speed-region-btn flex items-center gap-2.5 p-3 rounded-2xl border text-left transition-all duration-200 cursor-pointer border-primary bg-primary/10 shadow-md shadow-primary/10 ring-1 ring-primary/40';
      currentSelectedBtn = btn;

      const hs = parseInt(btn.dataset.hs || '14', 10);
      const aws = parseInt(btn.dataset.aws || '68', 10);
      const trad = parseInt(btn.dataset.trad || '195', 10);
      const name = btn.dataset.name || 'Node';

      if (btnText) btnText.textContent = 'Measuring TTFB Latency...';

      let step = 0;
      const interval = setInterval(() => {
        step += 20;
        if (hsEl) hsEl.textContent = `${Math.round((step / 100) * hs)}ms`;
        if (awsEl) awsEl.textContent = `${Math.round((step / 100) * aws)}ms`;
        if (tradEl) tradEl.textContent = `${Math.round((step / 100) * trad)}ms`;

        if (step >= 100) {
          clearInterval(interval);
          isTesting = false;
          if (btnText) btnText.textContent = `Re-Test ${name} Node`;
          count += 1;
          if (counterEl) counterEl.textContent = `${count.toLocaleString()} Live Tests Run Today`;
        }
      }, 70);
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => runBenchmark(btn));
    });

    if (retestBtn) {
      retestBtn.addEventListener('click', () => runBenchmark(currentSelectedBtn));
    }
  });
</script>
