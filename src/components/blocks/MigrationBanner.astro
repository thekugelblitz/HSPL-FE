---
import { ArrowRight, CheckCircle2, ShieldCheck, Zap } from 'lucide-react';
---

<section class="dark py-16 bg-[#000000] text-white border-y border-zinc-800/90 relative overflow-hidden shadow-2xl">
  {/* Ambient Glowing Orbs */}
  <div class="absolute -left-20 -top-20 w-80 h-80 bg-blue-600/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-indigo-600/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
    <div class="grid lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-8 space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/15 border border-blue-500/30 text-blue-400 text-xs font-bold uppercase tracking-wider">
          <Zap class="w-3.5 h-3.5 text-blue-400" />
          <span>Hassle-Free Transition</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
          Migrate to HostingSpell with Zero Downtime & Zero Data Loss
        </h2>
        <p class="text-zinc-400 text-sm sm:text-base max-w-2xl leading-relaxed">
          Stuck with a slow or expensive hosting provider? Our migration specialists will move all your websites, databases, emails, and SSL settings for free—with guaranteed zero downtime.
        </p>
        <div class="flex flex-wrap gap-4 text-xs font-semibold text-zinc-200 pt-2">
          <div class="flex items-center gap-1.5 bg-zinc-900/90 px-3 py-1.5 rounded-lg border border-zinc-800">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>cPanel to cPanel 1-Click Migration</span>
          </div>
          <div class="flex items-center gap-1.5 bg-zinc-900/90 px-3 py-1.5 rounded-lg border border-zinc-800">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>DirectAdmin / Plesk Supported</span>
          </div>
          <div class="flex items-center gap-1.5 bg-zinc-900/90 px-3 py-1.5 rounded-lg border border-zinc-800">
            <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Completed in under 24 hours</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-4 justify-center">
        <a 
          href="https://manage.hostingspell.com/submitticket.php?step=2&deptid=1" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#0073EC] hover:bg-[#005bb5] text-white font-extrabold transition-all shadow-lg shadow-blue-500/20 text-xs sm:text-sm"
        >
          <span>Request Free Migration</span>
          <ArrowRight class="w-4 h-4" />
        </a>
        <a 
          href="/contact" 
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-200 hover:text-white font-bold transition-all border border-zinc-800 text-xs sm:text-sm"
        >
          <span>Talk to Migration Team</span>
        </a>
      </div>
    </div>
  </div>
</section>
