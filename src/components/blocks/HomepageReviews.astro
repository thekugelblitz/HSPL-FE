---
// src/components/blocks/HomepageReviews.astro
// High-Converting Wall of Love & Customer Ratings for the Front Page
import { Star, CheckCircle2, Quote, ArrowRight, ShieldCheck, Heart } from 'lucide-react';

const ratings = [
  { platform: "Trustpilot", rating: "4.8 / 5.0", subtext: "1,420+ Verified Reviews", badge: "Excellent" },
  { platform: "HostAdvice", rating: "4.9 / 5.0", subtext: "Top 10 Reseller Host Award", badge: "Top Performer" },
  { platform: "G2 Crowd", rating: "4.7 / 5.0", subtext: "High Performer 2026", badge: "Leader" }
];

const featuredReviews = [
  {
    name: "Alex Rivera",
    role: "Lead DevOps Architect",
    company: "SaaSify Inc.",
    category: "SaaS & DevOps",
    avatar: "https://i.pravatar.cc/150?u=a042581f4e29026024d",
    rating: 5,
    text: "Migrated 40+ client sites from cPanel VPS to HostingSpell NVMe Cloud. Average TTFB dropped from 650ms to 92ms. The speed difference is astounding! Zero downtime during migration."
  },
  {
    name: "Sarah Jenkins",
    role: "E-Commerce Founder",
    company: "Lumiere Goods",
    category: "E-Commerce",
    avatar: "https://i.pravatar.cc/150?u=a042581f4e29026704d",
    rating: 5,
    text: "Our WooCommerce store processed 15,000 orders during Black Friday with zero slowdowns. The LiteSpeed cache handled flash spikes seamlessly and support migrated us for free."
  },
  {
    name: "Marcus Thorne",
    role: "Agency Founder",
    company: "Thorne Design Agency",
    category: "Agency Reseller",
    avatar: "https://i.pravatar.cc/150?u=a048581f4e29026701d",
    rating: 5,
    text: "Managing 80+ cPanel client accounts through WHM Reseller Hosting on HostingSpell has been rock solid. Unlimited SSL, automatic backups, and 24/7 Tier-3 support make it unbeatable."
  },
  {
    name: "Elena Rostova",
    role: "WordPress Architect",
    company: "TechPulse Blog",
    category: "WordPress",
    avatar: "https://i.pravatar.cc/150?u=a042581f4e29026708c",
    rating: 5,
    text: "Switched from a high-cost legacy host to HostingSpell Managed WordPress. Our Core Web Vitals scores hit 100/100 on Google PageSpeed Insights immediately."
  },
  {
    name: "David Sterling",
    role: "CTO & Co-Founder",
    company: "Quantum Analytics",
    category: "High-Traffic Stack",
    avatar: "https://i.pravatar.cc/150?u=a042581f4e29026709a",
    rating: 5,
    text: "The Bare-Metal Dedicated Server with Dual AMD EPYC 9654 processors gives us unmatched IOPS for heavy database processing at half the cost of AWS EC2."
  },
  {
    name: "Devon Chen",
    role: "Senior Full-Stack Developer",
    company: "Vortex Digital",
    category: "AI & Fullstack",
    avatar: "https://i.pravatar.cc/150?u=a042581f4e29026703b",
    rating: 5,
    text: "The AI Web Builder + Node.js hosting stack allowed us to launch our SaaS MVP in a single weekend. The instant preview features and automatic SSL renewal make it a joy to use."
  }
];
---

<section class="py-24 bg-muted/20 border-b border-border/40 relative overflow-hidden">
  {/* Ambient Subtle Orbs */}
  <div class="pointer-events-none absolute -left-32 top-1/2 -translate-y-1/2 w-96 h-96 bg-primary/10 rounded-full blur-[140px]"></div>
  <div class="pointer-events-none absolute -right-32 bottom-0 w-96 h-96 bg-amber-500/10 rounded-full blur-[140px]"></div>

  <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
    
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 text-xs font-extrabold rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-500 uppercase tracking-wider mb-4">
        <Heart class="w-3.5 h-3.5 fill-amber-500" />
        <span>Wall of Love & Verified Feedback</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-foreground">
        Loved by Founders, Developers & Agencies Worldwide
      </h2>
      <p class="text-muted-foreground text-base sm:text-lg mt-3 leading-relaxed">
        See why 135,000+ website owners trust HostingSpell for blazing NVMe speed, zero-downtime reliability, and 24/7 human engineering support.
      </p>
    </div>

    {/* Platform Ratings Strip */}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-14">
      {ratings.map(item => (
        <div class="p-6 rounded-2xl bg-card border border-border/80 text-center shadow-xs hover:border-primary/40 transition-all">
          <div class="inline-block text-[10px] font-extrabold uppercase tracking-wider text-amber-600 dark:text-amber-400 bg-amber-500/10 border border-amber-500/20 px-2.5 py-0.5 rounded-full mb-2">
            {item.badge}
          </div>
          <div class="text-lg font-black text-foreground">{item.platform}</div>
          <div class="text-2xl font-black text-transparent bg-clip-text bg-gradient-to-r from-amber-500 to-yellow-500 my-1">
            {item.rating}
          </div>
          <div class="text-xs text-muted-foreground font-medium">{item.subtext}</div>
        </div>
      ))}
    </div>

    {/* Customer Reviews 3-Column Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {featuredReviews.map(review => (
        <div class="bg-card border border-border/80 rounded-3xl p-7 flex flex-col justify-between shadow-sm hover:shadow-xl hover:border-primary/40 transition-all duration-300 group hover:-translate-y-1">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-[10px] font-black uppercase tracking-wider text-primary bg-primary/10 border border-primary/20 px-2.5 py-1 rounded-md">
                {review.category}
              </span>
              <div class="flex text-amber-400 text-xs">
                {[...Array(review.rating)].map(() => (
                  <Star class="w-3.5 h-3.5 fill-amber-400 text-amber-400" />
                ))}
              </div>
            </div>

            <Quote class="w-6 h-6 text-primary/30 mb-3" />
            
            <p class="text-foreground/90 text-sm leading-relaxed font-medium mb-6">
              "{review.text}"
            </p>
          </div>

          <div class="pt-4 border-t border-border/60 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <img 
                src={review.avatar} 
                alt={review.name} 
                width="40" 
                height="40" 
                loading="lazy" 
                decoding="async" 
                class="w-10 h-10 rounded-full border border-primary/20 object-cover" 
              />
              <div>
                <h4 class="font-bold text-foreground text-sm leading-tight">{review.name}</h4>
                <p class="text-xs text-muted-foreground">{review.role} • <span class="font-semibold text-foreground">{review.company}</span></p>
              </div>
            </div>
            
            <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0" title="Verified Customer" />
          </div>
        </div>
      ))}
    </div>

    {/* Section Footer Callout */}
    <div class="text-center">
      <a 
        href="/reviews" 
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-card border border-border/80 hover:border-primary/50 text-foreground font-extrabold text-sm shadow-sm hover:shadow-md transition-all group"
      >
        <span>Read All 1,400+ Verified Customer Reviews</span>
        <ArrowRight class="w-4 h-4 text-primary transition-transform group-hover:translate-x-1" />
      </a>
    </div>

  </div>
</section>
