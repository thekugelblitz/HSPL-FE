---
import { Search } from 'lucide-react';
---

<section class="py-16 bg-primary relative overflow-hidden">
  <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"></div>
  <div class="container mx-auto px-4 max-w-screen-xl relative z-10 text-center">
    
    <h2 class="text-3xl font-bold text-white mb-2">Find Your Perfect Domain Name</h2>
    <p class="text-primary-foreground/80 mb-8">Enter your domain or keyword to check availability.</p>
    
    <div class="max-w-3xl mx-auto bg-background p-2 rounded-xl shadow-2xl flex items-center mb-8 relative">
      <div class="pl-4 pr-2 text-muted-foreground">
        www.
      </div>
      <input 
        type="text" 
        placeholder="Search for a domain name..." 
        class="flex-1 bg-transparent border-none focus:outline-none text-foreground py-3"
      />
      <div class="border-l border-border/50 pl-3 pr-2 hidden sm:block">
        <select class="bg-transparent border-none text-muted-foreground focus:outline-none font-medium">
          <option>.com</option>
          <option>.in</option>
          <option>.net</option>
          <option>.org</option>
          <option>.co.in</option>
        </select>
      </div>
      <button class="bg-primary hover:bg-primary/90 text-white px-6 py-3 rounded-lg font-bold flex items-center gap-2 transition-colors">
        <Search className="w-5 h-5" />
        <span class="hidden sm:inline">Search</span>
      </button>
    </div>

    <div class="flex flex-wrap justify-center items-center gap-6 sm:gap-12">
      <div class="text-center">
        <div class="text-white font-extrabold text-2xl">.com</div>
        <div class="text-primary-foreground/70 text-sm font-medium">₹870.00</div>
      </div>
      <div class="text-center">
        <div class="text-white font-extrabold text-2xl">.in</div>
        <div class="text-primary-foreground/70 text-sm font-medium">₹399.00</div>
      </div>
      <div class="text-center">
        <div class="text-white font-extrabold text-2xl">.net</div>
        <div class="text-primary-foreground/70 text-sm font-medium">₹900.00</div>
      </div>
      <div class="text-center">
        <div class="text-white font-extrabold text-2xl">.org</div>
        <div class="text-primary-foreground/70 text-sm font-medium">₹900.00</div>
      </div>
      <div class="text-center">
        <div class="text-white font-extrabold text-2xl">.co.in</div>
        <div class="text-primary-foreground/70 text-sm font-medium">₹399.00</div>
      </div>
    </div>
  </div>
</section>
