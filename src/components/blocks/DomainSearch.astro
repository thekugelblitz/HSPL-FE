---
import { Search, Globe, ArrowRight, ShieldCheck } from 'lucide-react';
---

<section class="py-20 bg-background relative border-t border-border/40 overflow-hidden bg-grid-pattern">
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-blue-600/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="container mx-auto px-4 max-w-screen-xl relative z-10 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold uppercase tracking-wider mb-4">
      <Globe class="w-3.5 h-3.5" /> Instant Availability Check
    </div>
    
    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">
      Find Your Perfect Domain Name
    </h2>
    <p class="text-muted-foreground text-sm sm:text-base max-w-xl mx-auto mb-8">
      Register your brand's web address with free WHOIS privacy, full DNS management, and instant activation.
    </p>
    
    <form class="max-w-3xl mx-auto glass-card p-2 rounded-2xl border border-white/10 shadow-2xl flex items-center mb-8 relative glow-card" onsubmit="event.preventDefault(); window.location.href='/domain';">
      <div class="pl-4 pr-2 text-muted-foreground font-mono text-sm hidden sm:block">
        www.
      </div>
      <input 
        type="text" 
        placeholder="Enter domain or keyword (e.g. mybrand)..." 
        class="flex-1 bg-transparent border-none focus:outline-none text-foreground py-3.5 px-3 text-base placeholder:text-muted-foreground/60"
      />
      <div class="border-l border-border/50 pl-3 pr-2 hidden sm:block">
        <select class="bg-transparent border-none text-muted-foreground focus:outline-none font-bold text-sm">
          <option>.com</option>
          <option>.in</option>
          <option>.net</option>
          <option>.org</option>
          <option>.store</option>
        </select>
      </div>
      <button type="submit" class="bg-primary hover:opacity-90 text-primary-foreground px-6 py-3.5 rounded-xl font-bold text-sm flex items-center gap-2 transition-all shadow-md shadow-primary/20 shrink-0">
        <Search class="w-4 h-4" />
        <span class="hidden sm:inline">Search Domain</span>
      </button>
    </form>

    {/* TLD Price Badges */}
    <div class="flex flex-wrap justify-center items-center gap-4 sm:gap-6 max-w-4xl mx-auto">
      <div class="glass-card px-5 py-3 rounded-2xl border border-border/40 text-center min-w-[110px] hover:border-primary/50 transition-colors">
        <div class="font-extrabold text-lg text-foreground mb-0.5">.com</div>
        <div class="text-primary font-bold text-xs">$9.99<span class="text-[10px] text-muted-foreground">/yr</span></div>
      </div>

      <div class="glass-card px-5 py-3 rounded-2xl border border-emerald-500/30 bg-emerald-950/20 text-center min-w-[110px]">
        <div class="font-extrabold text-lg text-emerald-400 mb-0.5 flex items-center justify-center gap-1">
          <span>.in</span>
          <span class="text-[9px] uppercase bg-emerald-500 text-slate-950 px-1 rounded font-black">Sale</span>
        </div>
        <div class="text-emerald-400 font-bold text-xs">$3.99<span class="text-[10px] text-muted-foreground">/yr</span></div>
      </div>

      <div class="glass-card px-5 py-3 rounded-2xl border border-border/40 text-center min-w-[110px] hover:border-primary/50 transition-colors">
        <div class="font-extrabold text-lg text-foreground mb-0.5">.net</div>
        <div class="text-blue-400 font-bold text-xs">$11.99<span class="text-[10px] text-muted-foreground">/yr</span></div>
      </div>

      <div class="glass-card px-5 py-3 rounded-2xl border border-border/40 text-center min-w-[110px] hover:border-primary/50 transition-colors">
        <div class="font-extrabold text-lg text-foreground mb-0.5">.org</div>
        <div class="text-purple-400 font-bold text-xs">$12.99<span class="text-[10px] text-muted-foreground">/yr</span></div>
      </div>

      <div class="glass-card px-5 py-3 rounded-2xl border border-border/40 text-center min-w-[110px] hover:border-primary/50 transition-colors">
        <div class="font-extrabold text-lg text-foreground mb-0.5">.store</div>
        <div class="text-amber-400 font-bold text-xs">$1.99<span class="text-[10px] text-muted-foreground">/yr</span></div>
      </div>
    </div>

    <div class="mt-6 text-xs text-muted-foreground font-medium flex items-center justify-center gap-1.5">
      <ShieldCheck class="w-4 h-4 text-emerald-400" />
      <span>All domain registrations include free WHOIS privacy protection & DNS management</span>
    </div>
  </div>
</section>
