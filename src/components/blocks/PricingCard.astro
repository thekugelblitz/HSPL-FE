---
// src/components/blocks/PricingCard.astro
import { Button } from "@/components/ui/button";
import { Check, Zap, ArrowRight, ShieldCheck } from "lucide-react";

interface Props {
  name: string;
  tagline?: string;
  price: string;
  originalPrice?: string;
  discount?: string;
  billingCycle?: string;
  features: string[];
  isPopular?: boolean;
  link?: string;
  ctaText?: string;
}

const { 
  name, 
  tagline,
  price, 
  originalPrice,
  discount,
  billingCycle = "/mo",
  features, 
  isPopular = false,
  link = "https://manage.hostingspell.com",
  ctaText = "Get Started Now"
} = Astro.props;
---

<div class={`relative flex flex-col p-6 sm:p-8 rounded-3xl border transition-all duration-300 hover:border-primary/60 glow-card ${isPopular ? 'border-primary shadow-2xl shadow-primary/10 bg-gradient-to-b from-primary/5 via-card to-card scale-[1.03] z-10' : 'border-border/60 bg-card shadow-sm'}`}>
  {isPopular && (
    <div class="absolute -top-3.5 left-0 right-0 mx-auto w-fit rounded-full bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 px-4 py-1 text-xs font-bold text-white shadow-lg flex items-center gap-1.5 uppercase tracking-wider">
      <Zap class="w-3.5 h-3.5 fill-white" />
      Most Popular & Best Value
    </div>
  )}
  
  <div class="mb-4">
    <div class="flex items-center justify-between">
      <h3 class="text-xl font-extrabold uppercase tracking-tight">{name}</h3>
      {discount && (
        <span class="inline-block px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[11px] font-bold">
          {discount}
        </span>
      )}
    </div>
    {tagline && <p class="text-xs font-bold text-primary uppercase mt-1 tracking-wider">{tagline}</p>}
  </div>
  
  <div class="mb-6 border-b border-border/40 pb-6">
    <div class="flex items-baseline gap-2">
      <span class="text-4xl sm:text-5xl font-black tracking-tight text-foreground">{price}</span>
      <span class="text-xs font-semibold text-muted-foreground">{billingCycle}</span>
    </div>
    {originalPrice && (
      <div class="text-xs text-muted-foreground mt-1">
        Regular price <span class="line-through text-muted-foreground/70">{originalPrice}</span>
      </div>
    )}
  </div>
  
  <ul class="mb-8 flex-1 space-y-3 text-xs sm:text-sm">
    {features.map((feature) => (
      <li class="flex items-start">
        <Check className="mr-2.5 h-4 w-4 text-emerald-400 shrink-0 mt-0.5" />
        <span class="text-foreground/90 font-medium leading-relaxed">{feature}</span>
      </li>
    ))}
  </ul>
  
  <div class="space-y-3 mt-auto">
    <a href={link} target="_blank" rel="noopener noreferrer" class="w-full block group">
      <Button className={`w-full py-6 font-bold text-sm rounded-xl transition-all flex items-center justify-center gap-2 ${isPopular ? 'bg-primary text-primary-foreground hover:opacity-90 shadow-lg shadow-primary/25' : ''}`} variant={isPopular ? 'default' : 'outline'}>
        <span>{ctaText}</span>
        <ArrowRight className="w-4 h-4 transition-transform group-hover:translate-x-1" />
      </Button>
    </a>

    <div class="text-[11px] text-center text-muted-foreground font-medium flex items-center justify-center gap-1">
      <ShieldCheck class="w-3.5 h-3.5 text-emerald-400" />
      <span>30-Day Guarantee • Free Migration</span>
    </div>
  </div>
</div>
