---
// src/components/blocks/PricingCard.astro
import { Check, Zap, ArrowRight, ShieldCheck } from "lucide-react";

interface Props {
  name: string;
  tagline?: string;
  price: string;
  originalPrice?: string;
  discount?: string;
  billingCycle?: string;
  features: string[];
  isPopular?: boolean;
  link?: string;
  ctaText?: string;
}

const { 
  name, 
  tagline,
  price, 
  originalPrice,
  discount,
  billingCycle = "/mo",
  features, 
  isPopular = false,
  link = "https://manage.hostingspell.com",
  ctaText = "Get Started Now"
} = Astro.props;
---

<div class={`relative flex flex-col p-6 sm:p-8 rounded-3xl border transition-all duration-300 hover:border-blue-500/60 ${isPopular ? 'border-[#0073EC] shadow-2xl shadow-blue-500/25 bg-[#141518] bg-gradient-to-b from-[#0c1f38] via-[#141518] to-[#141518] scale-[1.02] z-10' : 'border-zinc-800 bg-[#141518] shadow-sm'} text-white`}>
  {isPopular && (
    <div class="absolute -top-3.5 left-0 right-0 mx-auto w-fit rounded-full bg-[#0073EC] px-4 py-1 text-xs font-extrabold text-white shadow-lg flex items-center gap-1.5 uppercase tracking-wider">
      <Zap class="w-3.5 h-3.5 fill-white text-white" />
      Most Popular Plan
    </div>
  )}
  
  <div class="mb-4">
    <div class="flex items-center justify-between">
      <h3 class="text-xl font-extrabold uppercase tracking-tight text-white">{name}</h3>
      {discount && (
        <span class="inline-block px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[11px] font-bold">
          {discount}
        </span>
      )}
    </div>
    {tagline && <p class="text-xs font-bold text-[#0073EC] uppercase mt-1 tracking-wider">{tagline}</p>}
  </div>
  
  <div class="mb-6 border-b border-zinc-800 pb-6">
    <div class="flex items-baseline gap-2">
      <span class="text-4xl sm:text-5xl font-black tracking-tight text-white">{price}</span>
      <span class="text-xs font-semibold text-zinc-400">{billingCycle}</span>
    </div>
    {originalPrice && (
      <div class="text-xs text-zinc-400 mt-1 flex items-center justify-between">
        <span>Regular price <span class="line-through text-zinc-500">{originalPrice}</span></span>
        <span class="text-[10px] font-bold text-emerald-400">Fixed Renewal Rate</span>
      </div>
    )}
  </div>

  {/* Included Free Value Stack Badge */}
  <div class="mb-6 p-3 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-xs">
    <div class="font-extrabold text-emerald-400 text-[11px] uppercase tracking-wider mb-1 flex items-center gap-1">
      <Zap class="w-3.5 h-3.5 text-emerald-400" /> $220+ Free Enterprise Extras:
    </div>
    <div class="text-[11px] text-zinc-300 font-medium leading-snug">
      Includes Imunify360 AI + JetBackup Snapshots + SSL
    </div>
  </div>
  
  <ul class="mb-8 flex-1 space-y-3 text-xs sm:text-sm">
    {features.map((feature) => (
      <li class="flex items-start">
        <Check class="mr-2.5 h-4 w-4 text-emerald-400 shrink-0 mt-0.5" />
        <span class="text-zinc-200 font-medium leading-relaxed">{feature}</span>
      </li>
    ))}
  </ul>
  
  <div class="space-y-3 mt-auto">
    <a href={link} target="_blank" rel="noopener noreferrer" class="w-full block group">
      <button class={`w-full py-3.5 px-4 font-extrabold text-sm rounded-xl transition-all flex items-center justify-center gap-2 cursor-pointer ${isPopular ? 'bg-[#0073EC] hover:bg-[#005bb5] text-white shadow-lg shadow-blue-500/25' : 'bg-zinc-800 hover:bg-zinc-700 text-white border border-zinc-700/80'}`}>
        <span>{ctaText}</span>
        <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
      </button>
    </a>

    <div class="text-[11px] text-center text-zinc-400 font-medium flex items-center justify-center gap-2 pt-1">
      <div class="flex items-center gap-1">
        <ShieldCheck class="w-3.5 h-3.5 text-emerald-400" />
        <span class="text-zinc-300">30-Day Guarantee</span>
      </div>
      <span>•</span>
      <span class="text-emerald-400 font-bold">⚡ 60s Setup</span>
    </div>
  </div>
</div>
