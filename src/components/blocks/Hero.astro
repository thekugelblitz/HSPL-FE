---
import { Button } from "@/components/ui/button";
import { cloudPlans, premiumPlans, vpsPlans } from '../../lib/data';
import { ArrowRight, CheckCircle2, ShieldCheck, Zap, Server, Cpu, Cloud, Sparkles, Activity, Lock, Globe, HardDrive, Check } from 'lucide-react';

const startingCloud = cloudPlans[0];
const startingPremium = premiumPlans[0];
const startingVps = vpsPlans[0];
---

<section class="relative overflow-hidden bg-background pt-16 pb-20 border-b border-border/40">
  {/* Energetic Ambient Lighting Background */}
  <div class="absolute inset-0 bg-grid-pattern opacity-20 pointer-events-none"></div>
  <div class="absolute left-1/4 top-0 -z-10 h-[600px] w-[800px] -translate-x-1/2 -translate-y-1/3 rounded-full bg-primary/25 blur-[140px]"></div>
  <div class="absolute right-10 top-1/4 -z-10 h-[450px] w-[450px] rounded-full bg-blue-500/20 blur-[130px]"></div>
  <div class="absolute left-10 bottom-10 -z-10 h-[450px] w-[450px] rounded-full bg-purple-500/20 blur-[130px]"></div>
  
  <div class="container relative mx-auto max-w-screen-xl px-4 sm:px-8 z-10">
    
    {/* 2-Column Split Hero Layout */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center mb-16 text-left">
      
      {/* Left Column (7 cols) - High Converting Copy & CTAs */}
      <div class="lg:col-span-7 space-y-6">
        {/* Announcement Pill */}
        <div class="inline-flex items-center gap-2 rounded-full border border-primary/40 bg-primary/10 px-4 py-1.5 text-xs font-bold text-primary backdrop-blur-md shadow-lg shadow-primary/10 hover:border-primary/60 transition-all">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
          </span>
          <span>Next-Gen LiteSpeed NVMe Infrastructure is Live</span>
        </div>
        
        <h1 class="font-extrabold tracking-tight text-4xl sm:text-6xl lg:text-6xl leading-[1.1]">
          Fast, Secure & Scalable <br />
          Cloud Hosting for <span class="text-gradient-primary">Everyone.</span>
        </h1>
        
        <p class="text-base sm:text-lg text-muted-foreground leading-relaxed font-medium max-w-xl">
          Engineered with Pure NVMe SSDs, LiteSpeed Enterprise, Imunify360 AI protection, and 24/7 human support. Save up to 75% vs traditional hosts.
        </p>

        {/* Feature Checkpoints */}
        <ul class="space-y-3 text-xs sm:text-sm font-semibold text-foreground">
          <li class="flex items-center gap-2.5">
            <div class="p-1 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
              <Check className="w-3.5 h-3.5" />
            </div>
            <span>10x Faster LiteSpeed Enterprise + Pure NVMe SSD Storage</span>
          </li>
          <li class="flex items-center gap-2.5">
            <div class="p-1 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
              <Check className="w-3.5 h-3.5" />
            </div>
            <span>Free SSL Certificates, Imunify360 AI & Automatic Daily Backups</span>
          </li>
          <li class="flex items-center gap-2.5">
            <div class="p-1 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
              <Check className="w-3.5 h-3.5" />
            </div>
            <span>24/7 Expert SLA Support & Free Zero-Downtime Migration</span>
          </li>
        </ul>
        
        {/* CTA Actions */}
        <div class="pt-2 flex flex-col sm:flex-row items-center gap-4">
          <a href="#plans" class="w-full sm:w-auto">
            <Button size="lg" className="w-full text-base h-13 px-8 rounded-xl bg-primary hover:opacity-90 shadow-xl shadow-primary/30 font-extrabold flex items-center justify-center gap-2">
              <span>Explore Hosting Plans</span>
              <ArrowRight className="w-4 h-4" />
            </Button>
          </a>
          <a href="/domain" class="w-full sm:w-auto">
            <Button size="lg" variant="outline" className="w-full text-base h-13 px-8 rounded-xl bg-card/90 backdrop-blur font-extrabold hover:bg-muted transition-all border-border/80 shadow-md">
              Search Domain Names
            </Button>
          </a>
        </div>

        {/* Price Anchor */}
        <div class="flex items-center gap-2 text-xs font-semibold text-muted-foreground pt-1">
          <span class="text-foreground font-black">Starting at $1.29/mo</span>
          <span>•</span>
          <span class="text-emerald-400 font-bold">30-Day Money-Back Guarantee</span>
        </div>
      </div>

      {/* Right Column (5 cols) - Interactive Server Performance Visual */}
      <div class="lg:col-span-5 relative">
        <div class="glass-card rounded-3xl p-6 sm:p-7 glow-card border border-border/80 shadow-2xl relative overflow-hidden bg-card/90 backdrop-blur-xl">
          <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-emerald-400 via-primary to-blue-500"></div>

          {/* Live Node Header */}
          <div class="flex items-center justify-between border-b border-border/60 pb-4 mb-5">
            <div class="flex items-center gap-3">
              <div class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-400"></span>
              </div>
              <div>
                <div class="text-xs font-black text-foreground">US-EAST Node #01</div>
                <div class="text-[10px] text-emerald-400 font-bold">🟢 99.99% Operational</div>
              </div>
            </div>
            <span class="text-[10px] font-black uppercase tracking-wider bg-primary/10 text-primary border border-primary/20 px-2.5 py-1 rounded-full">
              LITESPEED
            </span>
          </div>

          {/* Metrics Grid */}
          <div class="grid grid-cols-2 gap-3 mb-5">
            <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60">
              <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] font-bold mb-1">
                <Zap class="w-3.5 h-3.5 text-amber-400" /> Response Time
              </div>
              <div class="text-lg font-black text-foreground">45 ms <span class="text-[10px] text-emerald-400 font-bold">⚡ 10x Faster</span></div>
            </div>

            <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60">
              <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] font-bold mb-1">
                <HardDrive class="w-3.5 h-3.5 text-blue-400" /> NVMe Read Speed
              </div>
              <div class="text-lg font-black text-foreground">6,500 MB/s</div>
            </div>

            <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60">
              <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] font-bold mb-1">
                <Lock class="w-3.5 h-3.5 text-purple-400" /> Security Shield
              </div>
              <div class="text-xs font-black text-emerald-400">Imunify360 AI Active</div>
            </div>

            <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60">
              <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] font-bold mb-1">
                <Globe class="w-3.5 h-3.5 text-emerald-400" /> Datacenters
              </div>
              <div class="text-xs font-black text-foreground">US • DE • IN • SG</div>
            </div>
          </div>

          {/* Special Flash Deal Spotlight */}
          <div class="p-4 rounded-2xl bg-gradient-to-r from-primary/15 via-primary/5 to-transparent border border-primary/30 flex items-center justify-between">
            <div>
              <div class="text-xs font-extrabold text-foreground">Cloud NVMe Deal</div>
              <div class="text-[11px] text-muted-foreground">Free Domain + LiteSpeed + SSL</div>
            </div>
            <div class="text-right">
              <div class="text-lg font-black text-primary">$1.29<span class="text-[10px] font-bold text-muted-foreground">/mo</span></div>
              <span class="text-[9px] font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded">SAVE 74%</span>
            </div>
          </div>

        </div>
      </div>

    </div>

    {/* Featured Plan Cards Section Header */}
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight mb-2">Choose Your Hosting Tier</h2>
      <p class="text-xs sm:text-sm text-muted-foreground font-medium">All plans include 24/7 human support, free 1-click installer, and 30-day money-back guarantee.</p>
    </div>

    {/* Featured Plan Cards Grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 max-w-6xl mx-auto text-left" id="plans">
      
      {/* Cloud Hosting Card */}
      <div class="glass-card rounded-3xl p-7 glow-card flex flex-col justify-between transition-all hover:-translate-y-2 border border-border/80 hover:border-blue-500/50 shadow-xl relative bg-card/80 backdrop-blur-xl">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="p-3.5 bg-blue-500/15 rounded-2xl text-blue-400 border border-blue-500/30">
              <Cloud class="w-6 h-6" />
            </div>
            <span class="text-[11px] font-black uppercase tracking-wider bg-emerald-500/15 text-emerald-400 px-3 py-1 rounded-full border border-emerald-500/30">
              {startingCloud.discount || "SAVE 74%"}
            </span>
          </div>

          <h3 class="text-2xl font-extrabold mb-1 text-foreground">Cloud Hosting</h3>
          <p class="text-xs text-muted-foreground mb-5 leading-relaxed font-medium">High-speed NVMe cloud hosting designed for blogs & business sites.</p>
          
          <div class="mb-6 pt-4 border-t border-border/60">
            <div class="flex items-baseline gap-2">
              <span class="text-4xl font-black text-foreground">{startingCloud.price}</span>
              <span class="text-xs text-muted-foreground font-bold">{startingCloud.billingCycle}</span>
            </div>
            {startingCloud.originalPrice && (
              <div class="text-xs text-muted-foreground mt-1 font-medium">
                Regular <span class="line-through">{startingCloud.originalPrice}</span>
              </div>
            )}
          </div>

          <ul class="space-y-2.5 text-xs text-muted-foreground mb-8 font-semibold">
            <li class="flex items-center gap-2.5"><CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" /> <span class="text-foreground">1 Website & 1GB NVMe SSD</span></li>
            <li class="flex items-center gap-2.5"><CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" /> <span class="text-foreground">LiteSpeed Enterprise + Free SSL</span></li>
            <li class="flex items-center gap-2.5"><CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" /> <span class="text-foreground">Free Zero-Downtime Migration</span></li>
          </ul>
        </div>

        <a href="/cloud-hosting" class="w-full">
          <Button variant="outline" className="w-full font-bold text-xs py-5 rounded-xl hover:bg-primary hover:text-primary-foreground border-border/80 shadow-sm">
            View Cloud Plans
          </Button>
        </a>
      </div>

      {/* Premium Hosting Card - Featured Spotlight Center Stage */}
      <div class="glass-card rounded-3xl p-7 glow-card flex flex-col justify-between border-2 border-primary bg-gradient-to-b from-primary/20 via-card to-card shadow-2xl relative overflow-hidden transition-all hover:-translate-y-2 transform lg:-translate-y-3">
        <div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-blue-400 via-primary to-indigo-500"></div>
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="p-3.5 bg-primary text-primary-foreground rounded-2xl shadow-lg shadow-primary/30">
              <Zap class="w-6 h-6" />
            </div>
            <span class="text-[11px] font-black uppercase tracking-wider bg-primary text-primary-foreground px-3.5 py-1 rounded-full shadow-md">
              🔥 Most Popular
            </span>
          </div>

          <h3 class="text-2xl font-extrabold mb-1 text-foreground">Premium Hosting</h3>
          <p class="text-xs text-muted-foreground mb-5 leading-relaxed font-medium">Dedicated RAM & CPU resources for high-traffic stores & apps.</p>
          
          <div class="mb-6 pt-4 border-t border-border/60">
            <div class="flex items-baseline gap-2">
              <span class="text-4xl font-black text-foreground">{startingPremium.price}</span>
              <span class="text-xs text-muted-foreground font-bold">{startingPremium.billingCycle}</span>
            </div>
            {startingPremium.originalPrice && (
              <div class="text-xs text-muted-foreground mt-1 font-medium">
                Regular <span class="line-through">{startingPremium.originalPrice}</span>
              </div>
            )}
          </div>

          <ul class="space-y-2.5 text-xs text-muted-foreground mb-8 font-semibold">
            <li class="flex items-center gap-2.5"><CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" /> <span class="text-foreground">2 CPU & 2GB Dedicated RAM</span></li>
            <li class="flex items-center gap-2.5"><CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" /> <span class="text-foreground">Unlimited SSD & Bandwidth</span></li>
            <li class="flex items-center gap-2.5"><CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" /> <span class="text-foreground">Linode & DigitalOcean Cloud Nodes</span></li>
          </ul>
        </div>

        <a href="/premium-hosting" class="w-full">
          <Button className="w-full font-extrabold text-xs py-5 rounded-xl bg-primary text-primary-foreground hover:opacity-90 shadow-xl shadow-primary/30">
            Get Premium Plan
          </Button>
        </a>
      </div>

      {/* KVM VPS Hosting Card */}
      <div class="glass-card rounded-3xl p-7 glow-card flex flex-col justify-between transition-all hover:-translate-y-2 border border-border/80 hover:border-purple-500/50 shadow-xl relative bg-card/80 backdrop-blur-xl">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="p-3.5 bg-purple-500/15 rounded-2xl text-purple-400 border border-purple-500/30">
              <Server class="w-6 h-6" />
            </div>
            <span class="text-[11px] font-black uppercase tracking-wider bg-purple-500/15 text-purple-400 px-3 py-1 rounded-full border border-purple-500/30">
              FULL ROOT SSH
            </span>
          </div>

          <h3 class="text-2xl font-extrabold mb-1 text-foreground">KVM VPS Hosting</h3>
          <p class="text-xs text-muted-foreground mb-5 leading-relaxed font-medium">Virtualizor KVM hypervisor with isolated CPU, RAM & Root Access.</p>
          
          <div class="mb-6 pt-4 border-t border-border/60">
            <div class="flex items-baseline gap-2">
              <span class="text-4xl font-black text-foreground">{startingVps.price}</span>
              <span class="text-xs text-muted-foreground font-bold">{startingVps.billingCycle}</span>
            </div>
            <div class="text-xs text-muted-foreground mt-1 font-medium">
              Dedicated KVM Specs
            </div>
          </div>

          <ul class="space-y-2.5 text-xs text-muted-foreground mb-8 font-semibold">
            <li class="flex items-center gap-2.5"><CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" /> <span class="text-foreground">1 CPU Core & 4GB Dedicated RAM</span></li>
            <li class="flex items-center gap-2.5"><CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" /> <span class="text-foreground">40GB NVMe & 1TB Bandwidth</span></li>
            <li class="flex items-center gap-2.5"><CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" /> <span class="text-foreground">Virtualizor 1-Click App Marketplace</span></li>
          </ul>
        </div>

        <a href="/vps" class="w-full">
          <Button variant="outline" className="w-full font-bold text-xs py-5 rounded-xl hover:bg-primary hover:text-primary-foreground border-border/80 shadow-sm">
            View VPS Plans
          </Button>
        </a>
      </div>

    </div>
  </div>
</section>
