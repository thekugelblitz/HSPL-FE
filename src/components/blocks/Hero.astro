---
import { Button } from "@/components/ui/button";
import { cloudPlans, premiumPlans, vpsPlans } from '../../lib/data';

const startingCloud = cloudPlans[0];
const startingPremium = premiumPlans[0];
const startingVps = vpsPlans[0];
---

<section class="relative overflow-visible bg-background pt-24 pb-48 lg:pb-32 lg:mb-24">
  {/* Energetic Background Elements */}
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
  <div class="absolute left-1/2 top-0 -z-10 h-[400px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/30 blur-[120px] animate-in fade-in duration-1000"></div>
  <div class="absolute right-0 top-1/4 -z-10 h-[300px] w-[400px] rounded-full bg-blue-500/20 blur-[100px] animate-in fade-in duration-1000 delay-300"></div>
  <div class="absolute left-0 bottom-0 -z-10 h-[300px] w-[300px] rounded-full bg-indigo-500/20 blur-[100px] animate-in fade-in duration-1000 delay-500"></div>
  
  <div class="container relative mx-auto max-w-screen-xl px-4 sm:px-8 text-center">
    <div class="mx-auto flex max-w-fit items-center justify-center space-x-2 overflow-hidden rounded-full border border-border bg-background px-7 py-2 shadow-[inset_0_-8px_10px_#8ea1fa1f] transition-all hover:border-primary/50 hover:bg-white/5 dark:hover:bg-white/5 mb-8 animate-in fade-in slide-in-from-bottom-4 duration-700">
      <p class="text-sm font-medium text-foreground flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-success"></span>
        </span>
        New: Turbocharged Cloud Hosting is here.
      </p>
    </div>
    
    <h1 class="mx-auto max-w-4xl font-extrabold tracking-tight text-5xl sm:text-6xl md:text-7xl animate-in fade-in slide-in-from-bottom-8 duration-700 delay-150 fill-mode-both">
      Fast, secure, and easy hosting for <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-blue-400 to-indigo-400">everyone.</span>
    </h1>
    
    <p class="mx-auto mt-6 max-w-2xl text-lg sm:text-xl text-muted-foreground leading-relaxed font-medium animate-in fade-in slide-in-from-bottom-4 duration-700 delay-300 fill-mode-both">
      Experience reliable, fast and affordable hosting solutions. Up to 80% savings vs industry standards.
    </p>
    
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 mb-20 animate-in fade-in slide-in-from-bottom-4 duration-700 delay-500 fill-mode-both">
      <a href="/pricing" class="w-full sm:w-auto group">
        <Button size="lg" className="w-full text-base h-14 px-10 rounded-xl shadow-xl shadow-primary/25 group-hover:scale-105 transition-all duration-300 font-bold overflow-hidden relative">
          <span class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></span>
          <span class="relative">Get Started</span>
        </Button>
      </a>
      <a href="/domain" class="w-full sm:w-auto">
        <Button size="lg" variant="outline" className="w-full text-base h-14 px-10 rounded-xl bg-background/50 backdrop-blur font-bold hover:bg-muted/80 transition-all duration-300">
          Search Domains
        </Button>
      </a>
    </div>
  </div>

  {/* Floating Price Cards */}
  <div class="container mx-auto px-4 max-w-5xl relative z-20 translate-y-24 lg:translate-y-1/2">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      {/* Cloud Hosting */}
      <div class="bg-card border border-border/60 rounded-2xl p-6 shadow-xl hover:shadow-2xl hover:-translate-y-1 transition-all duration-300">
        <div class="flex justify-between items-start mb-4">
          <div class="p-3 bg-blue-500/10 rounded-xl text-blue-500">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
          </div>
        </div>
        <h3 class="text-xl font-bold mb-1">Cloud Hosting</h3>
        <p class="text-sm text-muted-foreground mb-4 h-10">High speed SSD cloud hosting for blogs and small businesses.</p>
        <div class="flex items-end gap-1 mb-6">
          <span class="text-sm text-muted-foreground mb-1">From</span>
          <span class="text-3xl font-black">{startingCloud.monthlyPrice}</span>
          <span class="text-sm text-muted-foreground mb-1">/mo</span>
        </div>
        <a href="/cloud-hosting">
          <Button variant="outline" className="w-full font-semibold border-border/60">View Plans</Button>
        </a>
      </div>

      {/* Premium Hosting */}
      <div class="bg-gradient-to-b from-primary/10 to-transparent border border-primary/20 rounded-2xl p-6 shadow-xl hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 relative overflow-hidden">
        <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-blue-400 to-primary"></div>
        <div class="flex justify-between items-start mb-4">
          <div class="p-3 bg-primary rounded-xl text-white shadow-lg shadow-primary/30">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" x2="21" y1="9" y2="9"/><line x1="9" x2="9" y1="21" y2="9"/></svg>
          </div>
          <span class="text-[10px] font-bold uppercase tracking-wider bg-primary/20 text-primary px-2 py-1 rounded-full">Most Popular</span>
        </div>
        <h3 class="text-xl font-bold mb-1">Premium Hosting</h3>
        <p class="text-sm text-muted-foreground mb-4 h-10">Dedicated resources for high traffic ecommerce websites.</p>
        <div class="flex items-end gap-1 mb-6">
          <span class="text-sm text-muted-foreground mb-1">From</span>
          <span class="text-3xl font-black">{startingPremium.monthlyPrice}</span>
          <span class="text-sm text-muted-foreground mb-1">/mo</span>
        </div>
        <a href="/premium-hosting">
          <Button className="w-full font-semibold">View Plans</Button>
        </a>
      </div>

      {/* VPS Hosting */}
      <div class="bg-card border border-border/60 rounded-2xl p-6 shadow-xl hover:shadow-2xl hover:-translate-y-1 transition-all duration-300">
        <div class="flex justify-between items-start mb-4">
          <div class="p-3 bg-emerald-500/10 rounded-xl text-emerald-500">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h20"/><path d="M2 12V6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v6"/><path d="M2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6"/><path d="M6 16h.01"/><path d="M10 16h.01"/><path d="M6 8h.01"/><path d="M10 8h.01"/></svg>
          </div>
        </div>
        <h3 class="text-xl font-bold mb-1">VPS Hosting</h3>
        <p class="text-sm text-muted-foreground mb-4 h-10">Full root access and isolated environments for developers.</p>
        <div class="flex items-end gap-1 mb-6">
          <span class="text-sm text-muted-foreground mb-1">From</span>
          <span class="text-3xl font-black">{startingVps.monthlyPrice}</span>
          <span class="text-sm text-muted-foreground mb-1">/mo</span>
        </div>
        <a href="/vps">
          <Button variant="outline" className="w-full font-semibold border-border/60">View Plans</Button>
        </a>
      </div>

    </div>
  </div>
</section>
