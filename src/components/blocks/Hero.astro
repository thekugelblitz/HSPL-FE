---
// src/components/blocks/Hero.astro
// Transformation-focused hero — sells outcomes, not specs
// Highlights: 135,000+ websites & apps, 11+ Years Independently Owned, 12+ Countries across 4 Continents, AI democratization
import { Button } from "@/components/ui/button";
import { ArrowRight, Check, Sparkles, ShieldCheck, Globe2, Award } from 'lucide-react';
import StaticPrice from '../pricing/StaticPrice.astro';
import { HeroDomainSearch } from './HeroDomainSearch';
---

<section class="relative overflow-hidden bg-background pt-16 sm:pt-20 pb-20 sm:pb-24 border-b border-border/40">
  {/* Subtle ambient background glow */}
  <div class="absolute left-1/2 top-0 -z-0 h-[500px] w-[900px] -translate-x-1/2 -translate-y-1/3 rounded-full bg-primary/12 blur-[150px] pointer-events-none"></div>
  <div class="absolute right-0 bottom-0 -z-0 h-[300px] w-[400px] rounded-full bg-indigo-500/8 blur-[120px] pointer-events-none"></div>

  <div class="container relative mx-auto max-w-screen-xl px-4 sm:px-8 z-10">
    
    {/* Centered hero — single column for maximum clarity */}
    <div class="max-w-3xl mx-auto text-center space-y-6">
      
      {/* Credibility & Announcement Pill */}
      <div class="inline-flex flex-wrap items-center justify-center gap-2 rounded-full border border-primary/30 bg-primary/8 px-4 py-1.5 text-xs font-bold text-primary backdrop-blur-sm shadow-sm">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
        </span>
        <span class="font-extrabold">135,000+ Websites & Apps Hosted</span>
        <span class="text-primary/40 hidden sm:inline">•</span>
        <span class="text-foreground font-semibold hidden sm:inline">Save up to 75%</span>
      </div>
      
      {/* Headline — transformation-focused */}
      <h1 class="font-extrabold tracking-tight text-4xl sm:text-5xl lg:text-6xl leading-[1.12] text-foreground">
        Your Website & AI Apps, 10× Faster —<br />
        <span class="bg-gradient-to-r from-primary via-blue-600 to-indigo-600 dark:from-blue-400 dark:via-indigo-400 dark:to-sky-400 bg-clip-text text-transparent">Starting Today.</span>
      </h1>
      
      {/* Subheadline — specific, outcome-driven with exact credibility figures */}
      <p class="text-base sm:text-lg text-muted-foreground leading-relaxed font-medium max-w-2xl mx-auto">
        Join over <strong>135,000+ websites and apps</strong> powered by HostingSpell. High-performance cloud and VPS infrastructure engineered for speed, AI deployments, and 24/7 human reliability.
      </p>

      {/* 3 Core Trust Badges Stack (11+ Years, 12+ Countries, 135k+ Sites) */}
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 max-w-2xl mx-auto pt-1">
        <div class="flex items-center justify-center gap-2 px-3.5 py-2 rounded-xl bg-card/80 dark:bg-zinc-900/80 border border-border/70 text-xs font-bold text-foreground shadow-sm">
          <Award className="w-4 h-4 text-amber-500 shrink-0" />
          <span>11+ Years Independently Owned</span>
        </div>

        <div class="flex items-center justify-center gap-2 px-3.5 py-2 rounded-xl bg-card/80 dark:bg-zinc-900/80 border border-border/70 text-xs font-bold text-foreground shadow-sm">
          <Globe2 className="w-4 h-4 text-blue-500 shrink-0" />
          <span>12+ Countries (4 Continents)</span>
        </div>

        <div class="flex items-center justify-center gap-2 px-3.5 py-2 rounded-xl bg-card/80 dark:bg-zinc-900/80 border border-border/70 text-xs font-bold text-foreground shadow-sm">
          <ShieldCheck className="w-4 h-4 text-emerald-500 shrink-0" />
          <span>135,000+ Active Sites & Apps</span>
        </div>
      </div>

      {/* Feature Checkpoints — outcome-framed */}
      <ul class="flex flex-col sm:flex-row items-center justify-center gap-x-6 gap-y-2 text-xs sm:text-sm font-semibold text-foreground pt-1">
        <li class="flex items-center gap-2">
          <div class="p-0.5 rounded-full bg-emerald-500/15 text-emerald-500">
            <Check className="w-3.5 h-3.5" />
          </div>
          <span>10× Faster LiteSpeed NVMe</span>
        </li>
        <li class="flex items-center gap-2">
          <div class="p-0.5 rounded-full bg-emerald-500/15 text-emerald-500">
            <Check className="w-3.5 h-3.5" />
          </div>
          <span>1-Click AI Apps & Web Builder</span>
        </li>
        <li class="flex items-center gap-2">
          <div class="p-0.5 rounded-full bg-emerald-500/15 text-emerald-500">
            <Check className="w-3.5 h-3.5" />
          </div>
          <span>Free Zero-Downtime Migration</span>
        </li>
      </ul>
      
      {/* CTAs */}
      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/pricing" class="w-full sm:w-auto">
          <Button size="lg" className="w-full sm:w-auto text-base h-13 px-8 rounded-xl bg-primary hover:bg-primary/90 text-white shadow-xl shadow-primary/25 font-bold flex items-center justify-center gap-2 cursor-pointer">
            <span>See Plans & Pricing</span>
            <ArrowRight className="w-4 h-4" />
          </Button>
        </a>
        <a href="#ai-hub" class="w-full sm:w-auto">
          <Button size="lg" variant="outline" className="w-full sm:w-auto text-sm h-13 px-6 rounded-xl border-border/80 text-foreground font-bold flex items-center justify-center gap-2 hover:bg-muted/50 transition-colors cursor-pointer">
            <Sparkles className="w-4 h-4 text-primary" />
            <span>Explore AI Tools</span>
          </Button>
        </a>
      </div>

      {/* Price Anchor */}
      <div class="flex flex-wrap items-center justify-center gap-2 text-xs font-medium text-muted-foreground pt-1">
        <StaticPrice usd="0.89" inr="69" prefix="Starting at " suffix="/mo" className="text-foreground font-bold" />
        <span>•</span>
        <span class="text-emerald-600 dark:text-emerald-400 font-semibold">30-Day Money-Back Guarantee</span>
        <span>•</span>
        <span class="text-foreground font-medium">Instant 60s Setup</span>
      </div>
    </div>

    {/* ─── Hero Domain Search (Competition Standard) ─── */}
    <div class="pt-10 sm:pt-14">
      <HeroDomainSearch client:load />
    </div>

  </div>
</section>
