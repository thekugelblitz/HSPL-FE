---
import { Star, ShieldCheck, CheckCircle2, Zap } from 'lucide-react';
---

<div class="border-y border-border/40 bg-zinc-950/80 backdrop-blur-2xl py-6 my-10">
  <div class="container mx-auto px-4 max-w-screen-xl">
    <div class="flex flex-wrap items-center justify-center lg:justify-between gap-6 lg:gap-8 text-xs font-bold text-foreground">
      
      {/* 1. Trustpilot */}
      <div class="flex items-center gap-3 whitespace-nowrap">
        <span class="font-extrabold uppercase tracking-wider text-xs">Trustpilot</span>
        <div class="flex items-center text-emerald-400 gap-0.5">
          {[1,2,3,4,5].map(() => (
            <Star class="w-3.5 h-3.5 fill-emerald-400 text-emerald-400" />
          ))}
        </div>
        <span class="text-xs font-extrabold text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20">4.9 / 5.0</span>
      </div>

      {/* 2. Google Reviews */}
      <div class="flex items-center gap-3 whitespace-nowrap">
        <span class="font-extrabold uppercase tracking-wider text-xs">Google</span>
        <div class="flex items-center text-amber-400 gap-0.5">
          {[1,2,3,4,5].map(() => (
            <Star class="w-3.5 h-3.5 fill-amber-400 text-amber-400" />
          ))}
        </div>
        <span class="text-xs font-extrabold text-amber-400 bg-amber-500/10 px-2.5 py-0.5 rounded-full border border-amber-500/20">4.8 / 5.0</span>
      </div>

      {/* 3. Active Clients */}
      <div class="flex items-center gap-2 whitespace-nowrap text-xs font-extrabold">
        <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
        <span>10,000+ Active Clients</span>
      </div>

      {/* 4. Uptime SLA */}
      <div class="flex items-center gap-2 whitespace-nowrap text-xs font-extrabold">
        <Zap class="w-4 h-4 text-blue-400 shrink-0" />
        <span>99.99% Uptime SLA</span>
      </div>

      {/* 5. Money-Back Guarantee */}
      <div class="flex items-center gap-2 whitespace-nowrap text-xs font-extrabold">
        <ShieldCheck class="w-4 h-4 text-purple-400 shrink-0" />
        <span>30-Day Money-Back</span>
      </div>

    </div>
  </div>
</div>
