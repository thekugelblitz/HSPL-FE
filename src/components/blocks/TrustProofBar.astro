---
---

<div class="w-full bg-slate-100 dark:bg-[#000000] text-slate-900 dark:text-white border-t border-b border-slate-200 dark:border-zinc-800/80 py-4 relative z-20">
  <div class="container mx-auto px-4 max-w-screen-2xl">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-4 lg:gap-6">
      
      {/* 5 Core Metrics */}
      <div class="flex flex-wrap lg:flex-nowrap items-center justify-center lg:justify-start gap-x-5 xl:gap-x-8 gap-y-2 text-xs sm:text-xs xl:text-sm">
        
        <div class="flex items-center gap-1.5 whitespace-nowrap">
          <span class="font-bold text-slate-900 dark:text-white">11+ Years</span>
          <span class="text-slate-600 dark:text-zinc-400 font-medium">Independently Owned</span>
        </div>

        <div class="flex items-center gap-1.5 whitespace-nowrap">
          <span class="font-bold text-slate-900 dark:text-white">135,000+</span>
          <span class="text-slate-600 dark:text-zinc-400 font-medium">Websites Hosted</span>
        </div>

        <div class="flex items-center gap-1.5 whitespace-nowrap">
          <span class="font-bold text-slate-900 dark:text-white">12+ Countries</span>
          <span class="text-slate-600 dark:text-zinc-400 font-medium">(4 Continents)</span>
        </div>

        <div class="flex items-center gap-1.5 whitespace-nowrap">
          <span class="font-bold text-slate-900 dark:text-white">24/7</span>
          <span class="text-slate-600 dark:text-zinc-400 font-medium">Expert Support</span>
        </div>

        <div class="flex items-center gap-1.5 whitespace-nowrap">
          <span class="font-bold text-blue-600 dark:text-blue-400">AI-Powered</span>
          <span class="text-slate-600 dark:text-zinc-400 font-medium">Ecosystem</span>
        </div>

      </div>

      {/* Single Vertical Divider Line (Desktop Only) */}
      <div class="hidden lg:block w-px h-5 bg-slate-300 dark:bg-zinc-700/80 shrink-0"></div>

      {/* Trustpilot & HostAdvice Rating */}
      <div class="flex items-center gap-2.5 whitespace-nowrap text-xs sm:text-xs xl:text-sm shrink-0">
        <div class="flex items-center gap-0.5 text-[#0073EC]">
          {/* 4 Full Solid Stars */}
          {[1, 2, 3, 4].map(() => (
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-[#0073EC] fill-[#0073EC] shrink-0" viewBox="0 0 24 24" fill="#0073EC" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
            </svg>
          ))}
          {/* 1 Half Star for 4.5 Rating */}
          <div class="relative w-3.5 h-3.5 sm:w-4 sm:h-4 shrink-0">
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-slate-300 dark:text-zinc-700 fill-slate-300 dark:fill-zinc-700 absolute inset-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
            </svg>
            <div class="absolute inset-0 overflow-hidden w-[50%]">
              <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-[#0073EC] fill-[#0073EC]" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
            </div>
          </div>
        </div>

        <div class="text-slate-900 dark:text-white">
          <span class="font-bold text-slate-900 dark:text-white">Rated 4.5</span>
          <span class="text-slate-600 dark:text-zinc-400 font-medium"> out of 5 on Trustpilot & HostAdvice</span>
        </div>
      </div>

    </div>
  </div>
</div>
