<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabsContainer = document.getElementById('usecase-tabs');
    if (!tabsContainer) return;
    
    const tabButtons = tabsContainer.querySelectorAll('.usecase-tab-btn');
    const panels = {
      'creators': document.getElementById('tab-panel-creators'),
      'business': document.getElementById('tab-panel-business'),
      'agencies': document.getElementById('tab-panel-agencies')
    };

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');
        
        // Update button styles
        tabButtons.forEach(b => {
          b.classList.remove('bg-[#0073EC]', 'text-white', 'shadow-md', 'shadow-blue-500/20', 'scale-[1.02]');
          b.classList.add('text-muted-foreground');
        });
        btn.classList.add('bg-[#0073EC]', 'text-white', 'shadow-md', 'shadow-blue-500/20', 'scale-[1.02]');
        btn.classList.remove('text-muted-foreground');

        // Toggle panels
        Object.entries(panels).forEach(([key, panel]) => {
          if (panel) {
            if (key === targetTab) {
              panel.classList.remove('hidden');
              panel.classList.add('block');
            } else {
              panel.classList.add('hidden');
              panel.classList.remove('block');
            }
          }
        });
      });
    });
  });
</script>
