---
// src/components/blocks/SocialProofBar.astro
// Minimal trust strip — 135,000+ Sites, 11+ Years, 12+ Countries, 99.99% SLA
// Psychology rules: #10 (testimonials), #15 (be specific), #25 (proof)
import { AnimatedCounter } from '../ui/AnimatedCounter';
---

<section class="py-10 border-b border-border/40 bg-muted/20">
  <div class="container mx-auto px-4 max-w-screen-xl">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 text-center">
      
      {/* 135,000+ Sites */}
      <div class="space-y-1">
        <div class="text-2xl sm:text-3xl font-black text-foreground tabular-nums">
          <AnimatedCounter client:visible value={135000} suffix="+" />
        </div>
        <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Websites & Apps Hosted</p>
      </div>

      {/* 11+ Years */}
      <div class="space-y-1">
        <div class="text-2xl sm:text-3xl font-black text-foreground tabular-nums">
          <AnimatedCounter client:visible value={11} suffix="+ Years" />
        </div>
        <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Independently Owned</p>
      </div>

      {/* 12+ Countries */}
      <div class="space-y-1">
        <div class="text-2xl sm:text-3xl font-black text-foreground tabular-nums">
          <AnimatedCounter client:visible value={12} suffix="+ Countries" />
        </div>
        <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Across 4 Continents</p>
      </div>

      {/* 100% Uptime Mark & Rating */}
      <div class="space-y-1">
        <div class="text-2xl sm:text-3xl font-black text-emerald-500 tabular-nums flex items-center justify-center gap-1.5">
          <span>100%</span>
          <span class="text-xs font-bold text-amber-500 bg-amber-500/10 px-2 py-0.5 rounded-md border border-amber-500/20">★ 4.9</span>
        </div>
        <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Uptime Mark</p>
      </div>

    </div>
  </div>
</section>
