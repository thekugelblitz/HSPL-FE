---
// src/components/blocks/ClientShowcaseMarquee.astro
// Streamlined, transparent horizontal client logo marquee without background boxes, enlarged typography and icons
const clientLogos = [
  {
    name: "Bookflow",
    url: "https://bookflow.in",
    image: "/showcase/bookflow.png"
  },
  {
    name: "Love.com",
    url: "https://love.com",
    image: "/showcase/lovecom.png"
  },
  {
    name: "Digicloudify",
    url: "https://digicloudify.com",
    image: "/showcase/digicloudify.png"
  },
  {
    name: "PlanckStudio",
    url: "https://planckstudio.in",
    image: "/showcase/planckstudio.png"
  },
  {
    name: "RPJ Hotel",
    url: "https://rpjhotels.com",
    image: "/showcase/rpjhotel.png"
  },
  {
    name: "Zorba Stays",
    url: "https://zorbastays.com",
    image: "/showcase/zorbastays.png"
  },
  {
    name: "Pinkal IT Solutions",
    url: "https://pinkalitsolutions.com",
    image: "/showcase/pinkal.png"
  },
  {
    name: "Trans Globe",
    url: "https://transglobeedu.com",
    image: "/showcase/transglobe.png"
  }
];

// Duplicate for continuous seamless infinite loop
const marqueeLogos = [...clientLogos, ...clientLogos, ...clientLogos];
---

<section class="py-14 sm:py-16 md:py-20 bg-background border-b border-border/40 overflow-hidden relative">
  {/* Header */}
  <div class="container mx-auto px-4 max-w-screen-xl text-center mb-8 sm:mb-10">
    <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold tracking-tight text-foreground/90">
      Serving <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-blue-500 to-indigo-500">Billion+ visitors</span> for industry leaders.
    </h2>
  </div>

  {/* Streamlined Transparent Moving Client Logo Marquee */}
  <div class="relative w-full overflow-hidden">
    {/* Left & Right Subtle Fade Masks */}
    <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-20 sm:w-44 z-20 bg-gradient-to-r from-background to-transparent"></div>
    <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-20 sm:w-44 z-20 bg-gradient-to-l from-background to-transparent"></div>

    <div class="animate-marquee flex items-center gap-12 sm:gap-16 md:gap-20 py-3">
      {marqueeLogos.map((client) => (
        <a
          href={client.url}
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 transition-all duration-300 flex items-center gap-3 sm:gap-3.5 group"
          title={client.name}
        >
          {/* Direct transparent logo icon without background container */}
          <img 
            src={client.image} 
            alt={client.name} 
            class="h-8 sm:h-9 md:h-10 w-auto max-w-[46px] sm:max-w-[54px] object-contain grayscale opacity-75 group-hover:grayscale-0 group-hover:opacity-100 dark:brightness-0 dark:invert dark:opacity-85 dark:group-hover:opacity-100 transition-all duration-300 group-hover:scale-105" 
            loading="lazy"
            decoding="async"
          />
          {/* Enlarged bold company name */}
          <span class="text-base sm:text-lg md:text-xl font-bold tracking-tight text-foreground/80 group-hover:text-foreground transition-colors whitespace-nowrap">
            {client.name}
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
