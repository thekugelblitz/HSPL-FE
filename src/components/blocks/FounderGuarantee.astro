---
import { Button } from "@/components/ui/button";
import { ShieldCheck, ArrowRight } from "lucide-react";
---

<section class="py-16 relative overflow-hidden">
  <div class="container mx-auto px-4 max-w-screen-xl">
    <div class="glass-card rounded-3xl p-8 sm:p-12 border border-border/80 glow-card shadow-2xl relative overflow-hidden bg-card/90 backdrop-blur-xl">
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        
        {/* Left Side - Sleek Vector 30-Day Money Back Guarantee Badge */}
        <div class="lg:col-span-4 flex flex-col items-center justify-center text-center p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-emerald-500/10 via-emerald-500/5 to-transparent border border-emerald-500/20 relative group">
          <div class="relative w-44 h-44 flex items-center justify-center">
            {/* Ambient Glow */}
            <div class="absolute inset-0 bg-emerald-500/20 rounded-full blur-2xl group-hover:bg-emerald-500/30 transition-all duration-500"></div>
            
            {/* Vector Seal Badge */}
            <svg viewBox="0 0 200 200" class="w-40 h-40 drop-shadow-2xl relative z-10">
              <defs>
                <linearGradient id="sealGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#10B981" />
                  <stop offset="50%" stop-color="#059669" />
                  <stop offset="100%" stop-color="#047857" />
                </linearGradient>
                <linearGradient id="ribbonGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#047857" />
                  <stop offset="50%" stop-color="#10B981" />
                  <stop offset="100%" stop-color="#047857" />
                </linearGradient>
                <filter id="badgeShadow" x="-20%" y="-20%" width="140%" height="140%">
                  <feDropShadow dx="0" dy="4" stdDeviation="5" flood-opacity="0.3"/>
                </filter>
              </defs>

              <!-- Outer Dashed Orbit Ring -->
              <circle cx="100" cy="100" r="92" fill="none" stroke="#10B981" stroke-width="2" stroke-dasharray="6 4" opacity="0.4" />
              
              <!-- Main Seal Circle -->
              <circle cx="100" cy="100" r="78" fill="url(#sealGrad)" filter="url(#badgeShadow)" />
              <circle cx="100" cy="100" r="70" fill="none" stroke="#FFFFFF" stroke-width="1.5" opacity="0.35" stroke-dasharray="4 3" />

              <!-- Top Text: 30 DAY -->
              <text x="100" y="64" text-anchor="middle" fill="#FFFFFF" font-size="15" font-weight="900" letter-spacing="1">30 DAY</text>

              <!-- Ribbon Banner Across Center -->
              <g filter="url(#badgeShadow)">
                <rect x="20" y="88" width="160" height="28" rx="6" fill="url(#ribbonGrad)" stroke="#34D399" stroke-width="1.2" />
                <text x="100" y="106" text-anchor="middle" fill="#FFFFFF" font-size="10.5" font-weight="900" letter-spacing="0.5">MONEY-BACK GUARANTEE</text>
              </g>

              <!-- Bottom 3 Stars & Risk Free Label -->
              <text x="100" y="135" text-anchor="middle" fill="#FBBF24" font-size="12" letter-spacing="2">★ ★ ★</text>
              <text x="100" y="152" text-anchor="middle" fill="#A7F3D0" font-size="8.5" font-weight="800" letter-spacing="1.5">100% RISK-FREE</text>
            </svg>
          </div>

          <span class="mt-2 text-xs font-extrabold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3.5 py-1 rounded-full shadow-sm">
            100% Risk-Free Hosting
          </span>
        </div>

        {/* Right Side - Copy, Signature, Founder Info & CTA */}
        <div class="lg:col-span-8 space-y-6">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-3">
              <ShieldCheck class="w-3.5 h-3.5" /> Direct Founder Guarantee
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
              30-Day Money-Back Guarantee
            </h2>
          </div>

          <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
            We want you to love your hosting experience! Join our community 100% risk-free — if the industry's most affordable yet feature-packed web hosting and elite 24/7 support wizards don't deliver pure magic and 5-star support, simply <a href="/refund" class="text-primary font-bold underline underline-offset-4 hover:text-primary/80 transition-colors">request a refund</a> — we'll process it promptly with <span class="text-foreground font-semibold">zero hassle, no drama, and no catch!</span>
          </p>

          {/* Signature Image */}
          <div class="pt-1.5 pb-2">
            <img 
              src="/dhruv-signature.png" 
              alt="Dhruv Joshi Signature" 
              class="h-16 sm:h-18 md:h-20 w-auto object-contain dark:invert dark:brightness-200 opacity-95 transition-all drop-shadow-sm" 
            />
          </div>

          {/* Founder Profile Details & LinkedIn */}
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pt-2 border-t border-border/50">
            <div class="flex items-center gap-3.5">
              <img 
                src="/dhruv-joshi.jpg" 
                alt="Dhruv Joshi" 
                class="w-12 h-12 rounded-full object-cover border-2 border-primary/40 shadow-md ring-2 ring-primary/10" 
              />
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-extrabold text-base text-foreground">Dhruv Joshi</span>
                  <a 
                    href="https://www.linkedin.com/in/thedhruval/" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    title="Connect with Dhruv Joshi on LinkedIn"
                    class="text-[#0A66C2] hover:opacity-80 transition-opacity p-0.5 rounded"
                  >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                      <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
                    </svg>
                  </a>
                </div>
                <div class="text-xs text-muted-foreground font-medium">Founder & Director, HostingSpell LLP.</div>
              </div>
            </div>

            <a href="/pricing">
              <Button size="lg" className="h-12 px-7 text-sm font-extrabold rounded-xl bg-primary hover:bg-primary/90 text-primary-foreground shadow-xl shadow-primary/20 flex items-center gap-2">
                <span>Start / No-Stress</span>
                <ArrowRight class="w-4 h-4" />
              </Button>
            </a>
          </div>

        </div>

      </div>
    </div>
  </div>
</section>
