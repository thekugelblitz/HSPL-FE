---
// src/components/blocks/AiDemocratizationSection.astro
// AI Democratization & 1-Click AI App Deployment Hub for Homepage
// Highlights:
// 1. AI Website Studio (build & launch websites in 60s with conversational AI)
// 2. 1-Click AI Apps Stack (Host Open WebUI, Ollama, Supabase, n8n, Flowise, Dify on NVMe VPS)
import { Sparkles, Bot, Terminal, Cpu, Wand2, Zap, ArrowRight, CheckCircle2, Server, Database } from 'lucide-react';
---

<section class="py-24 border-y border-border/60 bg-gradient-to-b from-background via-muted/20 to-background relative overflow-hidden" id="ai-hub">
  {/* Ambient AI Glow */}
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-primary/10 rounded-full blur-[140px] pointer-events-none"></div>
  
  <div class="container relative mx-auto max-w-screen-xl px-4 sm:px-8 z-10">
    
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/10 border border-primary/25 text-primary text-xs font-black uppercase tracking-widest mb-4 backdrop-blur-md">
        <Sparkles className="w-3.5 h-3.5 text-primary animate-pulse" />
        <span>AI Democratization Platform</span>
      </div>

      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-[1.15] mb-5 text-foreground">
        Deploy AI Apps & Launch Websites <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-primary via-blue-600 to-indigo-600 dark:from-blue-400 dark:via-indigo-400 dark:to-sky-400 bg-clip-text text-transparent">In Under 60 Seconds.</span>
      </h2>

      <p class="text-muted-foreground text-base sm:text-lg leading-relaxed font-medium">
        We make artificial intelligence accessible for everyone — from 1-prompt automated website generation to 1-click private LLM & agent deployments on ultra-fast NVMe cloud.
      </p>
    </div>

    {/* Dual-Pillar AI Experience Grid */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch max-w-6xl mx-auto">
      
      {/* Pillar 1: AI Website Builder (Left 6 cols) */}
      <div class="lg:col-span-6 rounded-3xl border border-border/80 bg-card/90 dark:bg-zinc-950/80 p-7 sm:p-8 flex flex-col justify-between relative overflow-hidden group hover:border-primary/50 transition-all shadow-xl">
        <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-blue-500 via-primary to-indigo-500"></div>

        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="p-3 bg-primary/15 text-primary rounded-2xl">
              <Wand2 className="w-6 h-6" />
            </div>
            <span class="text-[10px] font-black uppercase tracking-wider bg-primary/10 text-primary border border-primary/20 px-3 py-1 rounded-full">
              NO-CODE TO CLOUD
            </span>
          </div>

          <h3 class="text-2xl font-extrabold text-foreground mb-2.5">
            Conversational AI Website Studio
          </h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-6 font-medium">
            Describe your project in plain English. Our autonomous web AI builds semantic HTML5, modern Tailwind CSS, mobile-responsive layouts, and high-converting copy in seconds.
          </p>

          {/* Interactive Simulated Prompt Box */}
          <div class="p-4 rounded-2xl bg-muted/40 dark:bg-zinc-900 border border-border/60 mb-6 space-y-2.5 text-xs font-mono">
            <div class="flex items-center gap-2 text-muted-foreground text-[11px]">
              <Bot className="w-3.5 h-3.5 text-primary" />
              <span>Prompt Example:</span>
            </div>
            <p class="text-foreground font-sans font-medium text-xs bg-background/80 p-2.5 rounded-xl border border-border/40">
              "Create a sleek dark-mode portfolio for an AI studio with interactive pricing and client booking form."
            </p>
            <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-sans font-bold text-[11px] pt-1">
              <CheckCircle2 className="w-3.5 h-3.5 shrink-0" />
              <span>Generated, SEO-optimized & deployed to NVMe Cloud in 28s</span>
            </div>
          </div>

          <ul class="space-y-2.5 text-xs font-semibold text-foreground mb-8">
            <li class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-500 shrink-0" />
              <span>One-prompt full website drafting with live preview</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-500 shrink-0" />
              <span>Keep chatting to adjust colors, sections, and copywriting</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-500 shrink-0" />
              <span>100/100 Google Lighthouse and Core Web Vitals score</span>
            </li>
          </ul>
        </div>

        <a href="/ai-website-builder" class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-xl bg-primary hover:bg-primary/90 text-white font-extrabold text-sm shadow-lg shadow-primary/25 transition-all">
          <Sparkles className="w-4 h-4" />
          <span>Launch AI Website Studio</span>
          <ArrowRight className="w-4 h-4" />
        </a>
      </div>

      {/* Pillar 2: 1-Click AI Apps Stack (Right 6 cols) */}
      <div class="lg:col-span-6 rounded-3xl border border-border/80 bg-card/90 dark:bg-zinc-950/80 p-7 sm:p-8 flex flex-col justify-between relative overflow-hidden group hover:border-purple-500/50 transition-all shadow-xl">
        <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-purple-500 via-indigo-500 to-primary"></div>

        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="p-3 bg-purple-500/15 text-purple-600 dark:text-purple-400 rounded-2xl">
              <Terminal className="w-6 h-6" />
            </div>
            <span class="text-[10px] font-black uppercase tracking-wider bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20 px-3 py-1 rounded-full">
              39+ APPS • ZERO SETUP
            </span>
          </div>

          <h3 class="text-2xl font-extrabold text-foreground mb-2.5">
            1-Click AI App & Agent Deployments
          </h3>
          <p class="text-sm text-muted-foreground leading-relaxed mb-6 font-medium">
            Run your own private LLMs, AI agents, automated workflows, and developer backends on dedicated KVM VPS infrastructure with isolated CPU and pure NVMe speed.
          </p>

          {/* AI Apps Quick Showcase Badges */}
          <div class="grid grid-cols-2 gap-2.5 mb-6">
            <div class="p-2.5 rounded-xl bg-muted/40 dark:bg-zinc-900 border border-border/60 flex items-center gap-2.5">
              <div class="w-7 h-7 rounded-lg bg-blue-500/15 text-blue-500 font-black text-xs flex items-center justify-center shrink-0">UI</div>
              <div class="min-w-0">
                <div class="text-xs font-bold text-foreground truncate">Open WebUI</div>
                <div class="text-[10px] text-muted-foreground truncate">Private ChatGPT Web UI</div>
              </div>
            </div>

            <div class="p-2.5 rounded-xl bg-muted/40 dark:bg-zinc-900 border border-border/60 flex items-center gap-2.5">
              <div class="w-7 h-7 rounded-lg bg-purple-500/15 text-purple-500 font-black text-xs flex items-center justify-center shrink-0">⚡</div>
              <div class="min-w-0">
                <div class="text-xs font-bold text-foreground truncate">Ollama LLM</div>
                <div class="text-[10px] text-muted-foreground truncate">Llama 3.3, Mistral, DeepSeek</div>
              </div>
            </div>

            <div class="p-2.5 rounded-xl bg-muted/40 dark:bg-zinc-900 border border-border/60 flex items-center gap-2.5">
              <div class="w-7 h-7 rounded-lg bg-emerald-500/15 text-emerald-500 font-black text-xs flex items-center justify-center shrink-0">n8n</div>
              <div class="min-w-0">
                <div class="text-xs font-bold text-foreground truncate">n8n Automation</div>
                <div class="text-[10px] text-muted-foreground truncate">Autonomous AI Workflows</div>
              </div>
            </div>

            <div class="p-2.5 rounded-xl bg-muted/40 dark:bg-zinc-900 border border-border/60 flex items-center gap-2.5">
              <div class="w-7 h-7 rounded-lg bg-amber-500/15 text-amber-500 font-black text-xs flex items-center justify-center shrink-0">DB</div>
              <div class="min-w-0">
                <div class="text-xs font-bold text-foreground truncate">Supabase / Dokploy</div>
                <div class="text-[10px] text-muted-foreground truncate">Vector DB & PaaS Stack</div>
              </div>
            </div>
          </div>

          <ul class="space-y-2.5 text-xs font-semibold text-foreground mb-8">
            <li class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-500 shrink-0" />
              <span>Full root SSH control + automated Virtualizor installer</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-500 shrink-0" />
              <span>Zero external token costs — run private models with 100% privacy</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-500 shrink-0" />
              <span>Dedicated KVM resources from $10/mo with instant setup</span>
            </li>
          </ul>
        </div>

        <a href="/vps/apps" class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-xl bg-zinc-900 dark:bg-zinc-800 hover:bg-zinc-800 dark:hover:bg-zinc-700 text-white font-extrabold text-sm border border-zinc-700 transition-all">
          <Terminal className="w-4 h-4 text-purple-400" />
          <span>Explore 39+ 1-Click Apps & Stacks</span>
          <ArrowRight className="w-4 h-4" />
        </a>
      </div>

    </div>

  </div>
</section>
