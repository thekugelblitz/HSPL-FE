---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import TrustProofBar from '../components/blocks/TrustProofBar.astro';
import MigrationBanner from '../components/blocks/MigrationBanner.astro';
import { Star, MessageSquare, ShieldCheck, Quote, CheckCircle2 } from 'lucide-react';

const reviews = [
  {
    name: "Alex Rivera",
    company: "SaaSify Inc.",
    role: "Lead DevOps Architect",
    category: "SaaS & Devs",
    text: "Migrated 40+ client sites from cPanel VPS to HostingSpell NVMe Cloud. Average TTFB dropped from 650ms to 92ms. The speed difference is astounding! Zero downtime during migration."
  },
  {
    name: "Sarah Jenkins",
    company: "Lumiere Goods",
    role: "E-Commerce Founder",
    category: "E-Commerce",
    text: "Our WooCommerce store processed 15,000 orders during Black Friday with zero slowdowns. The LiteSpeed cache handled flash spikes seamlessly and support migrated us for free."
  },
  {
    name: "Devon Chen",
    company: "Vortex Digital",
    role: "Senior Full-Stack Developer",
    category: "SaaS & Devs",
    text: "The AI Web Builder + Node.js hosting stack allowed us to launch our SaaS MVP in a single weekend. The instant preview features and automatic SSL renewal make it a joy to use."
  },
  {
    name: "Marcus Thorne",
    company: "Thorne Design Agency",
    role: "Agency Founder",
    category: "Agencies",
    text: "Managing 80+ cPanel client accounts through WHM Reseller Hosting on HostingSpell has been rock solid. Unlimited SSL, automatic backups, and 24/7 Tier-3 support."
  },
  {
    name: "Elena Rostova",
    company: "TechPulse Blog",
    role: "WordPress Architect",
    category: "WordPress",
    text: "Switched from a high-cost legacy host to HostingSpell Managed WordPress. Our Core Web Vitals scores hit 100/100 on Google PageSpeed Insights immediately."
  },
  {
    name: "David Sterling",
    company: "Quantum Analytics",
    role: "CTO & Co-Founder",
    category: "SaaS & Devs",
    text: "The Bare-Metal Dedicated Server with Dual AMD EPYC 9654 processors gives us unmatched IOPS for heavy database processing at half the cost of AWS EC2."
  }
];

const platformRatings = [
  { platform: "Trustpilot", rating: "4.8 / 5.0", reviewsCount: "1,420+ Verified Reviews", badge: "Excellent" },
  { platform: "HostAdvice", rating: "4.9 / 5.0", reviewsCount: "Top 10 Reseller Host Award", badge: "Badge Winner" },
  { platform: "G2 Crowd", rating: "4.7 / 5.0", reviewsCount: "High Performer 2026", badge: "Leader" }
];
---

<Layout 
  title="Customer Reviews & Wall of Love | HostingSpell Customer Ratings" 
  description="Read 1,400+ verified customer reviews from developers, agency owners, and e-commerce founders. Rated 4.8/5 on Trustpilot and 4.9/5 on HostAdvice."
>
  <Navbar />

  <main class="flex-1 bg-[#000000] text-white">
    
    {/* Hero Section */}
    <section class="relative py-24 bg-[#000000] text-center border-b border-zinc-800/80 overflow-hidden">
      <div class="absolute inset-0 bg-amber-500/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
      
      <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs sm:text-sm font-extrabold uppercase tracking-wider mb-6">
          <Star class="w-4 h-4 fill-amber-400" />
          <span>Wall of Love • Rated 4.8 / 5.0</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight mb-6 leading-tight">
          Loved by 135,000+ <br />
          <span class="bg-gradient-to-r from-amber-300 via-yellow-400 to-amber-200 bg-clip-text text-transparent">Creators, Developers & Agencies.</span>
        </h1>

        <p class="text-zinc-300 text-base sm:text-lg max-w-3xl mx-auto leading-relaxed font-medium">
          Discover why web agency leaders, SaaS builders, and store owners trust HostingSpell for zero-downtime NVMe cloud performance and 24/7 human support.
        </p>
      </div>
    </section>

    <TrustProofBar />

    {/* Third-Party Platform Ratings Grid */}
    <section class="py-20 bg-[#000000]">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {platformRatings.map(pr => (
            <div class="p-8 rounded-3xl bg-zinc-950 border border-zinc-800 text-center space-y-3">
              <div class="text-xs font-bold text-amber-400 bg-amber-500/10 px-3 py-1 rounded-full border border-amber-500/20 w-fit mx-auto">
                {pr.badge}
              </div>
              <h3 class="text-2xl font-extrabold text-white">{pr.platform}</h3>
              <div class="text-3xl font-black text-amber-400">{pr.rating}</div>
              <p class="text-xs text-zinc-400 font-medium">{pr.reviewsCount}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Customer Reviews Grid */}
    <section class="py-24 bg-[#000000] border-t border-zinc-800/80">
      <div class="container mx-auto px-4 max-w-screen-xl space-y-16">
        
        <div class="text-center max-w-3xl mx-auto space-y-4">
          <h2 class="text-3xl sm:text-5xl font-extrabold text-white">Verified Customer Stories</h2>
          <p class="text-zinc-400 text-base font-medium">Real feedback from real engineers, agency owners, and store founders.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {reviews.map(r => (
            <div class="p-8 rounded-3xl bg-zinc-950 border border-zinc-800 space-y-5 flex flex-col justify-between relative">
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-black uppercase tracking-wider text-blue-400 bg-blue-500/10 px-2.5 py-0.5 rounded-md border border-blue-500/20">
                    {r.category}
                  </span>
                  <div class="flex text-amber-400 text-xs">★★★★★</div>
                </div>

                <Quote class="w-8 h-8 text-blue-500/20" />
                <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed font-medium">"{r.text}"</p>
              </div>

              <div class="pt-4 border-t border-zinc-800/80 flex items-center justify-between">
                <div>
                  <div class="font-extrabold text-white text-sm">{r.name}</div>
                  <div class="text-xs text-zinc-400 font-medium">{r.role} • <span class="text-zinc-300 font-bold">{r.company}</span></div>
                </div>
                <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" title="Verified Customer" />
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <MigrationBanner />

  </main>

  <Footer />
</Layout>
