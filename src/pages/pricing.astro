---
// src/pages/pricing.astro
// Pricing page — guided decision, not a spreadsheet
// Tabbed categories with max plans each, quiz at top, value stack, guarantee badges

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import FounderGuarantee from '../components/blocks/FounderGuarantee.astro';
import FaqAccordion from '../components/blocks/FaqAccordion.astro';
import ValueStack from '../components/blocks/ValueStack.astro';
import RenewalGuaranteeBadge from '../components/blocks/RenewalGuaranteeBadge.astro';
import ExitIntentModal from '../components/blocks/ExitIntentModal.astro';
import { HostingQuizModal } from '../components/blocks/HostingQuizModal';
import { SavingsCalculator } from '../components/blocks/SavingsCalculator';
import { InteractivePricingGrid } from '../components/pricing/InteractivePricingGrid';
import { StickyMobileBuyBar } from '../components/blocks/StickyMobileBuyBar';
import { PLANS_CLOUD_HOSTING } from '../lib/pricing/cloudPlans';
import { PLANS_PREMIUM_HOSTING } from '../lib/pricing/premiumPlans';
import { PLANS_VPS_HOSTING } from '../lib/pricing/vpsPlans';
import { PLANS_RESELLER_HOSTING } from '../lib/pricing/resellerPlans';
import { PLANS_WEBUZO_HOSTING } from '../lib/pricing/webuzoPlans';
import { PLANS_WEBUZO_RESELLER } from '../lib/pricing/webuzoResellerPlans';
import {
  CLOUD_PROVIDER_LOCATIONS,
  PREMIUM_PROVIDER_LOCATIONS,
  VPS_PROVIDER_LOCATIONS,
  RESELLER_PROVIDER_LOCATIONS,
  WEBUZO_PROVIDER_LOCATIONS,
  GLOBAL_BILLING_CYCLES
} from '../lib/pricing/constants';
import { faqs } from '../lib/data';
import { Check, ArrowRight, Shield } from 'lucide-react';

// Pricing-specific FAQs (top 5)
const pricingFaqs = faqs.slice(0, 5);
---

<Layout 
  title="Pricing Plans | HostingSpell — Transparent, No Hidden Fees"
  description="Compare all hosting plans with transparent pricing. Cloud NVMe, Premium cPanel, KVM VPS, Reseller, and Webuzo hosting. 30-day money-back guarantee."
>
  <Navbar />
  <main class="flex-1 bg-background overflow-hidden">

    {/* ─── Hero: Simple, Honest, Confident ─── */}
    <section class="relative bg-background pt-16 pb-16 border-b border-border/40 overflow-hidden">
      <div class="absolute left-1/2 top-0 -translate-x-1/2 w-[700px] h-[350px] bg-primary/15 rounded-full blur-[120px] pointer-events-none"></div>
      
      <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
        <div class="max-w-2xl mx-auto text-center space-y-5">
          <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-primary">
            <span class="flex h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Transparent Pricing
          </div>

          <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-[1.1]">
            Simple, Honest Pricing.<br />
            <span class="text-gradient-primary">Zero Hidden Fees.</span>
          </h1>

          <p class="text-base text-muted-foreground font-medium max-w-lg mx-auto">
            Every plan includes 30-day money-back guarantee, free migration, and 24/7 human support.
          </p>

          <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs font-semibold text-foreground">
            <li class="flex items-center gap-1.5">
              <Check className="w-3.5 h-3.5 text-emerald-500" />
              <span>30-Day Money-Back</span>
            </li>
            <li class="flex items-center gap-1.5">
              <Check className="w-3.5 h-3.5 text-emerald-500" />
              <span>Free Migration</span>
            </li>
            <li class="flex items-center gap-1.5">
              <Check className="w-3.5 h-3.5 text-emerald-500" />
              <span>24/7 Human Support</span>
            </li>
          </ul>

          {/* Plan Recommender Quiz — moved from homepage hero */}
          <div class="pt-2">
            <HostingQuizModal client:visible />
          </div>
        </div>
      </div>
    </section>

    {/* ─── Value Stack ─── */}
    <section class="py-6 bg-muted/20 border-b border-border/40">
      <div class="container mx-auto px-4 max-w-screen-lg">
        <ValueStack />
      </div>
    </section>

    {/* ─── Tabbed Pricing Categories ─── */}
    <section class="py-16" id="plans">
      <div class="container mx-auto px-4 max-w-screen-xl">

        {/* Tab Navigation */}
        <div class="flex flex-wrap justify-center gap-2 mb-12 border-b border-border/40 pb-4" id="pricing-tabs">
          <a href="#web-hosting" class="pricing-tab active px-5 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider transition-colors bg-primary text-white" data-tab="web-hosting">
            Web Hosting
          </a>
          <a href="#premium-hosting" class="pricing-tab px-5 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider transition-colors bg-muted/50 text-muted-foreground hover:bg-muted" data-tab="premium-hosting">
            Premium
          </a>
          <a href="#vps-servers" class="pricing-tab px-5 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider transition-colors bg-muted/50 text-muted-foreground hover:bg-muted" data-tab="vps-servers">
            VPS & Dedicated
          </a>
          <a href="#reseller" class="pricing-tab px-5 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider transition-colors bg-muted/50 text-muted-foreground hover:bg-muted" data-tab="reseller">
            Reseller
          </a>
        </div>

        {/* Tab Content Panels */}
        <div class="space-y-20">

          {/* Web Hosting (Cloud + Webuzo combined) */}
          <div id="web-hosting" class="pricing-panel">
            <div class="mb-8">
              <h2 class="text-2xl font-bold mb-1">Cloud NVMe Web Hosting</h2>
              <p class="text-sm text-muted-foreground">LiteSpeed Enterprise + NVMe SSDs + cPanel. Perfect for blogs, portfolios, and business websites.</p>
            </div>
            <InteractivePricingGrid
              client:load
              plans={PLANS_CLOUD_HOSTING}
              locations={CLOUD_PROVIDER_LOCATIONS}
              billingCycles={GLOBAL_BILLING_CYCLES.cloudhosting}
            />

            <details class="mt-10 group">
              <summary class="cursor-pointer text-sm font-semibold text-primary flex items-center gap-2 hover:underline">
                <span>Also available: Webuzo Hosting (Apache/Nginx alternative — from $0.89/mo)</span>
                <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="mt-6">
                <InteractivePricingGrid
                  client:load
                  plans={PLANS_WEBUZO_HOSTING}
                  locations={WEBUZO_PROVIDER_LOCATIONS}
                  billingCycles={GLOBAL_BILLING_CYCLES.webuzohosting}
                />
              </div>
            </details>
          </div>

          {/* Premium Hosting */}
          <div id="premium-hosting" class="pricing-panel">
            <div class="mb-8">
              <h2 class="text-2xl font-bold mb-1">Premium cPanel Hosting</h2>
              <p class="text-sm text-muted-foreground">Dedicated CPU & RAM on DigitalOcean & Linode infrastructure. For high-traffic stores and apps.</p>
            </div>
            <InteractivePricingGrid
              client:load
              plans={PLANS_PREMIUM_HOSTING}
              locations={PREMIUM_PROVIDER_LOCATIONS}
              billingCycles={GLOBAL_BILLING_CYCLES.premiumhosting}
            />
          </div>

          {/* VPS & Dedicated */}
          <div id="vps-servers" class="pricing-panel">
            <div class="mb-8">
              <h2 class="text-2xl font-bold mb-1">KVM VPS Servers</h2>
              <p class="text-sm text-muted-foreground">Isolated KVM hypervisors with full root SSH access, Virtualizor panel, and 1-click apps.</p>
            </div>
            <InteractivePricingGrid
              client:load
              plans={PLANS_VPS_HOSTING}
              locations={VPS_PROVIDER_LOCATIONS}
              billingCycles={GLOBAL_BILLING_CYCLES.vpshosting}
            />
            <div class="mt-6 text-center">
              <a href="/dedicated-servers" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline">
                Need bare-metal? View Dedicated Servers →
              </a>
            </div>
          </div>

          {/* Reseller */}
          <div id="reseller" class="pricing-panel">
            <div class="mb-8">
              <h2 class="text-2xl font-bold mb-1">Reseller Hosting</h2>
              <p class="text-sm text-muted-foreground">Launch your hosting business. White-label WHM/cPanel with your own branding.</p>
            </div>
            <InteractivePricingGrid
              client:load
              plans={PLANS_RESELLER_HOSTING}
              locations={RESELLER_PROVIDER_LOCATIONS}
              billingCycles={GLOBAL_BILLING_CYCLES.resellerhosting}
            />

            <details class="mt-10 group">
              <summary class="cursor-pointer text-sm font-semibold text-primary flex items-center gap-2 hover:underline">
                <span>Also available: Webuzo Reseller (25% cheaper — from $9.99/mo)</span>
                <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="mt-6">
                <InteractivePricingGrid
                  client:load
                  plans={PLANS_WEBUZO_RESELLER}
                  locations={WEBUZO_PROVIDER_LOCATIONS}
                  billingCycles={GLOBAL_BILLING_CYCLES.webuzoreseller}
                />
              </div>
            </details>
          </div>

        </div>
      </div>
    </section>

    {/* ─── Renewal Guarantee ─── */}
    <section class="py-6 border-t border-border/40">
      <div class="container mx-auto px-4 max-w-screen-md">
        <RenewalGuaranteeBadge />
      </div>
    </section>

    {/* ─── Savings Calculator ─── */}
    <section class="py-16 border-t border-border/40 bg-muted/10">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <SavingsCalculator client:visible />
      </div>
    </section>

    {/* ─── Guarantee ─── */}
    <FounderGuarantee />

    {/* ─── Pricing FAQ ─── */}
    <section class="py-20 border-t border-border/40">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl font-extrabold tracking-tight mb-3">Pricing Questions</h2>
          <p class="text-muted-foreground">Common questions about billing, refunds, and plan upgrades.</p>
        </div>
        <div class="max-w-3xl mx-auto">
          <FaqAccordion faqs={pricingFaqs} />
        </div>
      </div>
    </section>

    {/* ─── Contextual CRO: exit intent + sticky mobile bar on pricing ─── */}
    <ExitIntentModal />
    <StickyMobileBuyBar client:media="(max-width: 768px)" />
  </main>
  <Footer />
</Layout>

<script>
  // Simple tab switching for pricing categories
  document.addEventListener('astro:page-load', () => {
    const tabs = document.querySelectorAll('.pricing-tab');
    
    tabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = (tab as HTMLElement).dataset.tab;
        if (!targetId) return;

        // Update tab styles
        tabs.forEach(t => {
          t.classList.remove('bg-primary', 'text-white');
          t.classList.add('bg-muted/50', 'text-muted-foreground');
        });
        tab.classList.remove('bg-muted/50', 'text-muted-foreground');
        tab.classList.add('bg-primary', 'text-white');

        // Scroll to the target section
        const target = document.getElementById(targetId);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  });
</script>
