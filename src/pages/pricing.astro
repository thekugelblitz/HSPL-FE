---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import PricingCard from '../components/blocks/PricingCard.astro';
import { cloudPlans, premiumPlans, vpsPlans } from '../lib/data';
---

<Layout 
  title="Pricing Plans | HostingSpell"
  description="Choose from affordable hosting plans that suit your needs, from beginners to enterprises."
>
  <Navbar />
  <main class="flex-1">
    <section class="relative bg-background pt-24 pb-20 border-b border-border/40 overflow-hidden">
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:48px_48px]"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-primary/20 rounded-full blur-[120px] pointer-events-none animate-in fade-in duration-1000"></div>
  
  <div class="container mx-auto px-4 text-center relative z-10">
    <div class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-sm font-semibold text-primary mb-6 animate-in fade-in slide-in-from-bottom-4 duration-700">
      <span class="flex h-2 w-2 rounded-full bg-blue-400 mr-2 animate-pulse"></span> Transparent Pricing
    </div>
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold tracking-tight mb-6 animate-in fade-in slide-in-from-bottom-6 duration-700 delay-150 fill-mode-both">
      Simple Pricing <br class="hidden md:block"/><span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-blue-400 to-indigo-400">For Everyone</span>
    </h1>
    <p class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto mb-4 animate-in fade-in slide-in-from-bottom-4 duration-700 delay-300 fill-mode-both">
      No hidden fees. No surprise renewals. Choose the perfect plan for your business and scale as you grow.
    </p>
  </div>
</section>

    <section class="py-24">
      <div class="container mx-auto px-4 max-w-screen-xl">
        
        <div class="mb-32">
          <div class="flex items-center justify-between mb-12 border-b border-border/40 pb-4">
            <div>
              <h2 class="text-3xl font-bold">Cloud Hosting</h2>
              <p class="text-muted-foreground mt-2">Affordable hosting plans designed to fit any budget without compromising speed.</p>
            </div>
            <a href="/cloud-hosting" class="text-sm font-medium text-primary hover:underline hidden sm:block">View all Cloud plans &rarr;</a>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
            {cloudPlans.map(plan => <PricingCard {...plan} />)}
          </div>
        </div>

        <div class="mb-32">
          <div class="flex items-center justify-between mb-12 border-b border-border/40 pb-4">
            <div>
              <h2 class="text-3xl font-bold">Premium Hosting</h2>
              <p class="text-muted-foreground mt-2">Managed hosting on premium cloud infrastructure (Linode/DigitalOcean).</p>
            </div>
            <a href="/premium-hosting" class="text-sm font-medium text-primary hover:underline hidden sm:block">View all Premium plans &rarr;</a>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
            {premiumPlans.map(plan => <PricingCard {...plan} />)}
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-12 border-b border-border/40 pb-4">
            <div>
              <h2 class="text-3xl font-bold">VPS Hosting</h2>
              <p class="text-muted-foreground mt-2">High-performance virtual private servers with full root access.</p>
            </div>
            <a href="/vps" class="text-sm font-medium text-primary hover:underline hidden sm:block">View all VPS plans &rarr;</a>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
            {vpsPlans.map(plan => <PricingCard {...plan} />)}
          </div>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>
