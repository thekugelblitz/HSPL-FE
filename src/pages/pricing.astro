---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import PricingCard from '../components/blocks/PricingCard.astro';
import { cloudPlans, premiumPlans, vpsPlans } from '../lib/data';
---

<Layout 
  title="Pricing Plans | HostingSpell"
  description="Choose from affordable hosting plans that suit your needs, from beginners to enterprises."
>
  <Navbar />
  <main class="flex-1">
    <section class="relative bg-muted/30 pt-24 pb-28 border-b border-border/40 text-center overflow-hidden">
      <div class="absolute inset-0 bg-primary/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
      <div class="container mx-auto px-4 max-w-3xl relative z-10">
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6">
          Simple, transparent <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-blue-400">pricing</span>
        </h1>
        <p class="text-xl text-muted-foreground">
          No hidden renewal fees. Choose the plan that scales with your growth.
        </p>
      </div>
    </section>

    <section class="py-24">
      <div class="container mx-auto px-4 max-w-screen-xl">
        
        <div class="mb-32">
          <div class="flex items-center justify-between mb-12 border-b border-border/40 pb-4">
            <div>
              <h2 class="text-3xl font-bold">Cloud Hosting</h2>
              <p class="text-muted-foreground mt-2">Affordable hosting plans designed to fit any budget without compromising speed.</p>
            </div>
            <a href="/cloud-hosting" class="text-sm font-medium text-primary hover:underline hidden sm:block">View all Cloud plans &rarr;</a>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
            {cloudPlans.map(plan => <PricingCard {...plan} />)}
          </div>
        </div>

        <div class="mb-32">
          <div class="flex items-center justify-between mb-12 border-b border-border/40 pb-4">
            <div>
              <h2 class="text-3xl font-bold">Premium Hosting</h2>
              <p class="text-muted-foreground mt-2">Managed hosting on premium cloud infrastructure (Linode/DigitalOcean).</p>
            </div>
            <a href="/premium-hosting" class="text-sm font-medium text-primary hover:underline hidden sm:block">View all Premium plans &rarr;</a>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
            {premiumPlans.map(plan => <PricingCard {...plan} />)}
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-12 border-b border-border/40 pb-4">
            <div>
              <h2 class="text-3xl font-bold">VPS Hosting</h2>
              <p class="text-muted-foreground mt-2">High-performance virtual private servers with full root access.</p>
            </div>
            <a href="/vps" class="text-sm font-medium text-primary hover:underline hidden sm:block">View all VPS plans &rarr;</a>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
            {vpsPlans.map(plan => <PricingCard {...plan} />)}
          </div>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>
