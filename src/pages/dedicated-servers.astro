---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import TrustProofBar from '../components/blocks/TrustProofBar.astro';
import MigrationBanner from '../components/blocks/MigrationBanner.astro';
import { DedicatedServerBuilder } from '../components/blocks/DedicatedServerBuilder';
import { Button } from '../components/ui/button';
import { 
  Cpu, HardDrive, Zap, Server, ShieldCheck, CheckCircle2, ArrowRight, Activity, Terminal, Lock, Globe2, Layers, Headphones, Sparkles, RefreshCw, Radio, Sliders
} from 'lucide-react';

const serverPlans = [
  {
    name: "Enterprise AMD EPYC™",
    tagline: "High-Core Density & Enterprise Virtualization",
    cpu: "AMD EPYC™ 7302P (16C / 32T)",
    ram: "64GB DDR4 ECC Memory",
    storage: "2x 1TB Pure NVMe Gen4 (RAID 1)",
    bandwidth: "100TB @ 10Gbps Network Port",
    ipmi: "Dedicated IPMI / KVM Included",
    ddos: "2Tbps+ L3/L4/L7 Shield",
    price: "129",
    popular: false,
    badge: "Best Value"
  },
  {
    name: "High-Frequency Ryzen™",
    tagline: "5.7GHz Max Turbo Frequency for High-Speed Workloads",
    cpu: "AMD Ryzen™ 9 7950X (16C / 32T @ 5.7GHz)",
    ram: "128GB DDR5 ECC Memory",
    storage: "2x 2TB Pure NVMe Gen4 (RAID 1)",
    bandwidth: "10Gbps Unmetered Uplink",
    ipmi: "Dedicated IPMI / KVM Included",
    ddos: "2Tbps+ L3/L4/L7 Shield",
    price: "169",
    popular: true,
    badge: "Most Popular"
  },
  {
    name: "Intel® Xeon® Scalable",
    tagline: "Enterprise Dual-Socket Ready Mission Critical Engine",
    cpu: "Intel® Xeon® Gold 6348 (28C / 56T)",
    ram: "256GB DDR4 ECC Memory",
    storage: "4x 1.92TB Enterprise NVMe (RAID 10)",
    bandwidth: "10Gbps Unmetered Uplink",
    ipmi: "Dedicated IPMI / KVM Included",
    ddos: "2Tbps+ L3/L4/L7 Shield",
    price: "249",
    popular: false,
    badge: "Enterprise"
  },
  {
    name: "Dual EPYC™ Monster",
    tagline: "192 Compute Cores for AI/ML & Mass Virtualization",
    cpu: "Dual AMD EPYC™ 9654 (192C / 384T)",
    ram: "1024GB DDR5 ECC Memory (1TB)",
    storage: "8x 3.84TB Enterprise NVMe (HW RAID 10)",
    bandwidth: "25Gbps Uplink / Unmetered",
    ipmi: "Dedicated IPMI / KVM Included",
    ddos: "2Tbps+ L3/L4/L7 Shield",
    price: "599",
    popular: false,
    badge: "Ultimate Power"
  }
];

const faqs = [
  {
    q: "What is a Bare-Metal Dedicated Server?",
    a: "A bare-metal dedicated server is a single-tenant physical server where 100% of the hardware resources (CPU, RAM, NVMe storage, network controllers) are dedicated exclusively to your organization. Unlike virtual servers, there is zero hypervisor overhead, noisy neighbor penalty, or shared resource contention."
  },
  {
    q: "How fast is server provisioning?",
    a: "Standard hardware configurations (AMD EPYC, Ryzen 9, Xeon Gold) are provisioned automatically via PXE within 15 to 30 minutes after order confirmation. Custom hardware modifications or multi-drive RAID arrays are assembled and online in under 4 hours."
  },
  {
    q: "Do I get full IPMI / KVM out-of-band access?",
    a: "Yes! Every dedicated server comes standard with a dedicated out-of-band IPMI / iDRAC / KVM interface. You can remotely power cycle, reboot, mount custom ISO files, and access the BIOS at any time directly through our Client Portal."
  },
  {
    q: "What is your hardware replacement SLA?",
    a: "We provide a guaranteed 1-hour hardware replacement SLA. In the rare event of a physical RAM or disk degradation, our enterprise datacenter technicians replace the failed component within 60 minutes 24/7/365."
  },
  {
    q: "Can I announce my own IP address subnets (BGP / BYOIP)?",
    a: "Absolutely. We support custom BGP session setups, cross-connects, and BYOIP (/24 or larger IPv4 subnets and IPv6 blocks) with automated RPKI validation across our global routing locations."
  }
];
---

<Layout 
  title="Bare-Metal Dedicated Servers | 100% Single-Tenant AMD EPYC & Xeon | HostingSpell" 
  description="High-performance Bare-Metal Dedicated Servers powered by AMD EPYC and Intel Xeon Scalable processors. 100% dedicated hardware resources, 10Gbps unmetered bandwidth, IPMI KVM, and 2Tbps+ DDoS protection."
>
  <Navbar />

  <main class="flex-1 bg-[#000000] text-white">
    
    {/* Hero Section */}
    <section class="relative bg-[#000000] text-white pt-20 pb-24 border-b border-zinc-800/80 overflow-hidden">
      <div class="absolute inset-0 bg-blue-500/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
      <div class="absolute top-0 left-0 w-[600px] h-[600px] bg-blue-600/15 rounded-full blur-[140px] pointer-events-none"></div>
      <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-indigo-600/15 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="container mx-auto px-4 max-w-screen-2xl relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center text-left">
          
          {/* Left Column (7 cols) */}
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center rounded-full border border-blue-500/30 bg-blue-500/10 px-3.5 py-1 text-xs font-bold text-blue-400">
              <span class="flex h-2 w-2 rounded-full bg-blue-400 mr-2 animate-pulse"></span>
              Single-Tenant Bare-Metal Infrastructure
            </div>
            
            <h1 class="text-4xl sm:text-6xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] text-white">
              Unleash Pure <br />
              <span class="bg-gradient-to-r from-blue-400 via-indigo-400 to-sky-400 bg-clip-text text-transparent">Bare-Metal Performance.</span>
            </h1>

            <p class="text-base sm:text-lg text-zinc-300 max-w-2xl font-medium leading-relaxed">
              100% Dedicated AMD EPYC™ & Intel® Xeon® Scalable physical hardware with zero hypervisor overhead, Enterprise NVMe Gen4 RAID storage arrays, IPMI KVM out-of-band control, and 10Gbps unmetered network ports.
            </p>

            {/* Core Specs Callouts */}
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2">
              <div class="p-3.5 rounded-2xl bg-zinc-900/80 border border-zinc-800 flex items-center gap-3">
                <div class="p-2 rounded-xl bg-blue-500/15 text-blue-400 shrink-0">
                  <Cpu class="w-4 h-4" />
                </div>
                <div>
                  <div class="text-xs font-bold text-white">Up to 192 Cores</div>
                  <div class="text-[10px] text-zinc-400">AMD EPYC & Xeon</div>
                </div>
              </div>

              <div class="p-3.5 rounded-2xl bg-zinc-900/80 border border-zinc-800 flex items-center gap-3">
                <div class="p-2 rounded-xl bg-indigo-500/15 text-indigo-400 shrink-0">
                  <Zap class="w-4 h-4" />
                </div>
                <div>
                  <div class="text-xs font-bold text-white">1024GB ECC RAM</div>
                  <div class="text-[10px] text-zinc-400">DDR5 High-Speed</div>
                </div>
              </div>

              <div class="p-3.5 rounded-2xl bg-zinc-900/80 border border-zinc-800 flex items-center gap-3 col-span-2 sm:col-span-1">
                <div class="p-2 rounded-xl bg-emerald-500/15 text-emerald-400 shrink-0">
                  <Radio class="w-4 h-4" />
                </div>
                <div>
                  <div class="text-xs font-bold text-white">10Gbps Unmetered</div>
                  <div class="text-[10px] text-zinc-400">2Tbps+ DDoS Shield</div>
                </div>
              </div>
            </div>

            {/* CTAs */}
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-4">
              <a href="#plans">
                <Button size="lg" className="w-full sm:w-auto h-13 px-8 text-base font-extrabold bg-[#0073EC] hover:bg-[#005bb5] text-white shadow-xl shadow-blue-500/30 rounded-xl flex items-center justify-center gap-2">
                  <span>Explore Bare-Metal Servers</span>
                  <ArrowRight class="w-4 h-4" />
                </Button>
              </a>

              <a href="#builder">
                <Button size="lg" variant="outline" className="w-full sm:w-auto h-13 px-8 text-base font-extrabold border-zinc-800 bg-zinc-900/80 hover:bg-zinc-800 text-white rounded-xl flex items-center justify-center gap-2">
                  <Sliders class="w-4 h-4 text-blue-400" />
                  <span>Custom Hardware Configurator</span>
                </Button>
              </a>
            </div>

            <div class="flex items-center gap-6 pt-2 text-xs font-semibold text-zinc-400">
              <span class="flex items-center gap-1.5"><CheckCircle2 class="w-4 h-4 text-emerald-400" /> 1-Hour Hardware SLA</span>
              <span class="flex items-center gap-1.5"><CheckCircle2 class="w-4 h-4 text-emerald-400" /> Full IPMI KVM Access</span>
              <span class="flex items-center gap-1.5"><CheckCircle2 class="w-4 h-4 text-emerald-400" /> Zero Hypervisor Lock-in</span>
            </div>
          </div>

          {/* Right Column: Interactive Hardware Telemetry Box */}
          <div class="lg:col-span-5">
            <div class="rounded-3xl p-7 border border-blue-500/30 shadow-2xl relative overflow-hidden bg-gradient-to-b from-zinc-900 via-zinc-950 to-black text-left">
              <div class="flex items-center justify-between pb-5 border-b border-zinc-800">
                <div class="flex items-center gap-3">
                  <div class="w-3 h-3 rounded-full bg-emerald-400 animate-ping"></div>
                  <div>
                    <h4 class="font-extrabold text-sm text-white">Bare-Metal Node: DED-US-EAST-09</h4>
                    <p class="text-[11px] text-zinc-400 font-mono">Status: 100% Dedicated Hardware Online</p>
                  </div>
                </div>
                <span class="text-xs font-black uppercase tracking-wider bg-blue-500/15 text-blue-400 px-3 py-1 rounded-full border border-blue-500/30">
                  BARE-METAL
                </span>
              </div>

              <div class="py-6 space-y-4 font-mono text-xs">
                <div class="p-3.5 rounded-xl bg-black/60 border border-zinc-800 space-y-1.5">
                  <div class="flex justify-between text-zinc-400">
                    <span>CPU Architecture:</span>
                    <span class="text-white font-bold">AMD EPYC 7302P (32 Threads)</span>
                  </div>
                  <div class="w-full bg-zinc-800 rounded-full h-1.5 overflow-hidden">
                    <div class="bg-blue-500 h-1.5 rounded-full w-[28%]"></div>
                  </div>
                </div>

                <div class="p-3.5 rounded-xl bg-black/60 border border-zinc-800 space-y-1.5">
                  <div class="flex justify-between text-zinc-400">
                    <span>RAM Allocation:</span>
                    <span class="text-white font-bold">128GB DDR4 ECC (Dedicated)</span>
                  </div>
                  <div class="w-full bg-zinc-800 rounded-full h-1.5 overflow-hidden">
                    <div class="bg-indigo-500 h-1.5 rounded-full w-[19%]"></div>
                  </div>
                </div>

                <div class="p-3.5 rounded-xl bg-black/60 border border-zinc-800 space-y-1.5">
                  <div class="flex justify-between text-zinc-400">
                    <span>NVMe Gen4 IOPS:</span>
                    <span class="text-emerald-400 font-bold">850,000 Read IOPS</span>
                  </div>
                  <div class="w-full bg-zinc-800 rounded-full h-1.5 overflow-hidden">
                    <div class="bg-emerald-500 h-1.5 rounded-full w-[94%]"></div>
                  </div>
                </div>
              </div>

              <div class="p-4 rounded-2xl bg-blue-600/10 border border-blue-500/30 flex items-center justify-between">
                <div>
                  <div class="text-xs font-black uppercase tracking-wider text-blue-400">Bare-Metal Starting Price</div>
                  <div class="text-2xl font-black text-white">$129 <span class="text-xs text-zinc-400 font-medium">/month</span></div>
                </div>
                <a href="#plans">
                  <Button size="sm" className="bg-[#0073EC] hover:bg-[#005bb5] text-white font-extrabold text-xs px-5 py-2.5 rounded-xl">
                    Order Server
                  </Button>
                </a>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    {/* Metric Proof Bar */}
    <TrustProofBar />

    {/* Dedicated Hardware Server Plans Matrix */}
    <section class="py-24 bg-[#000000] relative" id="plans">
      <div class="container mx-auto px-4 max-w-screen-2xl text-center">
        
        <div class="max-w-3xl mx-auto space-y-4 mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-extrabold uppercase tracking-wider">
            <Server class="w-3.5 h-3.5" />
            <span>Pre-Configured Enterprise Bare-Metal Racks</span>
          </div>
          <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
            High-Performance Bare-Metal Lineup
          </h2>
          <p class="text-base text-zinc-400 font-medium">
            Single-tenant physical servers ready for immediate deployment with IPMI out-of-band management and 2Tbps+ DDoS mitigation.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 text-left">
          {serverPlans.map((plan) => (
            <div class={`rounded-3xl p-7 bg-zinc-950 border transition-all duration-300 flex flex-col justify-between relative ${
              plan.popular 
                ? 'border-blue-500 shadow-2xl shadow-blue-500/15 ring-1 ring-blue-500' 
                : 'border-zinc-800 hover:border-zinc-700'
            }`}>
              {plan.popular && (
                <div class="absolute -top-3.5 left-0 right-0 mx-auto w-fit rounded-full bg-[#0073EC] px-4 py-1 text-xs font-extrabold text-white shadow-lg uppercase tracking-wider">
                  {plan.badge}
                </div>
              )}

              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-black uppercase tracking-wider text-blue-400 bg-blue-500/10 px-2.5 py-1 rounded-md border border-blue-500/20">
                    {plan.badge}
                  </span>
                </div>
                <h3 class="text-xl font-extrabold text-white">{plan.name}</h3>
                <p class="text-xs text-zinc-400 mt-1 min-h-[32px]">{plan.tagline}</p>

                <div class="my-6 pb-6 border-b border-zinc-800">
                  <div class="flex items-baseline gap-1">
                    <span class="text-4xl font-black text-white">${plan.price}</span>
                    <span class="text-xs text-zinc-400 font-bold">/month</span>
                  </div>
                  <div class="text-[11px] text-emerald-400 mt-1 font-semibold">Zero Setup Fee • IPMI Included</div>
                </div>

                <div class="space-y-3.5 text-xs text-zinc-300">
                  <div class="flex items-center gap-2.5">
                    <Cpu class="w-4 h-4 text-blue-400 shrink-0" />
                    <span class="font-bold">{plan.cpu}</span>
                  </div>

                  <div class="flex items-center gap-2.5">
                    <Zap class="w-4 h-4 text-indigo-400 shrink-0" />
                    <span>{plan.ram}</span>
                  </div>

                  <div class="flex items-center gap-2.5">
                    <HardDrive class="w-4 h-4 text-emerald-400 shrink-0" />
                    <span>{plan.storage}</span>
                  </div>

                  <div class="flex items-center gap-2.5">
                    <Radio class="w-4 h-4 text-sky-400 shrink-0" />
                    <span>{plan.bandwidth}</span>
                  </div>

                  <div class="flex items-center gap-2.5">
                    <Terminal class="w-4 h-4 text-purple-400 shrink-0" />
                    <span>{plan.ipmi}</span>
                  </div>

                  <div class="flex items-center gap-2.5">
                    <ShieldCheck class="w-4 h-4 text-emerald-400 shrink-0" />
                    <span>{plan.ddos}</span>
                  </div>
                </div>
              </div>

              <div class="pt-8">
                <a href={`https://manage.hostingspell.com/cart.php?a=add&pid=dedicated-${plan.name.toLowerCase().replace(/[^a-z0-9]/g, '-')}`}>
                  <Button className={`w-full py-3.5 font-extrabold text-sm rounded-xl transition-all ${
                    plan.popular ? 'bg-[#0073EC] hover:bg-[#005bb5] text-white shadow-lg shadow-blue-500/25' : 'bg-zinc-900 hover:bg-zinc-800 text-white border border-zinc-700'
                  }`}>
                    Deploy Server Now
                  </Button>
                </a>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    {/* Interactive Server Customizer Section */}
    <section class="py-24 bg-[#000000] border-t border-zinc-800/80 relative" id="builder">
      <div class="container mx-auto px-4 max-w-screen-2xl">
        <DedicatedServerBuilder client:idle />
      </div>
    </section>

    {/* Bare-Metal Hardware Features Architecture Grid */}
    <section class="py-24 bg-[#000000] border-t border-zinc-800/80">
      <div class="container mx-auto px-4 max-w-screen-xl text-center">
        
        <div class="max-w-3xl mx-auto space-y-4 mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-extrabold uppercase tracking-wider">
            <Layers class="w-3.5 h-3.5" />
            <span>Built For Mission-Critical Workloads</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
            Why Enterprise Leaders Choose Our Bare-Metal Infrastructure
          </h2>
          <p class="text-sm text-zinc-400 font-medium">
            Full physical control over your server environment with zero hypervisor latency, hardware RAID resiliency, and enterprise SLAs.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left">
          
          <div class="p-8 rounded-3xl bg-zinc-950 border border-zinc-800 space-y-4">
            <div class="p-3.5 rounded-2xl bg-blue-500/15 text-blue-400 w-fit">
              <Cpu class="w-6 h-6" />
            </div>
            <h3 class="text-xl font-extrabold text-white">Zero Hypervisor Overhead</h3>
            <p class="text-xs text-zinc-400 leading-relaxed font-medium">
              Get 100% of your CPU cycles, cache memory, and PCIe lanes without any virtualization layer, hypervisor throttling, or noisy neighbors.
            </p>
          </div>

          <div class="p-8 rounded-3xl bg-zinc-950 border border-zinc-800 space-y-4">
            <div class="p-3.5 rounded-2xl bg-purple-500/15 text-purple-400 w-fit">
              <Terminal class="w-6 h-6" />
            </div>
            <h3 class="text-xl font-extrabold text-white">Out-of-Band IPMI / KVM Access</h3>
            <p class="text-xs text-zinc-400 leading-relaxed font-medium">
              Direct physical console access via IPMI, iDRAC, or iLO. Mount custom OS ISOs, perform remote hardware reboots, and adjust BIOS settings anytime.
            </p>
          </div>

          <div class="p-8 rounded-3xl bg-zinc-950 border border-zinc-800 space-y-4">
            <div class="p-3.5 rounded-2xl bg-emerald-500/15 text-emerald-400 w-fit">
              <ShieldCheck class="w-6 h-6" />
            </div>
            <h3 class="text-xl font-extrabold text-white">1-Hour Guaranteed Hardware SLA</h3>
            <p class="text-xs text-zinc-400 leading-relaxed font-medium">
              If a physical component (RAM module, SSD drive, or PSU) fails, our certified datacenter engineers replace it within 60 minutes 24/7.
            </p>
          </div>

        </div>

      </div>
    </section>

    {/* Migration Banner */}
    <MigrationBanner />

    {/* FAQ Accordion Section */}
    <section class="py-24 bg-[#000000] border-t border-zinc-800/80">
      <div class="container mx-auto px-4 max-w-screen-md text-center">
        
        <div class="space-y-4 mb-16">
          <span class="text-xs font-black uppercase tracking-wider text-blue-400 bg-blue-500/10 px-3 py-1 rounded-full border border-blue-500/20">
            Bare-Metal FAQ
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white">Frequently Asked Questions</h2>
        </div>

        <div class="space-y-4 text-left">
          {faqs.map((faq) => (
            <div class="p-6 rounded-2xl bg-zinc-950 border border-zinc-800 space-y-2">
              <h3 class="font-extrabold text-base text-white">{faq.q}</h3>
              <p class="text-xs text-zinc-400 leading-relaxed font-medium">{faq.a}</p>
            </div>
          ))}
        </div>

      </div>
    </section>

  </main>

  <Footer />
</Layout>
