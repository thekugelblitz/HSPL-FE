---
// src/pages/wordpress-hosting.astro
// WordPress Hosting — sells the WordPress-specific outcome

import ProductPageTemplate from '../layouts/ProductPageTemplate.astro';
import ValueStack from '../components/blocks/ValueStack.astro';
import CpanelShowcase from '../components/blocks/CpanelShowcase.astro';
import { InteractivePricingGrid } from '../components/pricing/InteractivePricingGrid';
import { PLANS_CLOUD_HOSTING } from '../lib/pricing/cloudPlans';
import { CLOUD_PROVIDER_LOCATIONS, GLOBAL_BILLING_CYCLES } from '../lib/pricing/constants';
import { faqs } from '../lib/data';
import { Zap, Shield, Paintbrush } from 'lucide-react';

const wpFaqs = faqs.slice(0, 5);
---

<ProductPageTemplate
  title="WordPress Hosting — WordPress That Actually Flies | HostingSpell"
  description="Managed WordPress hosting with LiteSpeed LSCache auto-optimization, 1-click WordPress installer, free SSL, and 24/7 expert WordPress support."
  heroTag="WordPress Hosting"
  heroHeadline='WordPress That<br /><span class="bg-gradient-to-r from-blue-500 via-indigo-500 to-purple-500 dark:from-blue-400 dark:via-indigo-400 dark:to-purple-400 bg-clip-text text-transparent">Actually Flies.</span>'
  heroSubheadline="Your WordPress site loads in under 1 second with LiteSpeed LSCache auto-optimization. Free SSL, daily backups, and managed security — so you focus on content, not servers."
  heroCtaText="See WordPress Plans"
  heroCtaHref="#plans"
  heroCheckpoints={[
    "LiteSpeed LSCache — auto-optimized for WordPress",
    "1-click WordPress + WooCommerce installation",
    "Managed Imunify360 security + daily JetBackup snapshots",
  ]}
  heroPriceAnchor="Starting at $1.29/mo • 30-Day Money-Back Guarantee"
  faqs={wpFaqs}
>
  
  <section slot="outcomes" class="py-20 border-b border-border/40">
    <div class="container mx-auto px-4 max-w-screen-xl">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-extrabold tracking-tight mb-3">Built for WordPress Performance</h2>
        <p class="text-muted-foreground">Everything your WordPress site needs to be fast, secure, and easy to manage.</p>
      </div>

      <div class="grid sm:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border/60 bg-card/60 p-7 text-center space-y-4 hover:border-primary/40 transition-colors">
          <div class="p-3 bg-primary/10 text-primary rounded-xl w-fit mx-auto">
            <Zap className="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">LSCache Built-In</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">LiteSpeed's native WordPress cache plugin is pre-installed and auto-configured. Zero setup needed.</p>
        </div>

        <div class="rounded-2xl border border-border/60 bg-card/60 p-7 text-center space-y-4 hover:border-primary/40 transition-colors">
          <div class="p-3 bg-primary/10 text-primary rounded-xl w-fit mx-auto">
            <Shield className="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">Managed Security</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">Imunify360 blocks WordPress-specific malware, brute-force attacks, and web defacement automatically.</p>
        </div>

        <div class="rounded-2xl border border-border/60 bg-card/60 p-7 text-center space-y-4 hover:border-primary/40 transition-colors">
          <div class="p-3 bg-primary/10 text-primary rounded-xl w-fit mx-auto">
            <Paintbrush className="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">1-Click Everything</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">Install WordPress, WooCommerce, themes, and plugins with one click via Softaculous.</p>
        </div>
      </div>
    </div>
  </section>

  <section slot="pricing" class="py-20 bg-muted/10" id="plans">
    <div class="container mx-auto px-4 max-w-screen-xl">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-bold mb-2">WordPress Hosting Plans</h2>
        <p class="text-sm text-muted-foreground">All plans include cPanel, LiteSpeed Enterprise, and 1-click WordPress installer.</p>
      </div>

      <div class="max-w-screen-md mx-auto mb-6">
        <ValueStack />
      </div>

      <InteractivePricingGrid
        client:load
        plans={PLANS_CLOUD_HOSTING}
        locations={CLOUD_PROVIDER_LOCATIONS}
        billingCycles={GLOBAL_BILLING_CYCLES.cloudhosting}
      />
    </div>
  </section>

  <section slot="details" class="py-16 border-t border-border/40">
    <div class="container mx-auto px-4 max-w-screen-xl">
      <details class="group">
        <summary class="cursor-pointer text-sm font-semibold text-primary flex items-center gap-2 hover:underline py-4">
          <span>View cPanel & WordPress Management Features</span>
          <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <CpanelShowcase />
      </details>
    </div>
  </section>

</ProductPageTemplate>
