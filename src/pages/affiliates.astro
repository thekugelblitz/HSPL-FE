---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { affiliateTiers, affiliateFaqs } from '../lib/data';
import { DollarSign, Award, Users, ArrowRight, CheckCircle2, TrendingUp, Sparkles, ShieldCheck, Check } from 'lucide-react';
---

<Layout title="Affiliate Program | HostingSpell - Earn Up to $50 Per Sale">
  <Navbar />
  <main class="bg-background overflow-hidden">
    {/* Page Hero - 2-Column Split Hero Layout */}
    <section class="py-20 bg-grid-pattern border-b border-border/40 relative">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-emerald-500/20 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center text-left">
          
          {/* Left Column (7 cols) */}
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 text-xs font-bold rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 uppercase tracking-wider">
              <DollarSign class="w-4 h-4" /> High-Paying Partner Program
            </div>

            <h1 class="text-4xl sm:text-6xl lg:text-6xl font-extrabold tracking-tight leading-[1.1]">
              Partner with HostingSpell & Earn Up to <span class="text-emerald-400">$50 Per Sale</span>
            </h1>

            <p class="text-base sm:text-lg text-muted-foreground font-medium max-w-xl">
              Recommend ultra-fast NVMe cloud hosting to your audience, clients, or followers and earn industry-leading commissions with 90-day cookie tracking.
            </p>

            <ul class="space-y-3 text-xs sm:text-sm font-semibold text-foreground">
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>90-Day Cookie Tracking Window for Maximum Conversions</span>
              </li>
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>On-Time Monthly Payouts via PayPal, Bank & Hosting Credits</span>
              </li>
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>High-Converting $1.29/mo Price Point & 100% Uptime Mark</span>
              </li>
            </ul>

            <div class="pt-2 flex flex-col sm:flex-row items-center gap-4">
              <a 
                href="https://manage.hostingspell.com/register.php" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="w-full sm:w-auto px-8 h-13 rounded-xl bg-emerald-500 text-slate-950 font-extrabold hover:bg-emerald-400 transition-all shadow-xl shadow-emerald-500/20 flex items-center justify-center gap-2"
              >
                <span>Join Affiliate Program</span>
                <ArrowRight class="w-4 h-4" />
              </a>
              <a 
                href="#tiers" 
                class="w-full sm:w-auto px-8 h-13 rounded-xl bg-secondary/80 text-secondary-foreground font-extrabold hover:bg-secondary transition-all border border-border flex items-center justify-center"
              >
                View Payout Tiers
              </a>
            </div>
          </div>

          {/* Right Column (5 cols) - Affiliate Earning Visual Card */}
          <div class="lg:col-span-5 relative">
            <div class="glass-card rounded-3xl p-7 border border-emerald-500/30 shadow-2xl relative overflow-hidden bg-card/90 backdrop-blur-xl">
              <div class="flex items-center justify-between border-b border-border/60 pb-4 mb-5">
                <div class="flex items-center gap-3">
                  <div class="p-2 rounded-xl bg-emerald-500/20 text-emerald-400">
                    <TrendingUp class="w-4 h-4" />
                  </div>
                  <div>
                    <div class="text-xs font-black text-foreground">Affiliate Commission Dashboard</div>
                    <div class="text-[10px] text-emerald-400 font-bold">🟢 90-Day Cookie Active</div>
                  </div>
                </div>
                <span class="text-[10px] font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-2.5 py-1 rounded-full">
                  TOP COMMISSIONS
                </span>
              </div>

              <div class="grid grid-cols-2 gap-3 mb-5">
                <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60">
                  <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] font-bold mb-1">
                    <DollarSign class="w-3.5 h-3.5 text-emerald-400" /> Max Payout
                  </div>
                  <div class="text-lg font-black text-emerald-400">$50 / Sale</div>
                </div>

                <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60">
                  <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] font-bold mb-1">
                    <ShieldCheck class="w-3.5 h-3.5 text-blue-400" /> Cookie Life
                  </div>
                  <div class="text-lg font-black text-foreground">90 Days</div>
                </div>
              </div>

              <div class="p-4 rounded-2xl bg-gradient-to-r from-emerald-500/15 via-emerald-500/5 to-transparent border border-emerald-500/30 flex items-center justify-between">
                <div>
                  <div class="text-xs font-extrabold text-foreground">Instant Partner Account</div>
                  <div class="text-[11px] text-muted-foreground">Free Sign Up + Custom Banners</div>
                </div>
                <div class="text-right">
                  <div class="text-lg font-black text-emerald-400">$50<span class="text-[10px] font-bold text-muted-foreground"> Min Payout</span></div>
                  <span class="text-[9px] font-black uppercase bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded">INSTANT</span>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    {/* Benefits Grid */}
    <section class="py-20 border-b border-border/40">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="grid md:grid-cols-3 gap-8">
          <div class="glass-card rounded-2xl p-8 glow-card space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center">
              <TrendingUp class="w-6 h-6" />
            </div>
            <h3 class="font-bold text-xl">High Conversion Rates</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Our ultra-competitive pricing ($1.29/mo) and 100% uptime mark make HostingSpell exceptionally easy to convert for any tech or blogging audience.
            </p>
          </div>

          <div class="glass-card rounded-2xl p-8 glow-card space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center">
              <Sparkles class="w-6 h-6" />
            </div>
            <h3 class="font-bold text-xl">90-Day Cookie Tracking</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Visitors referred by your link are tracked for 90 days. Even if they purchase weeks later, you get full commission credit.
            </p>
          </div>

          <div class="glass-card rounded-2xl p-8 glow-card space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-purple-500/10 text-purple-400 flex items-center justify-center">
              <ShieldCheck class="w-6 h-6" />
            </div>
            <h3 class="font-bold text-xl">Reliable Monthly Payouts</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Get paid on time every month via PayPal, Direct Bank Transfer, or Hosting Credit with a low minimum payout threshold of just $50.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Tiers Section */}
    <section class="py-24 border-b border-border/40" id="tiers">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl font-bold tracking-tight mb-4">
            Tiered Commission Structure
          </h2>
          <p class="text-muted-foreground text-base">
            The more referrals you bring each month, the higher your commission payout per customer!
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {affiliateTiers.map((tier, idx) => (
            <div class={`glass-card rounded-2xl p-6 glow-card flex flex-col justify-between ${idx === 3 ? 'border-emerald-500/50 bg-emerald-950/20' : ''}`}>
              <div>
                <span class="text-xs font-mono uppercase font-bold text-muted-foreground">{tier.salesRange}</span>
                <div class="text-3xl font-extrabold text-emerald-400 my-3">{tier.commission}</div>
                <p class="text-xs text-muted-foreground leading-relaxed pt-2 border-t border-border/40">
                  {tier.perk}
                </p>
              </div>
              <div class="mt-6 pt-4 border-t border-border/40 text-xs font-semibold text-foreground flex items-center gap-1.5">
                <CheckCircle2 class="w-4 h-4 text-emerald-400" />
                <span>Instant Approval</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Affiliate FAQs */}
    <section class="py-24">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <h2 class="text-3xl font-bold tracking-tight mb-4">Frequently Asked Questions</h2>
          <p class="text-muted-foreground">Everything you need to know about our partner program.</p>
        </div>

        <div class="max-w-3xl mx-auto space-y-4">
          {affiliateFaqs.map((faq) => (
            <div class="glass-card rounded-2xl p-6 glow-card">
              <h3 class="font-bold text-base mb-2">{faq.question}</h3>
              <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
