---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import PricingCard from '../components/blocks/PricingCard.astro';
import FeatureCard from '../components/blocks/FeatureCard.astro';
import { FaqAccordion } from '../components/blocks/FaqAccordion';
import { resellerPlans, faqs } from '../lib/data';

const features = [
  {
    title: "100% White Labeled",
    description: "Provide hosting under your own brand with custom nameservers and a white-labeled control panel.",
    icon: "Shield" as const
  },
  {
    title: "Free WHMCS License",
    description: "Automate your billing, provisioning, and client management easily with a free WHMCS license on top plans.",
    icon: "Server" as const
  },
  {
    title: "High Performance",
    description: "LiteSpeed Web Server and NVMe storage ensure your clients' sites load instantly.",
    icon: "Zap" as const
  },
  {
    title: "Automated Backups",
    description: "Daily automated backups with JetBackup keep your and your clients' data safe.",
    icon: "RefreshCw" as const
  }
];
---

<Layout 
  title="Best Reseller Hosting Plans | Cheap Reseller Hosting | HostingSpell"
  description="Launch your hosting business with affordable reseller packages offering unlimited resources, easy management, and scalable solutions."
>
  <Navbar />
  <main class="flex-1">
    <section class="relative bg-background pt-24 pb-28 border-b border-border/40 overflow-hidden">
  <div class="absolute inset-0 bg-indigo-500/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
  <div class="absolute top-0 right-0 w-96 h-96 bg-indigo-500/20 rounded-full blur-[120px] pointer-events-none animate-in fade-in duration-1000"></div>
  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-blue-600/10 rounded-full blur-[100px] pointer-events-none animate-in fade-in duration-1000 delay-300"></div>
  
  <div class="container mx-auto px-4 max-w-screen-xl text-center relative z-10">
    <div class="inline-flex items-center rounded-full border border-indigo-500/30 bg-indigo-500/10 px-3 py-1 text-sm font-semibold text-indigo-500 mb-6 animate-in fade-in slide-in-from-bottom-4 duration-700">
      <span class="flex h-2 w-2 rounded-full bg-blue-400 mr-2 animate-pulse"></span> White-Label Ready
    </div>
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold tracking-tight mb-6 animate-in fade-in slide-in-from-bottom-6 duration-700 delay-150 fill-mode-both">
      Start Your Own <br class="hidden md:block"/><span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-500 to-blue-400">Hosting Business</span>
    </h1>
    <p class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto mb-10 animate-in fade-in slide-in-from-bottom-4 duration-700 delay-300 fill-mode-both">
      100% white-labeled reseller hosting with WHM/cPanel. Build your agency or start your own hosting company effortlessly.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-in fade-in slide-in-from-bottom-4 duration-700 delay-500 fill-mode-both">
      <a href="#plans">
        <Button size="lg" className="h-12 px-8 text-base bg-indigo-600 hover:bg-indigo-700 shadow-lg shadow-indigo-500/25 transition-all group overflow-hidden relative font-bold text-white">
          <span class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></span>
          <span class="relative">View Reseller Plans</span>
        </Button>
      </a>
      <a href="/contact">
        <Button size="lg" variant="outline" className="h-12 px-8 text-base font-bold hover:bg-indigo-500/10 hover:text-indigo-600 border-border/60 transition-colors">
          Contact Sales
        </Button>
      </a>
    </div>
  </div>
</section>

    <section class="py-24" id="plans">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold mb-4">Plans That Adapt to Your Budget</h2>
          <p class="text-muted-foreground">Choose the perfect plan for your needs</p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
          {resellerPlans.map(plan => (
            <PricingCard {...plan} />
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 bg-muted/30">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold mb-4">Why Choose HostingSpell Reseller?</h2>
          <p class="text-muted-foreground">Everything you need to run a successful web hosting company.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {features.map(feature => (
            <FeatureCard {...feature} />
          ))}
        </div>
      </div>
    </section>
    
    <section class="py-24">
      <div class="container mx-auto px-4 max-w-3xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold mb-4">Frequently Asked Questions</h2>
          <p class="text-muted-foreground">Find answers to the most common questions about HostingSpell's platform.</p>
        </div>
        <FaqAccordion items={faqs} client:visible />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
