---
// src/pages/reseller.astro
// Reseller product page — sells the BUSINESS OPPORTUNITY, not the specs
// Includes ROI calculator (CRO doc #13) and FloatingLeadWidget (high-ticket)

import ProductPageTemplate from '../layouts/ProductPageTemplate.astro';
import FloatingLeadWidget from '../components/blocks/FloatingLeadWidget.astro';
import WhmShowcase from '../components/blocks/WhmShowcase.astro';
import { ResellerRoiCalculator } from '../components/blocks/ResellerRoiCalculator';
import { InteractivePricingGrid } from '../components/pricing/InteractivePricingGrid';
import { PLANS_RESELLER_HOSTING } from '../lib/pricing/resellerPlans';
import { RESELLER_PROVIDER_LOCATIONS, GLOBAL_BILLING_CYCLES } from '../lib/pricing/constants';
import { faqs } from '../lib/data';
import { DollarSign, Users, Palette, ArrowRight } from 'lucide-react';

const resellerFaqs = faqs.slice(0, 5);
---

<ProductPageTemplate
  title="Reseller Hosting — Launch Your Hosting Business for $19.99/mo | HostingSpell"
  description="White-label WHM/cPanel reseller hosting. Create and manage your own hosting brand and customer accounts. Start earning recurring revenue."
  heroTag="Reseller Hosting"
  heroHeadline='Launch Your Hosting Business<br /><span class="bg-gradient-to-r from-indigo-500 via-teal-500 to-emerald-500 dark:from-indigo-400 dark:via-teal-400 dark:to-emerald-400 bg-clip-text text-transparent">for $19.99/mo.</span>'
  heroSubheadline="Create your own hosting brand. Sell cPanel accounts to your clients under your domain. White-label WHM gives you full control — your clients never see HostingSpell."
  heroCtaText="Start Your Hosting Business"
  heroCtaHref="#plans"
  heroCheckpoints={[
    "White-label WHM/cPanel — your brand, your pricing",
    "Create unlimited cPanel accounts for your clients",
    "Sell hosting and earn $280+ profit per month",
  ]}
  heroPriceAnchor="Starting at $19.99/mo • 30-Day Money-Back Guarantee"
  faqs={resellerFaqs}
>
  
  {/* ─── Slot: Outcomes ─── */}
  <section slot="outcomes" class="py-20 border-b border-border/40">
    <div class="container mx-auto px-4 max-w-screen-xl">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-extrabold tracking-tight mb-3">A Real Business, Not Just a Plan</h2>
        <p class="text-muted-foreground">Here's why agencies and entrepreneurs choose HostingSpell Reseller.</p>
      </div>

      <div class="grid sm:grid-cols-3 gap-6 max-w-5xl mx-auto mb-14">
        <div class="rounded-2xl border border-border/60 bg-card/60 p-7 text-center space-y-4 hover:border-indigo-500/40 transition-colors">
          <div class="p-3 bg-indigo-500/10 text-indigo-500 rounded-xl w-fit mx-auto">
            <DollarSign className="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">Recurring Revenue</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">Sell 30 accounts at $10/mo = $300/mo income. Your cost: $19.99/mo. Net profit: $280.01/mo.</p>
        </div>

        <div class="rounded-2xl border border-border/60 bg-card/60 p-7 text-center space-y-4 hover:border-indigo-500/40 transition-colors">
          <div class="p-3 bg-indigo-500/10 text-indigo-500 rounded-xl w-fit mx-auto">
            <Palette className="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">100% White-Label</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">Your brand, your nameservers, your pricing. Clients see your company — never HostingSpell.</p>
        </div>

        <div class="rounded-2xl border border-border/60 bg-card/60 p-7 text-center space-y-4 hover:border-indigo-500/40 transition-colors">
          <div class="p-3 bg-indigo-500/10 text-indigo-500 rounded-xl w-fit mx-auto">
            <Users className="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">We Handle Infrastructure</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">You focus on sales and support. We handle servers, backups, security, and uptime.</p>
        </div>
      </div>

      {/* ROI Calculator — CRO doc #13 */}
      <div class="max-w-2xl mx-auto">
        <ResellerRoiCalculator client:visible />
      </div>
    </div>
  </section>

  {/* ─── Slot: Pricing ─── */}
  <section slot="pricing" class="py-20 bg-muted/10" id="plans">
    <div class="container mx-auto px-4 max-w-screen-xl">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-bold mb-2">Reseller Plans</h2>
        <p class="text-sm text-muted-foreground">Select your datacenter and billing cycle. All plans include WHM, WHMCS integration, and white-label branding.</p>
      </div>

      <InteractivePricingGrid
        client:load
        plans={PLANS_RESELLER_HOSTING}
        locations={RESELLER_PROVIDER_LOCATIONS}
        billingCycles={GLOBAL_BILLING_CYCLES.resellerhosting}
      />

      {/* Prominent Webuzo Reseller Alternative Card */}
      <div class="mt-10 max-w-2xl mx-auto p-5 rounded-2xl border border-teal-500/30 bg-teal-500/10 dark:bg-teal-950/20 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
        <div class="space-y-1">
          <div class="inline-flex items-center gap-1.5 text-xs font-black text-teal-600 dark:text-teal-400 uppercase tracking-wider">
            <span>🔥 25% Cheaper Alternative</span>
          </div>
          <h4 class="text-sm font-extrabold text-foreground">Looking for lower licensing costs without cPanel fee hikes?</h4>
          <p class="text-xs text-muted-foreground">Webuzo Reseller includes white-label admin, WHMCS integration, Apache/Nginx stack from $9.99/mo.</p>
        </div>
        <a href="/webuzo-reseller" class="shrink-0">
          <button type="button" class="px-4 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-500 text-white font-extrabold text-xs shadow-md shadow-teal-500/20 transition-all flex items-center gap-1.5 cursor-pointer">
            <span>Explore Webuzo Reseller</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </button>
        </a>
      </div>
    </div>
  </section>

  {/* ─── Slot: Details ─── */}
  <section slot="details" class="py-16 border-t border-border/40">
    <div class="container mx-auto px-4 max-w-screen-xl">
      <details class="group">
        <summary class="cursor-pointer text-sm font-semibold text-primary flex items-center gap-2 hover:underline py-4">
          <span>View WHM Control Panel Features</span>
          <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <WhmShowcase />
      </details>
    </div>
  </section>

  {/* FloatingLeadWidget on high-ticket Reseller page */}
  <FloatingLeadWidget />

</ProductPageTemplate>
