---
import { Button } from "@/components/ui/button";
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import PricingCard from '../components/blocks/PricingCard.astro';
import FeatureCard from '../components/blocks/FeatureCard.astro';
import { FaqAccordion } from '../components/blocks/FaqAccordion';
import { PlanComparisonTable } from '../components/blocks/PlanComparisonTable';
import { ResellerRoiCalculator } from '../components/blocks/ResellerRoiCalculator';
import { resellerPlans, faqs } from '../lib/data';
import WhmShowcase from '../components/blocks/WhmShowcase.astro';
import MigrationBanner from '../components/blocks/MigrationBanner.astro';
import { Check, Shield, Server, Zap, RefreshCw, ArrowRight, Layers, Users } from 'lucide-react';

const features = [
  {
    title: "100% White Labeled",
    description: "Provide hosting under your own brand with custom nameservers and a white-labeled control panel.",
    icon: "Shield" as const
  },
  {
    title: "Free WHMCS License",
    description: "Automate your billing, provisioning, and client management easily with a free WHMCS license on top plans.",
    icon: "Server" as const
  },
  {
    title: "High Performance",
    description: "LiteSpeed Web Server and NVMe storage ensure your clients' sites load instantly.",
    icon: "Zap" as const
  },
  {
    title: "Automated Backups",
    description: "Daily automated backups with JetBackup keep your and your clients' data safe.",
    icon: "RefreshCw" as const
  }
];
---

<Layout 
  title="Best Reseller Hosting Plans | Cheap Reseller Hosting | HostingSpell"
  description="Launch your hosting business with affordable reseller packages offering unlimited resources, easy management, and scalable solutions."
>
  <Navbar />
  <main class="flex-1">
    {/* Page Hero - 2-Column Split Hero Layout */}
    <section class="relative bg-background pt-20 pb-24 border-b border-border/40 overflow-hidden">
      <div class="absolute inset-0 bg-indigo-500/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
      <div class="absolute top-0 right-0 w-96 h-96 bg-indigo-500/20 rounded-full blur-[120px] pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-blue-600/10 rounded-full blur-[100px] pointer-events-none"></div>
      
      <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center text-left">
          
          {/* Left Column (7 cols) */}
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center rounded-full border border-indigo-500/30 bg-indigo-500/10 px-3.5 py-1 text-xs font-bold text-indigo-400">
              <span class="flex h-2 w-2 rounded-full bg-blue-400 mr-2 animate-pulse"></span> 100% White-Label Agency Infrastructure
            </div>
            
            <h1 class="text-4xl sm:text-6xl lg:text-6xl font-extrabold tracking-tight leading-[1.1]">
              Start Your Own <br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-blue-400">Hosting Business</span>
            </h1>
            
            <p class="text-base sm:text-lg text-muted-foreground font-medium max-w-xl">
              100% white-labeled reseller hosting with WHM/cPanel. Build your agency or launch your own hosting company effortlessly.
            </p>

            <ul class="space-y-3 text-xs sm:text-sm font-semibold text-foreground">
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-indigo-500/15 text-indigo-400 border border-indigo-500/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>100% White-Labeled WHM/cPanel & Custom Private Nameservers</span>
              </li>
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-indigo-500/15 text-indigo-400 border border-indigo-500/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>Free WHMCS Billing License for automated client management</span>
              </li>
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-indigo-500/15 text-indigo-400 border border-indigo-500/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>LiteSpeed Web Server + Free SSL for all your client accounts</span>
              </li>
            </ul>

            <div class="pt-2 flex flex-col sm:flex-row items-center gap-4">
              <a href="#plans" class="w-full sm:w-auto">
                <Button size="lg" className="w-full h-13 px-8 text-base bg-indigo-600 hover:bg-indigo-500 text-white font-extrabold shadow-xl shadow-indigo-500/25 flex items-center justify-center gap-2">
                  <span>View Reseller Plans</span>
                  <ArrowRight class="w-4 h-4" />
                </Button>
              </a>
              <a href="/contact" class="w-full sm:w-auto">
                <Button size="lg" variant="outline" className="w-full h-13 px-8 text-base font-extrabold hover:bg-indigo-500/10 hover:text-indigo-400 border-border/80">
                  Contact Sales
                </Button>
              </a>
            </div>
          </div>

          {/* Right Column (5 cols) - WHM Dashboard Visual Card */}
          <div class="lg:col-span-5 relative">
            <div class="glass-card rounded-3xl p-7 border border-indigo-500/30 shadow-2xl relative overflow-hidden bg-card/90 backdrop-blur-xl">
              <div class="flex items-center justify-between border-b border-border/60 pb-4 mb-5">
                <div class="flex items-center gap-3">
                  <div class="p-2 rounded-xl bg-indigo-500/20 text-indigo-400">
                    <Layers class="w-4 h-4" />
                  </div>
                  <div>
                    <div class="text-xs font-black text-foreground">WHM Manager v118</div>
                    <div class="text-[10px] text-emerald-400 font-bold">🟢 White-Label Active</div>
                  </div>
                </div>
                <span class="text-[10px] font-black uppercase tracking-wider bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 px-2.5 py-1 rounded-full">
                  WHM / CPANEL
                </span>
              </div>

              <div class="grid grid-cols-2 gap-3 mb-5">
                <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60">
                  <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] font-bold mb-1">
                    <Users class="w-3.5 h-3.5 text-indigo-400" /> Client Accounts
                  </div>
                  <div class="text-lg font-black text-foreground">Unlimited</div>
                </div>

                <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60">
                  <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] font-bold mb-1">
                    <Shield class="w-3.5 h-3.5 text-emerald-400" /> Private DNS
                  </div>
                  <div class="text-xs font-black text-emerald-400">ns1.yourbrand.com</div>
                </div>
              </div>

              <div class="p-4 rounded-2xl bg-gradient-to-r from-indigo-500/15 via-indigo-500/5 to-transparent border border-indigo-500/30 flex items-center justify-between">
                <div>
                  <div class="text-xs font-extrabold text-foreground">Reseller WHM Bundle</div>
                  <div class="text-[11px] text-muted-foreground">Free WHMCS + Unlimited cPanels</div>
                </div>
                <div class="text-right">
                  <div class="text-lg font-black text-indigo-400">$12<span class="text-[10px] font-bold text-muted-foreground">/mo</span></div>
                  <span class="text-[9px] font-black uppercase bg-indigo-500/20 text-indigo-400 px-2 py-0.5 rounded">WHITE-LABEL</span>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <WhmShowcase />

    <section class="py-24" id="plans">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold mb-4">Plans That Adapt to Your Budget</h2>
          <p class="text-muted-foreground">Choose the perfect plan for your needs</p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
          {resellerPlans.map(plan => (
            <PricingCard {...plan} />
          ))}
        </div>

        <ResellerRoiCalculator client:visible />
      </div>
    </section>

    <PlanComparisonTable service="reseller" client:visible />

    <section class="py-24 bg-muted/30">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold mb-4">Why Choose HostingSpell Reseller?</h2>
          <p class="text-muted-foreground">Everything you need to run a successful web hosting company.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {features.map(feature => (
            <FeatureCard {...feature} />
          ))}
        </div>
      </div>
    </section>

    <MigrationBanner />
    
    <section class="py-24">
      <div class="container mx-auto px-4 max-w-3xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold mb-4">Frequently Asked Questions</h2>
          <p class="text-muted-foreground">Find answers to the most common questions about HostingSpell's platform.</p>
        </div>
        <FaqAccordion items={faqs} client:visible />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
