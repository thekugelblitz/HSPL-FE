---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { blogPosts } from '../lib/data';
import { BookOpen, Clock, ArrowRight, Sparkles, Mail } from 'lucide-react';
---

<Layout title="Engineering Blog | HostingSpell - Infrastructure & Web Performance">
  <Navbar />
  <main class="bg-background overflow-hidden">
    {/* Blog Hero */}
    <section class="py-20 bg-grid-pattern border-b border-border/40 relative">
      <div class="container mx-auto px-4 max-w-screen-xl relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-semibold uppercase tracking-wider mb-4">
          <BookOpen class="w-3.5 h-3.5" />
          Engineering & Tutorials
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4">
          HostingSpell Tech Blog
        </h1>
        <p class="text-muted-foreground text-base sm:text-lg max-w-2xl mx-auto">
          Insights, deep-dives, and tutorials on Web Performance, LiteSpeed Enterprise, Core Web Vitals, Linux System Administration, and Cybersecurity.
        </p>
      </div>
    </section>

    {/* Articles Grid */}
    <section class="py-16">
      <div class="container mx-auto px-4 max-w-screen-xl">
        {/* Featured Post Banner */}
        {blogPosts.length > 0 && (
          <div class="glass-card rounded-3xl p-8 lg:p-12 mb-16 glow-card border border-white/10 relative overflow-hidden">
            <div class="grid lg:grid-cols-12 gap-8 items-center">
              <div class="lg:col-span-8 space-y-4">
                <div class="inline-flex items-center gap-2 text-xs font-bold text-primary uppercase tracking-wider">
                  <Sparkles class="w-3.5 h-3.5" />
                  Featured Article • {blogPosts[0].category}
                </div>
                <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-gradient">
                  {blogPosts[0].title}
                </h2>
                <p class="text-muted-foreground text-sm sm:text-base leading-relaxed">
                  {blogPosts[0].excerpt}
                </p>
                <div class="flex items-center gap-4 text-xs text-muted-foreground pt-2">
                  <span>{blogPosts[0].author}</span>
                  <span>•</span>
                  <span>{blogPosts[0].date}</span>
                  <span>•</span>
                  <span class="flex items-center gap-1"><Clock class="w-3 h-3" /> {blogPosts[0].readTime}</span>
                </div>
              </div>
              <div class="lg:col-span-4 flex justify-start lg:justify-end">
                <a 
                  href={`/blog#${blogPosts[0].slug}`}
                  class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-primary text-primary-foreground font-semibold hover:opacity-90 transition-all shadow-lg shadow-primary/20"
                >
                  <span>Read Full Article</span>
                  <ArrowRight class="w-4 h-4" />
                </a>
              </div>
            </div>
          </div>
        )}

        {/* All Posts Grid */}
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {blogPosts.map((post) => (
            <article class="glass-card rounded-2xl p-6 glow-card flex flex-col justify-between transition-all hover:-translate-y-1">
              <div class="space-y-3">
                <div class="text-3xl mb-2">{post.image}</div>
                <div class="text-xs font-bold text-primary uppercase tracking-wider">{post.category}</div>
                <h3 class="font-bold text-xl leading-snug hover:text-primary transition-colors">
                  <a href={`/blog#${post.slug}`}>{post.title}</a>
                </h3>
                <p class="text-xs text-muted-foreground leading-relaxed">
                  {post.excerpt}
                </p>
              </div>

              <div class="pt-6 mt-6 border-t border-border/40 flex items-center justify-between text-xs text-muted-foreground">
                <span>{post.date}</span>
                <span class="flex items-center gap-1 font-medium"><Clock class="w-3 h-3" /> {post.readTime}</span>
              </div>
            </article>
          ))}
        </div>

        {/* Newsletter Subscription Card */}
        <div class="mt-20 glass-card rounded-3xl p-8 sm:p-12 text-center max-w-3xl mx-auto border border-white/10 glow-card">
          <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mx-auto mb-4">
            <Mail class="w-6 h-6" />
          </div>
          <h3 class="text-2xl font-bold mb-2">Subscribe to Tech & Performance Insights</h3>
          <p class="text-xs sm:text-sm text-muted-foreground mb-6 max-w-lg mx-auto">
            Get the latest tutorials on Web Vitals optimization, server security, and cloud hosting tips delivered directly to your inbox once a month.
          </p>
          <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" onsubmit="event.preventDefault(); alert('Thank you for subscribing to HostingSpell Engineering Blog!');">
            <input type="email" required placeholder="Enter your email address" class="flex-1 px-4 py-3 rounded-xl bg-background border border-border text-sm focus:outline-none focus:ring-2 focus:ring-primary/50" />
            <button type="submit" class="px-6 py-3 rounded-xl bg-primary text-primary-foreground font-semibold text-sm hover:opacity-90 transition-all shadow-md shadow-primary/20">
              Subscribe
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
