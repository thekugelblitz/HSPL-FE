---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { blogPosts } from '../lib/data';
import { BookOpen, Clock, ArrowRight, Sparkles, Mail, Check } from 'lucide-react';
---

<Layout title="Engineering Blog | HostingSpell - Infrastructure & Web Performance">
  <Navbar />
  <main class="bg-background overflow-hidden">
    {/* Page Hero - 2-Column Split Hero Layout */}
    <section class="py-20 bg-grid-pattern border-b border-border/40 relative">
      <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center text-left">
          
          {/* Left Column (7 cols) */}
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 text-xs font-bold rounded-full bg-primary/10 border border-primary/20 text-primary uppercase tracking-wider">
              <BookOpen class="w-4 h-4" /> Engineering & Infrastructure Guides
            </div>

            <h1 class="text-4xl sm:text-6xl lg:text-6xl font-extrabold tracking-tight leading-[1.1]">
              HostingSpell <br />
              <span class="text-gradient-primary">Tech Blog</span>
            </h1>

            <p class="text-base sm:text-lg text-muted-foreground font-medium max-w-xl">
              Insights, deep-dives, and tutorials on Web Performance, LiteSpeed Enterprise, Core Web Vitals, Linux System Administration, and Cybersecurity.
            </p>

            <ul class="space-y-3 text-xs sm:text-sm font-semibold text-foreground">
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-primary/15 text-primary border border-primary/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>Deep-dives on LiteSpeed LSCache & Core Web Vitals Optimization</span>
              </li>
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-primary/15 text-primary border border-primary/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>Linux Systems Administration & Node.js/Python Deployment</span>
              </li>
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-primary/15 text-primary border border-primary/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>Cybersecurity Best Practices & Imunify360 WAF Tuning</span>
              </li>
            </ul>

            <div class="pt-2">
              <form class="flex flex-col sm:flex-row gap-3 max-w-md" onsubmit="event.preventDefault(); alert('Thank you for subscribing to HostingSpell Engineering Blog!');">
                <input type="email" required placeholder="Enter your email address" class="flex-1 px-4 py-3 rounded-xl bg-card border border-border text-sm focus:outline-none focus:ring-2 focus:ring-primary/50" />
                <button type="submit" class="px-6 py-3 rounded-xl bg-primary text-primary-foreground font-extrabold text-sm hover:opacity-90 transition-all shadow-md shadow-primary/20">
                  Subscribe
                </button>
              </form>
            </div>
          </div>

          {/* Right Column (5 cols) - Featured Article Visual Card */}
          <div class="lg:col-span-5 relative">
            {blogPosts.length > 0 && (
              <div class="glass-card rounded-3xl p-7 border border-primary/30 shadow-2xl relative overflow-hidden bg-card/90 backdrop-blur-xl">
                <div class="flex items-center justify-between border-b border-border/60 pb-4 mb-4">
                  <div class="flex items-center gap-2 text-xs font-bold text-primary uppercase tracking-wider">
                    <Sparkles class="w-3.5 h-3.5" />
                    <span>Featured Article</span>
                  </div>
                  <span class="text-[10px] font-black uppercase tracking-wider bg-primary/20 text-primary border border-primary/30 px-2.5 py-1 rounded-full">
                    {blogPosts[0].category}
                  </span>
                </div>

                <h3 class="text-xl font-extrabold text-foreground mb-3 leading-snug">
                  {blogPosts[0].title}
                </h3>
                <p class="text-xs text-muted-foreground leading-relaxed mb-5">
                  {blogPosts[0].excerpt}
                </p>

                <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60 flex items-center justify-between text-xs text-muted-foreground font-medium mb-4">
                  <span>{blogPosts[0].author}</span>
                  <span class="flex items-center gap-1 font-bold text-foreground"><Clock class="w-3 h-3 text-emerald-400" /> {blogPosts[0].readTime}</span>
                </div>

                <a 
                  href={`/blog#${blogPosts[0].slug}`}
                  class="w-full py-3 px-4 rounded-xl bg-primary text-primary-foreground font-bold text-xs flex items-center justify-center gap-2 hover:opacity-90 transition-all shadow-md shadow-primary/20"
                >
                  <span>Read Article</span>
                  <ArrowRight class="w-4 h-4" />
                </a>
              </div>
            )}
          </div>

        </div>
      </div>
    </section>

    {/* Articles Grid */}
    <section class="py-16">
      <div class="container mx-auto px-4 max-w-screen-xl">
        {/* All Posts Grid */}
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {blogPosts.map((post) => (
            <article class="glass-card rounded-2xl p-6 glow-card flex flex-col justify-between transition-all hover:-translate-y-1">
              <div class="space-y-3">
                <div class="text-3xl mb-2">{post.image}</div>
                <div class="text-xs font-bold text-primary uppercase tracking-wider">{post.category}</div>
                <h3 class="font-bold text-xl leading-snug hover:text-primary transition-colors">
                  <a href={`/blog#${post.slug}`}>{post.title}</a>
                </h3>
                <p class="text-xs text-muted-foreground leading-relaxed">
                  {post.excerpt}
                </p>
              </div>

              <div class="pt-6 mt-6 border-t border-border/40 flex items-center justify-between text-xs text-muted-foreground">
                <span>{post.date}</span>
                <span class="flex items-center gap-1 font-medium"><Clock class="w-3 h-3" /> {post.readTime}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
