---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { Button } from '../components/ui/button';
import { Users, MessageSquare, Code2, Terminal, Sparkles, Star, Github, Award, Heart, CheckCircle2, ArrowRight } from 'lucide-react';

const communityStats = [
  { metric: "24,000+", label: "Discord Community Members", desc: "Active sysadmins, developers, and site owners sharing tips 24/7." },
  { metric: "1,850+", label: "GitHub Stars", desc: "Across open-source Astro templates, Docker setups, and CLI deployment scripts." },
  { metric: "$500 / mo", label: "Developer Grant Pool", desc: "Monthly micro-grants awarded to community open-source contributors." },
  { metric: "450+", label: "Shared Code Snippets", desc: "Community-contributed Nginx, Apache, and LiteSpeed rule templates." }
];

const openSourceProjects = [
  { title: "Astro High-Speed Starter Kit", stars: "780 Stars", desc: "Production-ready Astro 4.0 template pre-configured with Tailwind CSS v4, Lucide icons, and SEO graph tags." },
  { title: "HostingSpell CLI Deploy Tool", stars: "540 Stars", desc: "Command-line tool for deploying static sites, Node apps, and Docker containers directly to NVMe Cloud in seconds." },
  { title: "LiteSpeed LSCache Rules Pack", stars: "320 Stars", desc: "Curated collection of .htaccess caching rules for WordPress, Magento, Laravel, and Express.js." }
];
---

<Layout 
  title="Developer & Creator Community Hub | HostingSpell Community" 
  description="Connect with 24,000+ developers, sysadmins, and site owners. Explore open-source projects, Discord channels, and the $500 monthly developer grant."
>
  <Navbar />

  <main class="flex-1 bg-[#000000] text-white">
    
    {/* Hero Section */}
    <section class="relative py-24 bg-[#000000] text-center border-b border-zinc-800/80 overflow-hidden">
      <div class="absolute inset-0 bg-blue-500/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
      
      <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs sm:text-sm font-extrabold uppercase tracking-wider mb-6">
          <Users class="w-4 h-4" />
          <span>HostingSpell Community Hub</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight mb-6 leading-tight">
          Where Developers & Creators <br />
          <span class="bg-gradient-to-r from-blue-400 via-indigo-300 to-sky-300 bg-clip-text text-transparent">Connect, Build & Scale Together.</span>
        </h1>

        <p class="text-zinc-300 text-base sm:text-lg max-w-3xl mx-auto leading-relaxed font-medium">
          Join our vibrant community of sysadmins, web architects, and digital creators. Exchange ideas, get rapid troubleshooting advice, and collaborate on cloud projects.
        </p>

        <div class="mt-8 flex justify-center gap-4">
          <a href="https://discord.gg" target="_blank" rel="noopener noreferrer">
            <Button size="lg" className="h-13 px-8 bg-[#0073EC] hover:bg-[#005bb5] text-white font-extrabold text-base rounded-xl shadow-xl shadow-blue-500/25 flex items-center gap-2">
              <MessageSquare class="w-5 h-5" />
              <span>Join Official Discord Server (24k+ Members)</span>
            </Button>
          </a>
        </div>
      </div>
    </section>

    {/* Community Metrics */}
    <section class="py-20 bg-[#000000]">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {communityStats.map(s => (
            <div class="p-7 rounded-3xl bg-zinc-950 border border-zinc-800 text-center space-y-2">
              <div class="text-4xl sm:text-5xl font-black text-blue-400">{s.metric}</div>
              <div class="text-sm font-extrabold text-white">{s.label}</div>
              <p class="text-xs text-zinc-400 leading-relaxed font-medium">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Open Source Projects Grid */}
    <section class="py-24 bg-[#000000] border-t border-zinc-800/80">
      <div class="container mx-auto px-4 max-w-screen-xl space-y-16">
        
        <div class="text-center max-w-3xl mx-auto space-y-4">
          <h2 class="text-3xl sm:text-5xl font-extrabold text-white">Featured Open Source Repositories</h2>
          <p class="text-zinc-400 text-base font-medium">Free open-source tools and starter kits maintained by HostingSpell engineers.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {openSourceProjects.map(proj => (
            <div class="p-8 rounded-3xl bg-zinc-950 border border-zinc-800 space-y-4 flex flex-col justify-between hover:border-purple-500/40 transition">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <div class="p-3 rounded-2xl bg-purple-500/15 text-purple-400 w-fit">
                    <Code2 class="w-6 h-6" />
                  </div>
                  <span class="text-xs font-bold text-amber-400 flex items-center gap-1 bg-amber-500/10 px-2.5 py-0.5 rounded-full border border-amber-500/20">
                    <Star class="w-3.5 h-3.5 fill-amber-400" /> {proj.stars}
                  </span>
                </div>

                <h3 class="text-xl font-extrabold text-white">{proj.title}</h3>
                <p class="text-xs text-zinc-400 leading-relaxed font-medium">{proj.desc}</p>
              </div>

              <a href="https://github.com" target="_blank" rel="noopener" class="text-xs font-extrabold text-blue-400 hover:underline flex items-center gap-1">
                <span>View Repository on GitHub</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>
          ))}
        </div>

      </div>
    </section>

    {/* Developer Micro-Grant Program */}
    <section class="py-24 bg-[#000000] border-t border-zinc-800/80">
      <div class="container mx-auto px-4 max-w-screen-md text-center">
        <div class="p-8 sm:p-10 rounded-3xl bg-zinc-950 border border-blue-500/30 space-y-4 shadow-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/15 text-blue-400 text-xs font-bold border border-blue-500/30">
            <Sparkles class="w-3.5 h-3.5" /> Monthly $500 Open-Source Micro-Grant
          </div>
          <h3 class="text-2xl font-extrabold text-white">We Fund Open-Source Creators</h3>
          <p class="text-xs text-zinc-400 leading-relaxed max-w-lg mx-auto font-medium">
            Every month, HostingSpell awards $500 micro-grants and free enterprise cloud infrastructure to developers creating valuable open-source web tools, Astro components, or Docker utilities.
          </p>
          <a href="mailto:grants@hostingspell.com" class="inline-block font-extrabold text-blue-400 hover:underline text-sm">
            Apply For Open Source Grant &rarr;
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
