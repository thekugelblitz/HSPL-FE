---
// src/pages/vps.astro
// VPS product page — Transformation framework
// High-ticket page: includes FloatingLeadWidget for proactive sales (CRO doc #19)

import ProductPageTemplate from '../layouts/ProductPageTemplate.astro';
import FloatingLeadWidget from '../components/blocks/FloatingLeadWidget.astro';
import VpsDashboardShowcase from '../components/blocks/VpsDashboardShowcase.astro';
import ValueStack from '../components/blocks/ValueStack.astro';
import { InteractivePricingGrid } from '../components/pricing/InteractivePricingGrid';
import { PLANS_VPS_HOSTING } from '../lib/pricing/vpsPlans';
import { VPS_PROVIDER_LOCATIONS, GLOBAL_BILLING_CYCLES } from '../lib/pricing/constants';
import { faqs } from '../lib/data';
import { Terminal, Shield, Cpu } from 'lucide-react';

const vpsFaqs = faqs.slice(0, 5);
---

<ProductPageTemplate
  title="KVM VPS Hosting — Full Root Access, Zero Compromises | HostingSpell"
  description="Isolated KVM VPS servers with full root SSH access, NVMe SSDs, Virtualizor panel, and 39+ 1-click apps. Starting at $10/mo."
  heroTag="KVM VPS Servers"
  heroHeadline='Full Root Access.<br /><span class="bg-gradient-to-r from-purple-500 via-indigo-500 to-primary dark:from-purple-400 dark:via-indigo-400 dark:to-blue-400 bg-clip-text text-transparent">Zero Compromises.</span>'
  heroSubheadline="Your own isolated server with dedicated CPU, RAM, and NVMe storage. Full SSH root access, your choice of OS, and 39+ 1-click deployment apps."
  heroCtaText="View VPS Plans"
  heroCtaHref="#plans"
  heroCheckpoints={[
    "Isolated KVM hypervisor with dedicated resources",
    "Full root SSH access with Virtualizor control panel",
    "39+ 1-click apps: Dokploy, Supabase, WireGuard & more",
  ]}
  heroPriceAnchor="Starting at $10/mo • Instant provisioning in under 60 seconds"
  faqs={vpsFaqs}
>
  
  {/* ─── Slot: Outcomes ─── */}
  <section slot="outcomes" class="py-20 border-b border-border/40">
    <div class="container mx-auto px-4 max-w-screen-xl">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-extrabold tracking-tight mb-3">Why Developers Choose HostingSpell VPS</h2>
        <p class="text-muted-foreground">Isolated resources, full control, instant deployment.</p>
      </div>

      <div class="grid sm:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border/60 bg-card/60 p-7 text-center space-y-4 hover:border-purple-500/40 transition-colors">
          <div class="p-3 bg-purple-500/10 text-purple-500 rounded-xl w-fit mx-auto">
            <Terminal className="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">Full Root Control</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">SSH access, your choice of OS (Ubuntu, AlmaLinux, Debian), install anything you want. It's your server.</p>
        </div>

        <div class="rounded-2xl border border-border/60 bg-card/60 p-7 text-center space-y-4 hover:border-purple-500/40 transition-colors">
          <div class="p-3 bg-purple-500/10 text-purple-500 rounded-xl w-fit mx-auto">
            <Cpu className="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">Guaranteed Resources</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">KVM isolation means your CPU and RAM are never shared. Consistent performance under any load.</p>
        </div>

        <div class="rounded-2xl border border-border/60 bg-card/60 p-7 text-center space-y-4 hover:border-purple-500/40 transition-colors">
          <div class="p-3 bg-purple-500/10 text-purple-500 rounded-xl w-fit mx-auto">
            <Shield className="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">39+ 1-Click Apps</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">Deploy Dokploy, Open WebUI, Supabase, WireGuard, WordPress, and more in under 60 seconds.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ─── Slot: Pricing ─── */}
  <section slot="pricing" class="py-20 bg-muted/10" id="plans">
    <div class="container mx-auto px-4 max-w-screen-xl">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-bold mb-2">VPS Server Plans</h2>
        <p class="text-sm text-muted-foreground">Select your datacenter region and billing cycle. All plans include root SSH access.</p>
      </div>

      <InteractivePricingGrid
        client:load
        plans={PLANS_VPS_HOSTING}
        locations={VPS_PROVIDER_LOCATIONS}
        billingCycles={GLOBAL_BILLING_CYCLES.vpshosting}
      />

      <div class="mt-6 text-center">
        <a href="/dedicated-servers" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline">
          Need more power? View Dedicated Servers →
        </a>
      </div>
    </div>
  </section>

  {/* ─── Slot: Details ─── */}
  <section slot="details" class="py-16 border-t border-border/40">
    <div class="container mx-auto px-4 max-w-screen-xl">
      <details class="group">
        <summary class="cursor-pointer text-sm font-semibold text-primary flex items-center gap-2 hover:underline py-4">
          <span>View Virtualizor Dashboard & Management Features</span>
          <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <VpsDashboardShowcase />
      </details>
    </div>
  </section>

  {/* FloatingLeadWidget on high-ticket VPS page (CRO doc #19: proactive sales trigger) */}
  <FloatingLeadWidget />

</ProductPageTemplate>
