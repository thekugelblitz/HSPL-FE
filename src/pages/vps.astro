---
import { Button } from "@/components/ui/button";
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import PricingCard from '../components/blocks/PricingCard.astro';
import FeatureCard from '../components/blocks/FeatureCard.astro';
import DatacenterMap from '../components/blocks/DatacenterMap.astro';
import { FaqAccordion } from '../components/blocks/FaqAccordion';
import { PlanComparisonTable } from '../components/blocks/PlanComparisonTable';
import { vpsPlans, faqs } from '../lib/data';
import VpsDashboardShowcase from '../components/blocks/VpsDashboardShowcase.astro';
import { Check, Terminal, Server, Shield, Cpu, Zap, ArrowRight, HardDrive } from 'lucide-react';

const features = [
  {
    title: "Dedicated Resources",
    description: "Enjoy isolated resources with KVM virtualization for consistent and predictable performance.",
    icon: "Server" as const
  },
  {
    title: "Full Root Access",
    description: "Total control over your hosting environment with SSH and full root permissions.",
    icon: "Shield" as const
  },
  {
    title: "NVMe Storage",
    description: "Experience blazing fast I/O speeds with enterprise-grade NVMe solid-state drives.",
    icon: "Zap" as const
  },
  {
    title: "Instant Provisioning",
    description: "Your server is deployed and ready for configuration within minutes of checkout.",
    icon: "RefreshCw" as const
  }
];
---

<Layout 
  title="VPS Hosting - Powerful yet Affordable VPS Hosting | HostingSpell India"
  description="Enjoy isolated, high-performance VPS hosting solutions with dedicated resources ideal for websites and apps needing reliable control and scalability."
>
  <Navbar />
  <main class="flex-1 bg-[#000000] text-white">
    {/* Page Hero - 2-Column Split Hero Layout */}
    <section class="relative bg-[#000000] text-white pt-20 pb-24 border-b border-zinc-800/80 overflow-hidden">
      <div class="absolute inset-0 bg-purple-500/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
      <div class="absolute top-0 left-0 w-96 h-96 bg-purple-500/20 rounded-full blur-[120px] pointer-events-none"></div>
      <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-indigo-600/15 rounded-full blur-[110px] pointer-events-none"></div>
      
      <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center text-left">
          
          {/* Left Column (7 cols) */}
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center rounded-full border border-purple-500/30 bg-purple-500/10 px-3.5 py-1 text-xs font-bold text-purple-400">
              <span class="flex h-2 w-2 rounded-full bg-purple-400 mr-2 animate-pulse"></span> Developer-Centric Infrastructure
            </div>
            
            <h1 class="text-4xl sm:text-6xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] text-white">
              Virtual Private Servers <br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-indigo-400 to-emerald-400">Total SSH Control</span>
            </h1>
            
            <p class="text-base sm:text-lg text-zinc-300 font-medium max-w-xl">
              Full root access, guaranteed resources, and KVM virtualization for developers and enterprises who need unthrottled control.
            </p>

            <ul class="space-y-3 text-xs sm:text-sm font-semibold text-white">
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-purple-500/15 text-purple-400 border border-purple-500/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>Dedicated KVM Hypervisors & Full Root Access</span>
              </li>
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-purple-500/15 text-purple-400 border border-purple-500/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>10Gbps Network Uplink with Anti-DDoS Protection</span>
              </li>
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-purple-500/15 text-purple-400 border border-purple-500/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>1-Click OS & 39+ VPS Application Marketplace</span>
              </li>
            </ul>

            <div class="pt-2 flex flex-col sm:flex-row items-center gap-4">
              <a href="#plans" class="w-full sm:w-auto">
                <Button size="lg" className="w-full h-13 px-8 text-base bg-purple-600 hover:bg-purple-500 text-white font-extrabold shadow-xl shadow-purple-500/25 flex items-center justify-center gap-2">
                  <span>View VPS Plans</span>
                  <ArrowRight class="w-4 h-4" />
                </Button>
              </a>
              <a href="/vps/apps" class="w-full sm:w-auto">
                <Button size="lg" variant="outline" className="w-full h-13 px-8 text-base font-extrabold hover:bg-purple-500/10 hover:text-purple-400 border-zinc-800 bg-[#141518] text-white">
                  1-Click Apps Marketplace
                </Button>
              </a>
            </div>
          </div>

          {/* Right Column (5 cols) - Terminal & Hypervisor Visual Card */}
          <div class="lg:col-span-5 relative">
            <div class="rounded-3xl p-7 border border-purple-500/30 shadow-2xl relative overflow-hidden bg-[#141518]">
              <div class="flex items-center justify-between border-b border-zinc-800 pb-4 mb-5">
                <div class="flex items-center gap-3">
                  <div class="p-2 rounded-xl bg-purple-500/20 text-purple-400">
                    <Terminal class="w-4 h-4" />
                  </div>
                  <div>
                    <div class="text-xs font-black text-white">root@vps-node-01:~#</div>
                    <div class="text-[10px] text-emerald-400 font-bold">🟢 KVM Hypervisor Online</div>
                  </div>
                </div>
                <span class="text-[10px] font-black uppercase tracking-wider bg-purple-500/20 text-purple-400 border border-purple-500/30 px-2.5 py-1 rounded-full">
                  ROOT SSH
                </span>
              </div>

              <div class="grid grid-cols-2 gap-3 mb-5">
                <div class="p-3.5 rounded-2xl bg-zinc-900 border border-zinc-800">
                  <div class="flex items-center gap-1.5 text-zinc-400 text-[10px] font-bold mb-1">
                    <Cpu class="w-3.5 h-3.5 text-purple-400" /> Virtualizor KVM
                  </div>
                  <div class="text-lg font-black text-white">Dedicated CPU</div>
                </div>

                <div class="p-3.5 rounded-2xl bg-zinc-900 border border-zinc-800">
                  <div class="flex items-center gap-1.5 text-zinc-400 text-[10px] font-bold mb-1">
                    <HardDrive class="w-3.5 h-3.5 text-indigo-400" /> NVMe Storage
                  </div>
                  <div class="text-lg font-black text-white">Enterprise SSD</div>
                </div>
              </div>

              <div class="p-4 rounded-2xl bg-gradient-to-r from-purple-500/15 via-purple-500/5 to-transparent border border-purple-500/30 flex items-center justify-between">
                <div>
                  <div class="text-xs font-extrabold text-white">High-Perf KVM VPS</div>
                  <div class="text-[11px] text-zinc-400">Full Root Access + Instant Deploy</div>
                </div>
                <div class="text-right">
                  <div class="text-lg font-black text-purple-400">$10<span class="text-[10px] font-bold text-zinc-400">/mo</span></div>
                  <span class="text-[9px] font-black uppercase bg-purple-500/20 text-purple-400 px-2 py-0.5 rounded">FULL CONTROL</span>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <VpsDashboardShowcase />

    <section class="py-24 bg-[#000000]" id="plans">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-extrabold text-white mb-4">Choose the perfect plan for your needs</h2>
          <p class="text-zinc-400">Easily evaluate features, pricing, and benefits across all VPS hosting plans.</p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
          {vpsPlans.map(plan => (
            <PricingCard {...plan} />
          ))}
        </div>
      </div>
    </section>

    <PlanComparisonTable service="vps" client:visible />

    <DatacenterMap />

    <section class="py-24 bg-[#000000] border-t border-zinc-800/80">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-extrabold text-white mb-4">VPS Features</h2>
          <p class="text-zinc-400">Everything you need to build and scale your infrastructure.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {features.map(feature => (
            <FeatureCard {...feature} />
          ))}
        </div>
      </div>
    </section>
    
    <section class="py-24 bg-[#000000] border-t border-zinc-800/80">
      <div class="container mx-auto px-4 max-w-3xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-extrabold text-white mb-4">Frequently Asked Questions</h2>
          <p class="text-zinc-400">Find answers to the most common questions about HostingSpell's platform.</p>
        </div>
        <FaqAccordion items={faqs} client:visible />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
