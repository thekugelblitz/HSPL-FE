---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { Mail, Phone, MapPin, Clock, MessageSquare, ShieldAlert, CreditCard, Send, CheckCircle2, Check, Headphones } from 'lucide-react';

const departments = [
  {
    icon: MessageSquare,
    title: "Technical Support",
    email: "support@hostingspell.com",
    availability: "24/7/365 • Avg response < 15 mins",
    link: "https://manage.hostingspell.com/submitticket.php?step=2&deptid=1"
  },
  {
    icon: Phone,
    title: "Sales & Pre-Purchase",
    email: "sales@hostingspell.com",
    availability: "Mon - Sat: 9 AM - 8 PM IST",
    link: "https://manage.hostingspell.com/submitticket.php?step=2&deptid=2"
  },
  {
    icon: CreditCard,
    title: "Billing & Invoices",
    email: "billing@hostingspell.com",
    availability: "Mon - Fri: 9 AM - 6 PM IST",
    link: "https://manage.hostingspell.com/submitticket.php?step=2&deptid=3"
  },
  {
    icon: ShieldAlert,
    title: "Abuse & Compliance",
    email: "abuse@hostingspell.com",
    availability: "Strict 24h Review SLA",
    link: "mailto:abuse@hostingspell.com"
  }
];
---

<Layout title="Contact Us | HostingSpell - 24/7 Expert Support">
  <Navbar />
  <main class="bg-background overflow-hidden">
    {/* Page Hero - 2-Column Split Hero Layout */}
    <section class="py-20 bg-grid-pattern border-b border-border/40 relative">
      <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center text-left">
          
          {/* Left Column (7 cols) */}
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 text-xs font-bold rounded-full bg-primary/10 border border-primary/20 text-primary uppercase tracking-wider">
              <Clock class="w-4 h-4 text-emerald-400" /> Always Available 24/7/365
            </div>

            <h1 class="text-4xl sm:text-6xl lg:text-6xl font-extrabold tracking-tight leading-[1.1]">
              How Can We Help <br />
              <span class="text-gradient-primary">You Today?</span>
            </h1>

            <p class="text-base sm:text-lg text-muted-foreground font-medium max-w-xl">
              Have questions about our cloud hosting plans or need help migrating your site? Our expert engineers are here 24 hours a day.
            </p>

            <ul class="space-y-3 text-xs sm:text-sm font-semibold text-foreground">
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-primary/15 text-primary border border-primary/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>Average Support Ticket Response &lt; 15 Minutes</span>
              </li>
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-primary/15 text-primary border border-primary/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>24/7 L2/L3 Linux Systems Engineers On Call</span>
              </li>
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-primary/15 text-primary border border-primary/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>Free Zero-Downtime Migration Support & Pre-Sales Guidance</span>
              </li>
            </ul>

            <div class="pt-2 flex items-center gap-4">
              <a href="tel:+919409594000" class="px-6 py-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-extrabold text-xs flex items-center gap-2">
                <Phone class="w-4 h-4" />
                <span>Sales Hotline: +91 94095 94000</span>
              </a>
            </div>
          </div>

          {/* Right Column (5 cols) - Live Helpdesk Visual Card */}
          <div class="lg:col-span-5 relative">
            <div class="glass-card rounded-3xl p-7 border border-primary/30 shadow-2xl relative overflow-hidden bg-card/90 backdrop-blur-xl">
              <div class="flex items-center justify-between border-b border-border/60 pb-4 mb-5">
                <div class="flex items-center gap-3">
                  <div class="p-2 rounded-xl bg-primary/20 text-primary">
                    <Headphones class="w-4 h-4" />
                  </div>
                  <div>
                    <div class="text-xs font-black text-foreground">HostingSpell Helpdesk</div>
                    <div class="text-[10px] text-emerald-400 font-bold">🟢 Support Engineers Online</div>
                  </div>
                </div>
                <span class="text-[10px] font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-2.5 py-1 rounded-full">
                  24/7 SLA
                </span>
              </div>

              <div class="grid grid-cols-2 gap-3 mb-5">
                <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60">
                  <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] font-bold mb-1">
                    <Clock class="w-3.5 h-3.5 text-emerald-400" /> SLA Target
                  </div>
                  <div class="text-lg font-black text-emerald-400">&lt; 15 mins</div>
                </div>

                <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60">
                  <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] font-bold mb-1">
                    <Mail class="w-3.5 h-3.5 text-blue-400" /> Support Email
                  </div>
                  <div class="text-xs font-black text-foreground">support@hostingspell.com</div>
                </div>
              </div>

              <div class="p-4 rounded-2xl bg-gradient-to-r from-primary/15 via-primary/5 to-transparent border border-primary/30 flex items-center justify-between">
                <div>
                  <div class="text-xs font-extrabold text-foreground">Client Portal Desk</div>
                  <div class="text-[11px] text-muted-foreground">Submit Ticket via Portal</div>
                </div>
                <a href="https://manage.hostingspell.com/submitticket.php" target="_blank" rel="noopener" class="text-xs font-bold text-primary hover:underline">Open Ticket &rarr;</a>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    {/* Departments Grid */}
    <section class="py-16 border-b border-border/40">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
          {departments.map((dept) => (
            <div class="glass-card rounded-2xl p-6 glow-card flex flex-col justify-between">
              <div>
                <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-4">
                  <dept.icon class="w-5 h-5" />
                </div>
                <h3 class="font-bold text-lg mb-1">{dept.title}</h3>
                <p class="text-xs text-emerald-400 font-medium mb-3">{dept.availability}</p>
                <p class="text-xs text-muted-foreground font-mono mb-4">{dept.email}</p>
              </div>
              <a 
                href={dept.link} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-secondary hover:bg-primary hover:text-primary-foreground text-xs font-semibold transition-all border border-border"
              >
                <span>Submit Ticket</span>
              </a>
            </div>
          ))}
        </div>

        {/* Contact Form & Info Grid */}
        <div class="grid lg:grid-cols-12 gap-12 items-start">
          <div class="lg:col-span-7 glass-card p-8 rounded-3xl glow-card border border-white/10">
            <h2 class="text-2xl font-bold mb-2">Send Us a Direct Message</h2>
            <p class="text-xs text-muted-foreground mb-6">Fill out the form below and our support team will get back to you within 15 minutes.</p>

            <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you for your message! Our support team will reply to your email shortly.');">
              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold mb-1.5">Your Full Name</label>
                  <input type="text" required placeholder="John Doe" class="w-full px-4 py-2.5 rounded-xl bg-background border border-border text-sm focus:outline-none focus:ring-2 focus:ring-primary/50" />
                </div>
                <div>
                  <label class="block text-xs font-semibold mb-1.5">Your Email Address</label>
                  <input type="email" required placeholder="john@example.com" class="w-full px-4 py-2.5 rounded-xl bg-background border border-border text-sm focus:outline-none focus:ring-2 focus:ring-primary/50" />
                </div>
              </div>

              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold mb-1.5">Department</label>
                  <select class="w-full px-4 py-2.5 rounded-xl bg-background border border-border text-sm focus:outline-none focus:ring-2 focus:ring-primary/50">
                    <option>Technical Support</option>
                    <option>Sales & Pre-Purchase</option>
                    <option>Billing & Refunds</option>
                    <option>Free Migration Inquiry</option>
                  </select>
                </div>
                <div>
                  <label class="block text-xs font-semibold mb-1.5">Phone Number (Optional)</label>
                  <input type="tel" placeholder="+1 (555) 000-0000" class="w-full px-4 py-2.5 rounded-xl bg-background border border-border text-sm focus:outline-none focus:ring-2 focus:ring-primary/50" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold mb-1.5">Subject</label>
                <input type="text" required placeholder="Inquiry about Cloud Hosting MARS Plan" class="w-full px-4 py-2.5 rounded-xl bg-background border border-border text-sm focus:outline-none focus:ring-2 focus:ring-primary/50" />
              </div>

              <div>
                <label class="block text-xs font-semibold mb-1.5">Message</label>
                <textarea rows="4" required placeholder="How can we help you?" class="w-full px-4 py-2.5 rounded-xl bg-background border border-border text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 resize-none"></textarea>
              </div>

              <button type="submit" class="w-full py-3.5 px-6 rounded-xl bg-primary text-primary-foreground font-semibold text-sm hover:opacity-90 transition-all flex items-center justify-center gap-2 shadow-lg shadow-primary/20">
                <Send class="w-4 h-4" />
                <span>Send Message</span>
              </button>
            </form>
          </div>

          {/* Direct Phone & Office Details */}
          <div class="lg:col-span-5 space-y-6">
            <div class="glass-card p-6 rounded-2xl glow-card space-y-4">
              <h3 class="font-bold text-lg flex items-center gap-2">
                <Phone class="w-5 h-5 text-primary" />
                <span>Direct Phone Support</span>
              </h3>
              <p class="text-xs text-muted-foreground">Prefer to speak directly with an expert advisor?</p>
              <div class="p-3 rounded-xl bg-muted/40 font-mono font-bold text-base text-primary">
                +91 94095 94000
              </div>
            </div>

            <div class="glass-card p-6 rounded-2xl glow-card space-y-4">
              <h3 class="font-bold text-lg flex items-center gap-2">
                <MapPin class="w-5 h-5 text-primary" />
                <span>Registered Operations</span>
              </h3>
              <p class="text-xs text-muted-foreground leading-relaxed">
                HostingSpell Cloud Infrastructure Division<br />
                Global Datacenters: Ashburn (US), Mumbai (IN), Frankfurt (DE), Singapore (SG)
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 space-y-2">
              <div class="flex items-center gap-2 font-bold text-sm">
                <CheckCircle2 class="w-4 h-4" />
                <span>Supercharged Response SLA</span>
              </div>
              <p class="text-xs leading-relaxed text-emerald-300/90">
                All critical support tickets submitted via the client portal receive guaranteed initial response within 15 minutes by an L2/L3 Linux System Administrator.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
