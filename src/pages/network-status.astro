---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { networkStatusData } from '../lib/data';
import { Activity, ShieldCheck, CheckCircle2, Clock, AlertTriangle, RefreshCw } from 'lucide-react';
---

<Layout title="Network Status | HostingSpell Infrastructure Dashboard">
  <Navbar />
  <main class="bg-background overflow-hidden">
    {/* Header Status Banner */}
    <section class="py-20 bg-grid-pattern border-b border-border/40 relative">
      <div class="container mx-auto px-4 max-w-screen-xl relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>Global Network Operational</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4">
          Real-Time System & Infrastructure Status
        </h1>
        <p class="text-muted-foreground text-base sm:text-lg max-w-xl mx-auto">
          Live operational status of HostingSpell web servers, databases, control panels, Anycast DNS, and security firewalls.
        </p>

        <div class="flex items-center justify-center gap-6 mt-8 text-xs font-medium">
          <div class="flex items-center gap-2">
            <span class="text-muted-foreground">Global Uptime:</span>
            <span class="text-emerald-400 font-bold font-mono">{networkStatusData.uptime}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-muted-foreground">Last Checked:</span>
            <span class="text-foreground font-mono">{networkStatusData.lastUpdated}</span>
          </div>
        </div>
      </div>
    </section>

    {/* Live Services Matrix */}
    <section class="py-16 border-b border-border/40">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
          <Activity class="w-5 h-5 text-primary" />
          <span>Core Infrastructure Services</span>
        </h2>

        <div class="grid md:grid-cols-2 gap-4">
          {networkStatusData.services.map((srv) => (
            <div class="glass-card rounded-2xl p-5 glow-card flex items-center justify-between border border-border/40">
              <div class="space-y-1">
                <h3 class="font-bold text-sm">{srv.name}</h3>
                <span class="text-xs text-muted-foreground font-mono">Response latency: {srv.responseTime}</span>
              </div>
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                <CheckCircle2 class="w-3.5 h-3.5" />
                <span>{srv.status}</span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Incident History & Maintenance Log */}
    <section class="py-16">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
          <Clock class="w-5 h-5 text-primary" />
          <span>Past Maintenance & Incident Logs</span>
        </h2>

        <div class="space-y-4 max-w-4xl">
          {networkStatusData.incidents.map((inc) => (
            <div class="glass-card rounded-2xl p-6 glow-card space-y-3">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-xs font-mono text-muted-foreground">{inc.date}</span>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20">
                  {inc.status}
                </span>
              </div>
              <h3 class="font-bold text-base">{inc.title}</h3>
              <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
                {inc.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
