---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { Error404Widget } from '../components/blocks/Error404Widget';
---

<Layout title="404 Page Not Found | HostingSpell" description="The requested page or URL does not exist on our global datacenter cluster routing tables.">
  <Navbar />

  <main style="background-color: #07080A !important; color: #FFFFFF !important;" class="min-h-[85vh] relative overflow-hidden flex items-center justify-center py-16 px-4">
    {/* Ambient Glow & Mesh Background */}
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-gradient-to-tr from-blue-600/25 via-indigo-600/20 to-purple-600/25 blur-[130px] pointer-events-none rounded-full"></div>
    <div class="absolute inset-0 bg-[radial-gradient(#334155_1px,transparent_1px)] [background-size:24px_24px] opacity-30 pointer-events-none"></div>

    <Error404Widget client:load />
  </main>

  <Footer />
</Layout>
