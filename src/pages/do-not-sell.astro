---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { Button } from '../components/ui/button';
import { ShieldCheck, Lock, CheckCircle2, EyeOff } from 'lucide-react';

const privacyRights = [
  { title: "Right to Opt-Out of Data Sales & Sharing", desc: "HostingSpell does not sell personal data for monetary value. You have the right to direct us not to share your data for cross-context behavioral advertising." },
  { title: "Right to Know & Access", desc: "You have the right to request details regarding the categories and specific pieces of personal information we have collected about you." },
  { title: "Right to Deletion", desc: "You have the right to request deletion of your personal data, subject to legal data retention obligations for tax and domain registry compliance." },
  { title: "Non-Discrimination Guarantee", desc: "We will never deny services, charge different prices, or degrade performance quality if you exercise your privacy rights." }
];
---

<Layout 
  title="Do Not Sell or Share My Personal Information | HostingSpell CCPA" 
  description="CCPA / CPRA Privacy Preference Portal. Manage your telemetry preferences and opt-out of personal information processing under California privacy laws."
>
  <Navbar />

  <main class="flex-1 bg-[#000000] text-white">
    
    {/* Hero Section */}
    <section class="relative py-24 bg-[#000000] text-center border-b border-zinc-800/80 overflow-hidden">
      <div class="absolute inset-0 bg-blue-500/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
      
      <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs sm:text-sm font-extrabold uppercase tracking-wider mb-6">
          <EyeOff class="w-4 h-4" />
          <span>CCPA / CPRA Privacy Rights</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight mb-6 leading-tight">
          Do Not Sell or Share <br />
          <span class="bg-gradient-to-r from-blue-400 via-indigo-300 to-sky-300 bg-clip-text text-transparent">My Personal Information.</span>
        </h1>

        <p class="text-zinc-300 text-base sm:text-lg max-w-3xl mx-auto leading-relaxed font-medium">
          Under the California Consumer Privacy Act (CCPA) and CPRA, residents have the right to opt out of the sale or sharing of their personal information.
        </p>
      </div>
    </section>

    {/* Privacy Rights Breakdown */}
    <section class="py-24 bg-[#000000]">
      <div class="container mx-auto px-4 max-w-screen-xl space-y-16">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {privacyRights.map(r => (
            <div class="p-8 rounded-3xl bg-zinc-950 border border-zinc-800 space-y-3">
              <div class="p-3 rounded-xl bg-blue-500/15 text-blue-400 w-fit">
                <CheckCircle2 class="w-6 h-6" />
              </div>
              <h3 class="text-xl font-extrabold text-white">{r.title}</h3>
              <p class="text-xs text-zinc-400 leading-relaxed font-medium">{r.desc}</p>
            </div>
          ))}
        </div>

        {/* Form Container */}
        <div class="max-w-screen-md mx-auto p-8 sm:p-10 rounded-3xl bg-zinc-950 border border-zinc-800 space-y-6 shadow-2xl">
          <div class="space-y-2 text-center">
            <h2 class="text-2xl font-extrabold text-white">Privacy Opt-Out Request Form</h2>
            <p class="text-xs text-zinc-400 font-medium">Submit this request to register your privacy preferences across HostingSpell platforms.</p>
          </div>
          
          <form class="space-y-4">
            <div>
              <label class="block text-xs font-bold text-zinc-300 mb-1">Full Legal Name</label>
              <input type="text" placeholder="John Doe" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-xs text-white placeholder:text-zinc-500 focus:outline-none focus:border-blue-500" />
            </div>

            <div>
              <label class="block text-xs font-bold text-zinc-300 mb-1">Account Email Address</label>
              <input type="email" placeholder="you@domain.com" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-xs text-white placeholder:text-zinc-500 focus:outline-none focus:border-blue-500" />
            </div>

            <div class="p-4 rounded-2xl bg-blue-500/10 border border-blue-500/20 text-xs text-zinc-300">
              <span class="font-extrabold text-blue-400">Notice:</span> Submitting this form instructs HostingSpell to block third-party analytics telemetry, disable targeted ad pixel cookies, and opt out of cross-context behavioral sharing.
            </div>

            <Button className="w-full py-4 bg-[#0073EC] hover:bg-[#005bb5] text-white font-extrabold text-xs rounded-xl shadow-lg shadow-blue-500/20">
              Submit Privacy Opt-Out Request &rarr;
            </Button>
          </form>
        </div>

      </div>
    </section>

  </main>

  <Footer />
</Layout>
