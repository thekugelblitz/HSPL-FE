---
// src/pages/cloud-hosting.astro
// Cloud Hosting product page — Transformation framework
// 5-section layout via ProductPageTemplate: Hero → Outcomes → Pricing → Details → Guarantee

import ProductPageTemplate from '../layouts/ProductPageTemplate.astro';
import InteractiveSpeedTest from '../components/blocks/InteractiveSpeedTest.astro';
import CpanelShowcase from '../components/blocks/CpanelShowcase.astro';
import ValueStack from '../components/blocks/ValueStack.astro';
import { InteractivePricingGrid } from '../components/pricing/InteractivePricingGrid';
import { PLANS_CLOUD_HOSTING } from '../lib/pricing/cloudPlans';
import { CLOUD_PROVIDER_LOCATIONS, GLOBAL_BILLING_CYCLES } from '../lib/pricing/constants';
import { faqs } from '../lib/data';
import { Zap, Shield, Headphones } from 'lucide-react';

const cloudFaqs = faqs.slice(0, 5);
---

<ProductPageTemplate
  title="Cloud Hosting — Your Site Loads in Under 1 Second | HostingSpell"
  description="Ultra-fast NVMe cloud hosting with LiteSpeed Enterprise, cPanel, free SSL, and 24/7 human support. Starting at $1.29/mo."
  heroTag="Cloud NVMe Hosting"
  heroHeadline='Your Site Loads in <span class="bg-gradient-to-r from-primary via-blue-600 to-indigo-600 dark:from-blue-400 dark:via-indigo-400 dark:to-sky-400 bg-clip-text text-transparent">Under 1 Second.</span>'
  heroSubheadline="While your competitors wait 4 seconds for their pages to load, your visitors are already buying. LiteSpeed Enterprise + NVMe SSDs deliver 10× faster response times."
  heroCtaText="See Cloud Plans"
  heroCtaHref="#plans"
  heroCheckpoints={[
    "10× Faster LiteSpeed Enterprise with LSCache",
    "Free SSL, Imunify360 AI Security & Daily Backups",
    "Free Zero-Downtime Migration — done in under 2 hours",
  ]}
  heroPriceAnchor="Starting at $1.29/mo • 30-Day Money-Back Guarantee"
  faqs={cloudFaqs}
>
  
  {/* ─── Slot: Outcomes (3 Key Results) ─── */}
  <section slot="outcomes" class="py-20 border-b border-border/40">
    <div class="container mx-auto px-4 max-w-screen-xl">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-extrabold tracking-tight mb-3">What You Get</h2>
        <p class="text-muted-foreground">Three things that make your website faster, safer, and more reliable.</p>
      </div>

      <div class="grid sm:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border/60 bg-card/60 p-7 text-center space-y-4 hover:border-primary/40 transition-colors">
          <div class="p-3 bg-primary/10 text-primary rounded-xl w-fit mx-auto">
            <Zap className="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">10× Faster Pages</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">LiteSpeed Enterprise with LSCache + pure NVMe SSDs. Your TTFB drops from 400ms to under 40ms.</p>
        </div>

        <div class="rounded-2xl border border-border/60 bg-card/60 p-7 text-center space-y-4 hover:border-primary/40 transition-colors">
          <div class="p-3 bg-primary/10 text-primary rounded-xl w-fit mx-auto">
            <Shield className="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">Always Protected</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">Imunify360 AI blocks threats 24/7. JetBackup creates daily snapshots. Free SSL on every domain.</p>
        </div>

        <div class="rounded-2xl border border-border/60 bg-card/60 p-7 text-center space-y-4 hover:border-primary/40 transition-colors">
          <div class="p-3 bg-primary/10 text-primary rounded-xl w-fit mx-auto">
            <Headphones className="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">Real Humans, 24/7</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">No bots. Our Linux engineers respond in under 5 minutes via live chat, ticket, or WhatsApp.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ─── Slot: Pricing ─── */}
  <section slot="pricing" class="py-20 bg-muted/10" id="plans">
    <div class="container mx-auto px-4 max-w-screen-xl">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-bold mb-2">Cloud Hosting Plans</h2>
        <p class="text-sm text-muted-foreground">Select your datacenter location and billing cycle.</p>
      </div>

      <div class="max-w-screen-md mx-auto mb-6">
        <ValueStack />
      </div>

      <InteractivePricingGrid
        client:load
        plans={PLANS_CLOUD_HOSTING}
        locations={CLOUD_PROVIDER_LOCATIONS}
        billingCycles={GLOBAL_BILLING_CYCLES.cloudhosting}
      />
    </div>
  </section>

  {/* ─── Slot: Details (Tech Deep-Dive — collapsed by default for technical buyers) ─── */}
  <section slot="details" class="py-16 border-t border-border/40">
    <div class="container mx-auto px-4 max-w-screen-xl space-y-10">
      
      {/* Speed Test — contextually placed on product page, not homepage */}
      <InteractiveSpeedTest />
      
      {/* cPanel Showcase — technical detail for evaluating buyers */}
      <details class="group">
        <summary class="cursor-pointer text-sm font-semibold text-primary flex items-center gap-2 hover:underline py-4">
          <span>View cPanel Control Panel Features</span>
          <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <CpanelShowcase />
      </details>
    </div>
  </section>

</ProductPageTemplate>
