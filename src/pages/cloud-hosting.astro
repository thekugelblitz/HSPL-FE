---
import { Button } from "@/components/ui/button";
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import PricingCard from '../components/blocks/PricingCard.astro';
import FeatureCard from '../components/blocks/FeatureCard.astro';
import FaqAccordion from '../components/blocks/FaqAccordion.astro';
import { PlanComparisonTable } from '../components/blocks/PlanComparisonTable';
import { faqs } from '../lib/data';
import CpanelShowcase from '../components/blocks/CpanelShowcase.astro';
import InteractiveSpeedTest from '../components/blocks/InteractiveSpeedTest.astro';
import MigrationBanner from '../components/blocks/MigrationBanner.astro';
import { Check, Zap, Server, Shield, HardDrive, Cpu, Activity, ArrowRight } from 'lucide-react';
import { InteractivePricingGrid } from '../components/pricing/InteractivePricingGrid';
import { PLANS_CLOUD_HOSTING } from '../lib/pricing/cloudPlans';
import { CLOUD_PROVIDER_LOCATIONS, GLOBAL_BILLING_CYCLES } from '../lib/pricing/constants';

const features = [
  {
    title: "Easy To Setup",
    description: "Launch your website in minutes with our intuitive control panel and 1-click installers.",
    icon: "Server" as const
  },
  {
    title: "Blazing Fast Speed",
    description: "LiteSpeed Web Server and NVMe storage ensure your site loads instantly.",
    icon: "Zap" as const
  },
  {
    title: "Robust & Reliable",
    description: "Built on premium datacenter infrastructure with a 100% Uptime Mark.",
    icon: "Shield" as const
  },
  {
    title: "Regular Security Patching",
    description: "Imunify360 AI Anti-Virus keeps your data safe from all threats.",
    icon: "RefreshCw" as const
  }
];
---

<Layout 
  title="Cloud Hosting - Powerful yet Affordable Unlimited Shared Hosting | HostingSpell"
  description="Experience affordable unlimited cloud hosting with hassle-free migration, powerful resources, and 24x7 support tailored for modern websites."
>
  <Navbar />
  <main class="flex-1">
    {/* Page Hero - 2-Column Split Hero Layout */}
    <section class="relative bg-background pt-20 pb-24 border-b border-border/40 overflow-hidden">
      <div class="absolute inset-0 bg-blue-500/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
      <div class="absolute top-0 right-0 w-96 h-96 bg-cyan-500/20 rounded-full blur-[120px] pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-600/10 rounded-full blur-[100px] pointer-events-none"></div>
      
      <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center text-left">
          
          {/* Left Column (7 cols) */}
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center rounded-full border border-blue-500/30 bg-blue-500/10 px-3.5 py-1 text-xs font-bold text-blue-400">
              <span class="flex h-2 w-2 rounded-full bg-cyan-400 mr-2 animate-pulse"></span> Ultra-Fast Cloud Infrastructure
            </div>
            
            <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-[1.1]">
              Blazing Fast NVMe <br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-400">Cloud Web Hosting</span>
            </h1>
            
            <p class="text-base sm:text-lg text-muted-foreground font-medium max-w-xl">
              Host your websites on enterprise-grade LiteSpeed servers with NVMe storage, cPanel control panel, free SSL certificates, and 24/7 human support.
            </p>

            <ul class="space-y-3 text-xs sm:text-sm font-semibold text-foreground">
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-primary/15 text-primary border border-primary/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>LiteSpeed Enterprise Web Server with LSCache</span>
              </li>
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-primary/15 text-primary border border-primary/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>Imunify360 AI Anti-Virus Security Shield</span>
              </li>
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-primary/15 text-primary border border-primary/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>Free Instant Website Migration & 30-Day Money-Back SLA</span>
              </li>
            </ul>

            <div class="pt-2 flex items-center gap-4">
              <a href="#plans" class="px-8 h-13 rounded-xl bg-blue-600 text-white font-extrabold shadow-xl shadow-blue-500/25 flex items-center justify-center gap-2 hover:bg-blue-500 transition-all">
                <span>View Plans & Locations</span>
                <ArrowRight class="w-4 h-4" />
              </a>
            </div>
          </div>

          {/* Right Column (5 cols) - Visual Server Card */}
          <div class="lg:col-span-5 relative">
            <div class="glass-card rounded-3xl p-7 border border-blue-500/30 shadow-2xl relative overflow-hidden bg-card/90 backdrop-blur-xl">
              <div class="flex items-center justify-between border-b border-border/60 pb-4 mb-5">
                <div class="flex items-center gap-3">
                  <div class="relative flex h-3 w-3">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-3 w-3 bg-cyan-400"></span>
                  </div>
                  <div>
                    <div class="text-xs font-black text-foreground">Cloud Node #NVME-01</div>
                    <div class="text-[10px] text-cyan-400 font-bold">🟢 100% Operational Uptime</div>
                  </div>
                </div>
                <span class="text-[10px] font-black uppercase tracking-wider bg-blue-500/20 text-blue-400 border border-blue-500/30 px-2.5 py-1 rounded-full">
                  NVMe SPEED
                </span>
              </div>

              <div class="grid grid-cols-2 gap-3 mb-5">
                <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60">
                  <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] font-bold mb-1">
                    <Zap class="w-3.5 h-3.5 text-amber-400" /> TTFB Speed
                  </div>
                  <div class="text-lg font-black text-foreground">38 ms</div>
                </div>

                <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60">
                  <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] font-bold mb-1">
                    <HardDrive class="w-3.5 h-3.5 text-blue-400" /> Disk I/O
                  </div>
                  <div class="text-lg font-black text-foreground">6,500 MB/s</div>
                </div>
              </div>

              <div class="p-4 rounded-2xl bg-gradient-to-r from-blue-500/15 via-blue-500/5 to-transparent border border-blue-500/30 flex items-center justify-between">
                <div>
                  <div class="text-xs font-extrabold text-foreground">Cloud NVMe Tier</div>
                  <div class="text-[11px] text-muted-foreground">Unlimited Bandwidth + Free SSL</div>
                </div>
                <div class="text-right">
                  <div class="text-lg font-black text-blue-400">$1.29<span class="text-[10px] font-bold text-muted-foreground">/mo</span></div>
                  <span class="text-[9px] font-black uppercase bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded">SAVE 74%</span>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <CpanelShowcase />

    <section class="py-12 border-t border-border/40">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <InteractiveSpeedTest />
      </div>
    </section>

    {/* Pricing Section */}
    <section class="py-24" id="plans">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold mb-4">Cloud Hosting Plans & Datacenter Locations</h2>
          <p class="text-muted-foreground">Select your preferred server location and billing duration for instant WHMCS setup.</p>
        </div>

        <InteractivePricingGrid
          client:load
          plans={PLANS_CLOUD_HOSTING}
          locations={CLOUD_PROVIDER_LOCATIONS}
          billingCycles={GLOBAL_BILLING_CYCLES.cloudhosting}
        />
      </div>
    </section>

    <PlanComparisonTable service="cloud" client:visible />

    {/* Features Section */}
    <section class="py-24 bg-muted/30">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold mb-4">Why Is HostingSpell Better Than The Competition?</h2>
          <p class="text-muted-foreground">Experience the best possible web hosting for your website.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {features.map(feature => (
            <FeatureCard {...feature} />
          ))}
        </div>
      </div>
    </section>

    <MigrationBanner />

    {/* FAQ Section */}
    <section class="py-24">
      <div class="container mx-auto px-4 max-w-3xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold mb-4">Frequently Asked Questions</h2>
          <p class="text-muted-foreground">Find answers to the most common questions about HostingSpell's platform.</p>
        </div>
        <FaqAccordion items={faqs} />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
