---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import FounderGuarantee from '../components/blocks/FounderGuarantee.astro';
import { RefreshCw, CheckCircle2, AlertCircle } from 'lucide-react';
---

<Layout title="Refund Policy | HostingSpell 30-Day Money-Back Guarantee">
  <Navbar />
  <main class="bg-background overflow-hidden">
    <section class="py-16 bg-grid-pattern border-b border-border/40">
      <div class="container mx-auto px-4 max-w-screen-xl text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4">
          <RefreshCw class="w-3.5 h-3.5" />
          Risk-Free Guarantee
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4">
          30-Day Money-Back Guarantee
        </h1>
        <p class="text-muted-foreground text-sm sm:text-base max-w-xl mx-auto">
          We are so confident in our hosting performance that we offer a 100% money-back refund guarantee for all new cloud hosting purchases.
        </p>
      </div>
    </section>

    <FounderGuarantee />

    <section class="py-16">
      <div class="container mx-auto px-4 max-w-screen-md">
        <div class="glass-card p-8 sm:p-12 rounded-3xl glow-card space-y-8 text-sm leading-relaxed text-muted-foreground">
          <div class="space-y-3">
            <h2 class="text-xl font-bold text-foreground flex items-center gap-2">
              <CheckCircle2 class="w-5 h-5 text-emerald-400" />
              <span>Eligible Hosting Services</span>
            </h2>
            <p>
              The 30-day money-back guarantee applies to all new purchases of Cloud NVMe Hosting, Premium cPanel Hosting, Reseller WHM Hosting, and Specialized WordPress/Node.js Hosting plans.
            </p>
          </div>

          <div class="space-y-3 pt-6 border-t border-border/40">
            <h2 class="text-xl font-bold text-foreground flex items-center gap-2">
              <AlertCircle class="w-5 h-5 text-amber-400" />
              <span>Non-Refundable Items</span>
            </h2>
            <p>
              Domain name registrations/transfers, SSL certificates, dedicated IP add-ons, and software licenses (cPanel/WHM/LiteSpeed) are non-refundable as they incur direct registry third-party fees.
            </p>
          </div>

          <div class="space-y-3 pt-6 border-t border-border/40">
            <h2 class="text-xl font-bold text-foreground">How to Request a Refund</h2>
            <p>
              To request a refund within 30 days of initial order activation, simply open a ticket with our billing department via the client portal. Refunds are processed back to your original payment method within 3 to 5 business days.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
