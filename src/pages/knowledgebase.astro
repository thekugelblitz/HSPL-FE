---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { kbCategories, popularArticles } from '../lib/data';
import { Search, HelpCircle, ArrowRight, LayoutDashboard, Globe, Zap, ShieldCheck, Server, CreditCard, BookOpen, Check } from 'lucide-react';

const iconMap = {
  LayoutDashboard,
  Globe,
  Zap,
  ShieldCheck,
  Server,
  CreditCard
};
---

<Layout title="Knowledgebase | HostingSpell Documentation & Tutorials">
  <Navbar />
  <main class="bg-background overflow-hidden">
    {/* Page Hero - 2-Column Split Hero Layout */}
    <section class="py-20 bg-grid-pattern border-b border-border/40 relative">
      <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center text-left">
          
          {/* Left Column (7 cols) */}
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 text-xs font-bold rounded-full bg-primary/10 border border-primary/20 text-primary uppercase tracking-wider">
              <HelpCircle class="w-4 h-4 text-primary" /> Documentation & Help Portal
            </div>

            <h1 class="text-4xl sm:text-6xl lg:text-6xl font-extrabold tracking-tight leading-[1.1]">
              How Can We <br />
              <span class="text-gradient-primary">Help You?</span>
            </h1>

            <div class="relative max-w-xl">
              <input 
                type="text" 
                placeholder="Search tutorials (e.g. 'cPanel SSL', 'WordPress LSCache')..." 
                class="w-full pl-12 pr-4 py-3.5 rounded-2xl bg-card border border-border text-sm focus:outline-none focus:ring-2 focus:ring-primary shadow-xl"
              />
              <Search class="w-5 h-5 text-muted-foreground absolute left-4 top-1/2 -translate-y-1/2" />
            </div>

            <ul class="space-y-2 text-xs font-semibold text-foreground">
              <li class="flex items-center gap-2">
                <Check class="w-3.5 h-3.5 text-emerald-400" />
                <span>150+ Step-by-Step Guides for cPanel, LiteSpeed & VPS</span>
              </li>
              <li class="flex items-center gap-2">
                <Check class="w-3.5 h-3.5 text-emerald-400" />
                <span>Instant DNS, SSL, and Migration Troubleshooting</span>
              </li>
            </ul>

            <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground pt-1">
              <span class="text-foreground font-bold">Popular:</span>
              <a href="#" class="px-2.5 py-1 rounded-md bg-muted/50 hover:bg-muted font-medium text-foreground">Nameservers</a>
              <a href="#" class="px-2.5 py-1 rounded-md bg-muted/50 hover:bg-muted font-medium text-foreground">Free AutoSSL</a>
              <a href="#" class="px-2.5 py-1 rounded-md bg-muted/50 hover:bg-muted font-medium text-foreground">WordPress Cache</a>
              <a href="#" class="px-2.5 py-1 rounded-md bg-muted/50 hover:bg-muted font-medium text-foreground">Root SSH</a>
            </div>
          </div>

          {/* Right Column (5 cols) - KB Portal Visual Card */}
          <div class="lg:col-span-5 relative">
            <div class="glass-card rounded-3xl p-7 border border-primary/30 shadow-2xl relative overflow-hidden bg-card/90 backdrop-blur-xl">
              <div class="flex items-center justify-between border-b border-border/60 pb-4 mb-5">
                <div class="flex items-center gap-3">
                  <div class="p-2 rounded-xl bg-primary/20 text-primary">
                    <BookOpen class="w-4 h-4" />
                  </div>
                  <div>
                    <div class="text-xs font-black text-foreground">HostingSpell Knowledgebase</div>
                    <div class="text-[10px] text-emerald-400 font-bold">🟢 Updated Daily</div>
                  </div>
                </div>
                <span class="text-[10px] font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-2.5 py-1 rounded-full">
                  DOCS
                </span>
              </div>

              <div class="grid grid-cols-2 gap-3 mb-5">
                <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60">
                  <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] font-bold mb-1">
                    <BookOpen class="w-3.5 h-3.5 text-primary" /> Total Guides
                  </div>
                  <div class="text-lg font-black text-foreground">150+ Articles</div>
                </div>

                <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60">
                  <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] font-bold mb-1">
                    <ShieldCheck class="w-3.5 h-3.5 text-emerald-400" /> Ticket SLA
                  </div>
                  <div class="text-xs font-black text-emerald-400">&lt; 15m Response</div>
                </div>
              </div>

              <div class="p-4 rounded-2xl bg-gradient-to-r from-primary/15 via-primary/5 to-transparent border border-primary/30 flex items-center justify-between">
                <div>
                  <div class="text-xs font-extrabold text-foreground">Need 1-on-1 Help?</div>
                  <div class="text-[11px] text-muted-foreground">Open a ticket in client portal</div>
                </div>
                <a href="https://manage.hostingspell.com/submitticket.php" target="_blank" rel="noopener" class="text-xs font-bold text-primary hover:underline">Submit Ticket &rarr;</a>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    {/* Categories Grid */}
    <section class="py-20 border-b border-border/40">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <h2 class="text-2xl font-bold mb-8">Browse Knowledgebase Categories</h2>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {kbCategories.map((cat) => {
            const IconComponent = iconMap[cat.icon as keyof typeof iconMap] || BookOpen;
            return (
              <div class="glass-card rounded-2xl p-6 glow-card transition-all hover:-translate-y-1 group">
                <div class="flex items-center justify-between mb-4">
                  <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-primary-foreground transition-colors">
                    <IconComponent class="w-5 h-5" />
                  </div>
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-muted text-muted-foreground">
                    {cat.count} Articles
                  </span>
                </div>
                <h3 class="font-bold text-lg mb-1 group-hover:text-primary transition-colors">{cat.name}</h3>
                <p class="text-xs text-muted-foreground leading-relaxed mb-4">{cat.description}</p>
                <div class="text-xs font-semibold text-primary inline-flex items-center gap-1">
                  <span>Explore articles</span>
                  <ArrowRight class="w-3.5 h-3.5" />
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* Popular Tutorials */}
    <section class="py-20">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <h2 class="text-2xl font-bold mb-8">Most Popular Guides</h2>

        <div class="grid md:grid-cols-2 gap-4 max-w-5xl">
          {popularArticles.map((art) => (
            <a 
              href={art.link}
              class="glass-card rounded-xl p-5 glow-card flex items-center justify-between hover:bg-muted/30 transition-all border border-border/40 group"
            >
              <div class="space-y-1">
                <span class="text-[10px] uppercase font-bold text-primary tracking-wider">{art.category}</span>
                <h3 class="font-semibold text-sm group-hover:text-primary transition-colors">{art.title}</h3>
                <div class="text-[11px] text-muted-foreground flex items-center gap-3">
                  <span>{art.readTime}</span>
                  <span>•</span>
                  <span>{art.views} views</span>
                </div>
              </div>
              <ArrowRight class="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors shrink-0 ml-4" />
            </a>
          ))}
        </div>

        {/* Can't Find Answer Card */}
        <div class="mt-16 glass-card rounded-3xl p-8 text-center max-w-2xl mx-auto border border-white/10 glow-card">
          <h3 class="text-xl font-bold mb-2">Can't find what you're looking for?</h3>
          <p class="text-xs text-muted-foreground mb-6">Our support team is available 24/7/365 to assist with any technical issues.</p>
          <a 
            href="https://manage.hostingspell.com/submitticket.php" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary text-primary-foreground font-semibold text-xs hover:opacity-90 transition-all shadow-md shadow-primary/20"
          >
            <span>Open a Support Ticket</span>
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
