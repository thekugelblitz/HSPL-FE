---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import FeatureCard from '../components/blocks/FeatureCard.astro';
import { Button } from "@/components/ui/button";

const tlds = [
  { ext: ".com", price: "₹999/yr", oldPrice: "₹1200", sale: true },
  { ext: ".in", price: "₹499/yr", oldPrice: "₹700", sale: true },
  { ext: ".net", price: "₹1099/yr", oldPrice: "", sale: false },
  { ext: ".org", price: "₹1199/yr", oldPrice: "", sale: false },
  { ext: ".co", price: "₹2499/yr", oldPrice: "", sale: false },
  { ext: ".io", price: "₹3499/yr", oldPrice: "", sale: false },
];

const features = [
  {
    title: "Domain Locking",
    description: "Lock your domain to prevent unauthorized transfers.",
    icon: "Shield" as const
  },
  {
    title: "Privacy Protection",
    description: "Your personal info will be secure and protected. Free WHOIS privacy protection is included.",
    icon: "Shield" as const
  },
  {
    title: "Easy Management",
    description: "Manage your products with our easy to use control panel & dashboard.",
    icon: "Server" as const
  },
  {
    title: "Auto-renewal",
    description: "Never Lose your domain when it expires even if you forget to renew it!",
    icon: "RefreshCw" as const
  }
];
---

<Layout 
  title="Domain Registration - Buy Cheap Domain Name | HostingSpell"
  description="Find and register your perfect domain name with HostingSpell. Affordable domain registration with reliable support for your online identity."
>
  <Navbar />
  <main class="flex-1">
    <section class="relative bg-background pt-24 pb-24 border-b border-border/40 overflow-hidden">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:48px_48px]"></div>
      <div class="absolute top-0 right-0 w-[600px] h-[400px] bg-indigo-500/10 rounded-full blur-[100px] pointer-events-none animate-in fade-in duration-1000"></div>
      
      <div class="container mx-auto px-4 max-w-4xl text-center relative z-10">
        <div class="inline-flex items-center rounded-full border border-indigo-500/30 bg-indigo-500/10 px-3 py-1 text-sm font-semibold text-indigo-500 mb-6 animate-in fade-in slide-in-from-bottom-4 duration-700">
          <span class="flex h-2 w-2 rounded-full bg-indigo-400 mr-2 animate-pulse"></span> Domain Registration
        </div>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold tracking-tight mb-6 animate-in fade-in slide-in-from-bottom-6 duration-700 delay-150 fill-mode-both">
          Find Your Perfect <br class="hidden md:block"/><span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-500 to-blue-400">Domain Name</span>
        </h1>
        <p class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto mb-10 animate-in fade-in slide-in-from-bottom-4 duration-700 delay-300 fill-mode-both">
          Register your domain name today and start building your brand online. Free WHOIS privacy included.
        </p>
        
        <div class="max-w-3xl mx-auto bg-card rounded-2xl p-2 shadow-xl border border-border/50 animate-in fade-in slide-in-from-bottom-4 duration-700 delay-500 fill-mode-both">
          <div class="relative flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-4 w-6 h-6 text-muted-foreground"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" placeholder="Find your perfect domain name (e.g., example.com)" class="w-full h-16 pl-14 pr-32 rounded-xl border-0 bg-transparent text-lg focus:ring-2 focus:ring-primary outline-none" />
            <Button size="lg" className="absolute right-2 h-12 px-8 text-base bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-lg transition-transform hover:scale-105 shadow-md">
              Search
            </Button>
          </div>
        </div>
      </div>
    </section>
    <section class="py-24">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold mb-4">Website Extensions for your Needs</h2>
          <p class="text-muted-foreground">Secure your brand across the most recognized TLDs.</p>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
          {tlds.map(tld => (
            <div class="border border-border bg-card text-card-foreground rounded-xl p-6 text-center hover:border-primary/50 transition-all hover:-translate-y-1 shadow-sm hover:shadow-md cursor-pointer group">
              <h3 class="text-3xl font-extrabold text-foreground mb-2 group-hover:text-primary transition-colors">{tld.ext}</h3>
              {tld.sale && <div class="text-xs text-muted-foreground line-through mb-1">{tld.oldPrice}</div>}
              <div class="text-primary font-semibold">{tld.price}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 bg-muted/30">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold mb-4">Why Get Domains From HostingSpell</h2>
          <p class="text-muted-foreground">Most affordable prices in the industry and even more affordable to renew.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {features.map(feature => (
            <FeatureCard {...feature} />
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
