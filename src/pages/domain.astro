---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import FeatureCard from '../components/blocks/FeatureCard.astro';
import { Button } from "@/components/ui/button";
import { FaqAccordion } from '../components/blocks/FaqAccordion';
import { domainPricing, faqs } from '../lib/data';
import { Search, Shield, Globe, Lock, ArrowRight, CheckCircle2, Check, Zap } from 'lucide-react';

const features = [
  {
    title: "Domain Theft Lock",
    description: "Lock your domain to prevent unauthorized transfers and registrar hijacking.",
    icon: "Shield" as const
  },
  {
    title: "Free WHOIS Privacy",
    description: "Your personal contact details remain private and hidden from spammers and telemarketers.",
    icon: "Shield" as const
  },
  {
    title: "Full DNS Management",
    description: "Manage A, AAAA, MX, CNAME, TXT, and NS records with instant global propagation.",
    icon: "Server" as const
  },
  {
    title: "Free Email Forwarding",
    description: "Create professional alias email addresses (sales@yourdomain.com) forwarded to your personal inbox.",
    icon: "RefreshCw" as const
  }
];
---

<Layout 
  title="Domain Registration & Transfer | Buy Cheap Domain Names - HostingSpell"
  description="Find and register your perfect domain name (.com $9.99, .in $3.99). Includes free WHOIS privacy, DNS management, and 24/7 support."
>
  <Navbar />
  <main class="flex-1 bg-background overflow-hidden">
    {/* Hero Section - 2-Column Split Hero Layout */}
    <section class="relative bg-background pt-20 pb-24 border-b border-border/40 overflow-hidden bg-grid-pattern">
      <div class="absolute top-0 right-0 w-[600px] h-[400px] bg-indigo-500/10 rounded-full blur-[100px] pointer-events-none"></div>
      
      <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center text-left">
          
          {/* Left Column (7 cols) */}
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-3.5 py-1 text-xs font-bold text-indigo-400 uppercase tracking-wider">
              <Globe class="w-3.5 h-3.5" /> Domain Search & Registration
            </div>

            <h1 class="text-4xl sm:text-6xl lg:text-6xl font-extrabold tracking-tight leading-[1.1]">
              Find Your Perfect <br />
              <span class="text-gradient-primary">Domain Name</span>
            </h1>

            <p class="text-base sm:text-lg text-muted-foreground font-medium max-w-xl">
              Register your domain name today with free WHOIS privacy protection, free DNS management, and instant global propagation.
            </p>

            {/* Domain Search Bar */}
            <form class="max-w-xl bg-card rounded-2xl p-2 shadow-2xl border border-border/80 glow-card" onsubmit="event.preventDefault(); window.location.href='https://manage.hostingspell.com/cart.php?a=add&domain=register';">
              <div class="relative flex items-center">
                <Search class="absolute left-4 w-5 h-5 text-muted-foreground" />
                <input type="text" placeholder="Search your dream domain (e.g. mybrand.com)" class="w-full h-14 pl-12 pr-32 rounded-xl border-0 bg-transparent text-sm sm:text-base focus:ring-0 outline-none" />
                <Button size="lg" className="absolute right-1.5 h-11 px-6 text-sm bg-primary hover:bg-primary/90 text-primary-foreground font-extrabold rounded-xl transition-all shadow-md">
                  Search
                </Button>
              </div>
            </form>

            <ul class="space-y-2.5 text-xs sm:text-sm font-semibold text-foreground pt-1">
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>Free WHOIS Privacy Protection Included ($15 Value)</span>
              </li>
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>Instant DNS Management (A, CNAME, MX, TXT Records)</span>
              </li>
            </ul>
          </div>

          {/* Right Column (5 cols) - TLD Pricing Card Visual */}
          <div class="lg:col-span-5 relative">
            <div class="glass-card rounded-3xl p-7 border border-indigo-500/30 shadow-2xl relative overflow-hidden bg-card/90 backdrop-blur-xl">
              <div class="flex items-center justify-between border-b border-border/60 pb-4 mb-5">
                <div class="flex items-center gap-3">
                  <div class="p-2 rounded-xl bg-indigo-500/20 text-indigo-400">
                    <Globe class="w-4 h-4" />
                  </div>
                  <div>
                    <div class="text-xs font-black text-foreground">Global ICANN Registrar</div>
                    <div class="text-[10px] text-emerald-400 font-bold">🟢 Instant Auto Activation</div>
                  </div>
                </div>
                <span class="text-[10px] font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-2.5 py-1 rounded-full">
                  WHOIS PRIVACY
                </span>
              </div>

              {/* TLD List */}
              <div class="space-y-2.5 mb-5">
                <div class="p-3 rounded-2xl bg-muted/40 border border-border/60 flex items-center justify-between">
                  <span class="font-black text-sm text-foreground">.com</span>
                  <div class="text-right">
                    <span class="text-sm font-black text-primary">$9.99</span>
                    <span class="text-[10px] text-muted-foreground block">/1st Year</span>
                  </div>
                </div>

                <div class="p-3 rounded-2xl bg-muted/40 border border-border/60 flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="font-black text-sm text-foreground">.in</span>
                    <span class="text-[9px] font-black uppercase bg-emerald-500/20 text-emerald-400 px-1.5 py-0.5 rounded">HOT SALE</span>
                  </div>
                  <div class="text-right">
                    <span class="text-sm font-black text-emerald-400">$3.99</span>
                    <span class="text-[10px] text-muted-foreground block">/1st Year</span>
                  </div>
                </div>

                <div class="p-3 rounded-2xl bg-muted/40 border border-border/60 flex items-center justify-between">
                  <span class="font-black text-sm text-foreground">.net</span>
                  <div class="text-right">
                    <span class="text-sm font-black text-blue-400">$11.99</span>
                    <span class="text-[10px] text-muted-foreground block">/1st Year</span>
                  </div>
                </div>
              </div>

              <div class="p-4 rounded-2xl bg-gradient-to-r from-indigo-500/15 via-indigo-500/5 to-transparent border border-indigo-500/30 text-xs font-bold text-muted-foreground flex items-center justify-between">
                <span>Free Auto-Renewal Lock</span>
                <span class="text-emerald-400 font-extrabold">Included Free</span>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    {/* Full Domain Pricing Matrix */}
    <section class="py-24 border-b border-border/40">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16 max-w-2xl mx-auto">
          <h2 class="text-3xl font-extrabold tracking-tight mb-4">Transparent Domain Pricing Matrix</h2>
          <p class="text-muted-foreground">Clear registration, renewal, and transfer pricing with zero hidden fees.</p>
        </div>
        
        <div class="max-w-4xl mx-auto overflow-x-auto">
          <table class="w-full text-left border-collapse min-w-[500px]">
            <thead>
              <tr class="border-b border-border/60 text-xs font-bold uppercase text-muted-foreground">
                <th class="py-4 px-6">Domain TLD</th>
                <th class="py-4 px-6">New Registration</th>
                <th class="py-4 px-6">Annual Renewal</th>
                <th class="py-4 px-6">Domain Transfer</th>
                <th class="py-4 px-6 text-right">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border/40 text-sm">
              {domainPricing.map((item) => (
                <tr class="hover:bg-muted/30 transition-colors">
                  <td class="py-4 px-6 font-extrabold text-foreground text-base">
                    {item.tld}
                    {item.popular && (
                      <span class="ml-2 text-[10px] uppercase font-bold text-emerald-400 px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20">
                        Hot
                      </span>
                    )}
                  </td>
                  <td class="py-4 px-6 font-bold text-primary">{item.register}</td>
                  <td class="py-4 px-6 text-muted-foreground">{item.renew}</td>
                  <td class="py-4 px-6 text-muted-foreground">{item.transfer}</td>
                  <td class="py-4 px-6 text-right">
                    <a 
                      href="https://manage.hostingspell.com/cart.php?a=add&domain=register" 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="inline-flex items-center gap-1 text-xs font-bold text-primary hover:underline"
                    >
                      <span>Register</span>
                      <ArrowRight class="w-3.5 h-3.5" />
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* Features Section */}
    <section class="py-24 bg-muted/20 border-b border-border/40">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold mb-4">Included Free With Every Domain</h2>
          <p class="text-muted-foreground">Get premium domain extras without paying additional fees.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {features.map(feature => (
            <FeatureCard {...feature} />
          ))}
        </div>
      </div>
    </section>

    {/* FAQ Section */}
    <section class="py-24">
      <div class="container mx-auto px-4 max-w-3xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold mb-4">Domain FAQs</h2>
          <p class="text-muted-foreground">Find answers to the most common domain registration questions.</p>
        </div>
        <FaqAccordion items={faqs} client:visible />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
