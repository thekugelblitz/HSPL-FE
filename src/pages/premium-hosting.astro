---
// src/pages/premium-hosting.astro
// Premium Hosting — sells dedicated performance for high-traffic sites

import ProductPageTemplate from '../layouts/ProductPageTemplate.astro';
import ValueStack from '../components/blocks/ValueStack.astro';
import CpanelShowcase from '../components/blocks/CpanelShowcase.astro';
import InteractiveSpeedTest from '../components/blocks/InteractiveSpeedTest.astro';
import { InteractivePricingGrid } from '../components/pricing/InteractivePricingGrid';
import { PLANS_PREMIUM_HOSTING } from '../lib/pricing/premiumPlans';
import { PREMIUM_PROVIDER_LOCATIONS, GLOBAL_BILLING_CYCLES } from '../lib/pricing/constants';
import { faqs } from '../lib/data';
import { Zap, Server, Globe } from 'lucide-react';

const premiumFaqs = faqs.slice(0, 5);
---

<ProductPageTemplate
  title="Premium Hosting — Dedicated Resources for High-Traffic Sites | HostingSpell"
  description="Premium cPanel hosting on DigitalOcean & Linode cloud. Dedicated CPU & RAM, unlimited SSD storage, and LiteSpeed Enterprise. Starting at $1.99/mo."
  heroTag="Premium Cloud Hosting"
  heroHeadline='Your High-Traffic Site<br /><span class="bg-gradient-to-r from-indigo-500 via-primary to-blue-500 dark:from-indigo-400 dark:via-blue-400 dark:to-sky-400 bg-clip-text text-transparent">Deserves Dedicated Power.</span>'
  heroSubheadline="When your site gets real traffic, shared resources aren't enough. Premium Hosting gives you dedicated CPU, RAM, and storage on DigitalOcean & Linode infrastructure."
  heroCtaText="See Premium Plans"
  heroCtaHref="#plans"
  heroCheckpoints={[
    "Dedicated CPU & RAM — not shared with anyone",
    "Hosted on DigitalOcean & Linode premium cloud",
    "LiteSpeed Enterprise + unlimited NVMe SSD storage",
  ]}
  heroPriceAnchor="Starting at $1.99/mo • 30-Day Money-Back Guarantee"
  faqs={premiumFaqs}
>
  
  <section slot="outcomes" class="py-20 border-b border-border/40">
    <div class="container mx-auto px-4 max-w-screen-xl">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-extrabold tracking-tight mb-3">Premium Infrastructure, Premium Performance</h2>
        <p class="text-muted-foreground">Everything you need for e-commerce, SaaS, and high-traffic applications.</p>
      </div>

      <div class="grid sm:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="rounded-2xl border border-border/60 bg-card/60 p-7 text-center space-y-4 hover:border-primary/40 transition-colors">
          <div class="p-3 bg-primary/10 text-primary rounded-xl w-fit mx-auto">
            <Server className="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">Dedicated Resources</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">Your CPU and RAM are reserved exclusively for your sites. No resource sharing, no noisy neighbors.</p>
        </div>

        <div class="rounded-2xl border border-border/60 bg-card/60 p-7 text-center space-y-4 hover:border-primary/40 transition-colors">
          <div class="p-3 bg-primary/10 text-primary rounded-xl w-fit mx-auto">
            <Zap className="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">Cloud Infrastructure</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">Powered by DigitalOcean and Linode — the same clouds trusted by millions of developers worldwide.</p>
        </div>

        <div class="rounded-2xl border border-border/60 bg-card/60 p-7 text-center space-y-4 hover:border-primary/40 transition-colors">
          <div class="p-3 bg-primary/10 text-primary rounded-xl w-fit mx-auto">
            <Globe className="w-5 h-5" />
          </div>
          <h3 class="text-lg font-bold text-foreground">Global Datacenters</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">Choose from datacenters across US, Europe, India, and Singapore for the lowest latency to your users.</p>
        </div>
      </div>
    </div>
  </section>

  <section slot="pricing" class="py-20 bg-muted/10" id="plans">
    <div class="container mx-auto px-4 max-w-screen-xl">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-bold mb-2">Premium Hosting Plans</h2>
        <p class="text-sm text-muted-foreground">Select your cloud provider, datacenter, and billing cycle.</p>
      </div>

      <div class="max-w-screen-md mx-auto mb-6">
        <ValueStack />
      </div>

      <InteractivePricingGrid
        client:load
        plans={PLANS_PREMIUM_HOSTING}
        locations={PREMIUM_PROVIDER_LOCATIONS}
        billingCycles={GLOBAL_BILLING_CYCLES.premiumhosting}
      />
    </div>
  </section>

  <section slot="details" class="py-16 border-t border-border/40">
    <div class="container mx-auto px-4 max-w-screen-xl space-y-10">
      <InteractiveSpeedTest />
      
      <details class="group">
        <summary class="cursor-pointer text-sm font-semibold text-primary flex items-center gap-2 hover:underline py-4">
          <span>View cPanel Control Panel Features</span>
          <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <CpanelShowcase />
      </details>
    </div>
  </section>

</ProductPageTemplate>
