---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import PricingCard from '../components/blocks/PricingCard.astro';
import FeatureCard from '../components/blocks/FeatureCard.astro';
import { FaqAccordion } from '../components/blocks/FaqAccordion';
import { premiumPlans, faqs } from '../lib/data';

const features = [
  {
    title: "Phusion Passenger",
    description: "Easily deploy and manage Node.js applications directly via cPanel.",
    icon: "Server" as const
  },
  {
    title: "NPM Support",
    description: "Full terminal access and npm support to install required packages easily.",
    icon: "Zap" as const
  },
  {
    title: "Node.js Selector",
    description: "Choose and switch between multiple Node.js versions with a single click.",
    icon: "Shield" as const
  },
  {
    title: "Scalable Resources",
    description: "Seamlessly upgrade your RAM and CPU as your application traffic grows.",
    icon: "RefreshCw" as const
  }
];
---

<Layout 
  title="Node.js Hosting - Deploy Node.js Apps via cPanel | HostingSpell"
  description="Host Node.js applications with ease on HostingSpell's cPanel hosting. Powered by Phusion Passenger, Node.js Manager, npm support, and scalable VPS upgrade paths."
>
  <Navbar />
  <main class="flex-1">
    {/* Page Hero */}
    <section class="relative bg-background pt-24 pb-28 border-b border-border/40 overflow-hidden">
      <div class="absolute inset-0 bg-primary/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
      <div class="container mx-auto px-4 max-w-screen-xl text-center relative z-10">
        <span class="inline-flex items-center rounded-full bg-emerald-500/10 px-3 py-1 text-sm font-semibold text-emerald-500 mb-4 border border-emerald-500/20">
          Developer Friendly
        </span>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6">
          High-Performance <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 to-emerald-400">Node.js Hosting</span>
        </h1>
        <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
          Deploy Next.js, Express, and Socket.io applications effortlessly with our managed cPanel environment.
        </p>
      </div>
    </section>

    {/* Pricing Section */}
    <section class="py-24" id="plans">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold mb-4">Powerful Plans for Node.js</h2>
          <p class="text-muted-foreground">Premium dedicated resources for intensive JavaScript applications.</p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
          {premiumPlans.map(plan => (
            <PricingCard {...plan} />
          ))}
        </div>
      </div>
    </section>

    {/* Features Section */}
    <section class="py-24 bg-muted/30">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold mb-4">Optimized for JavaScript Developers</h2>
          <p class="text-muted-foreground">Everything you need to run modern Node.js backends.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {features.map(feature => (
            <FeatureCard {...feature} />
          ))}
        </div>
      </div>
    </section>

    {/* FAQ Section */}
    <section class="py-24">
      <div class="container mx-auto px-4 max-w-3xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold mb-4">Node.js Hosting FAQ</h2>
          <p class="text-muted-foreground">Common questions about deploying JS apps on our platform.</p>
        </div>
        <FaqAccordion items={faqs} client:visible />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
