---
import { Button } from "@/components/ui/button";
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import PricingCard from '../components/blocks/PricingCard.astro';
import FeatureCard from '../components/blocks/FeatureCard.astro';
import { FaqAccordion } from '../components/blocks/FaqAccordion';
import { premiumPlans, faqs } from '../lib/data';
import { Check, Code, Zap, Server, Terminal, ArrowRight } from 'lucide-react';

const features = [
  {
    title: "cPanel Node.js Manager",
    description: "Create, configure, and manage your Node.js applications visually inside cPanel. Set app root, startup file, and run npm install.",
    icon: "layout" as const
  },
  {
    title: "Phusion Passenger",
    description: "Your Node.js app is served by Phusion Passenger — battle-tested application server trusted by Apple and Basecamp.",
    icon: "zap" as const
  },
  {
    title: "npm & yarn Support",
    description: "Install any npm or yarn package from cPanel terminal. Express, Fastify, NestJS, Next.js, or custom server ready.",
    icon: "package" as const
  },
  {
    title: "Per-App Environment Variables",
    description: "Define custom environment variables (.env) for each Node.js application independently through cPanel.",
    icon: "sliders" as const
  },
  {
    title: "Multi-Version Node.js",
    description: "Choose from Node.js 14, 16, 18, 20, or 22 per application without conflicts.",
    icon: "layers" as const
  },
  {
    title: "Instant Scale to VPS",
    description: "Start on Premium Hosting and move to a VPS when your Node.js app outgrows shared resources.",
    icon: "trending-up" as const
  }
];
---

<Layout 
  title="Node.js Hosting - Deploy Node.js Apps via cPanel | HostingSpell"
  description="Host Node.js applications with ease on HostingSpell's cPanel hosting. Powered by Phusion Passenger, Node.js Manager, npm support, and scalable VPS upgrade paths."
>
  <Navbar />
  
  <main class="flex-1">
    {/* Page Hero - 2-Column Split Hero Layout */}
    <section class="relative bg-background pt-20 pb-24 border-b border-border/40 overflow-hidden">
      <div class="absolute inset-0 bg-primary/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
      <div class="absolute -top-[200px] left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-emerald-500/20 dark:bg-emerald-500/10 rounded-full blur-[100px] pointer-events-none"></div>
      
      <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center text-left">
          
          {/* Left Column (7 cols) */}
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-xs font-bold text-emerald-400">
              <span class="flex h-2 w-2 rounded-full bg-emerald-400 mr-2 animate-pulse"></span> Node.js v20 LTS Runtime Active
            </div>

            <h1 class="text-4xl sm:text-6xl lg:text-6xl font-extrabold tracking-tight leading-[1.1]">
              Deploy Node.js Apps <br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-green-400 to-teal-400">via cPanel Manager</span>
            </h1>

            <p class="text-base sm:text-lg text-muted-foreground font-medium max-w-xl">
              Deploy your Express, Next.js, or NestJS applications through cPanel Node.js Manager served by Phusion Passenger with full npm support.
            </p>

            <ul class="space-y-3 text-xs sm:text-sm font-semibold text-foreground">
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>Phusion Passenger Application Server Integration</span>
              </li>
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>Full npm & yarn package manager support via terminal</span>
              </li>
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>Per-app environment variables (.env) & version switcher</span>
              </li>
            </ul>

            <div class="pt-2 flex flex-col sm:flex-row items-center gap-4">
              <a href="#plans" class="w-full sm:w-auto">
                <Button size="lg" className="w-full h-13 px-8 text-base bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold shadow-xl shadow-emerald-500/25 flex items-center justify-center gap-2">
                  <span>View Node.js Plans</span>
                  <ArrowRight class="w-4 h-4" />
                </Button>
              </a>
              <a href="/vps" class="w-full sm:w-auto">
                <Button size="lg" variant="outline" className="w-full h-13 px-8 text-base font-extrabold hover:bg-emerald-500/10 hover:text-emerald-400 border-border/80">
                  Dedicated Node VPS
                </Button>
              </a>
            </div>
          </div>

          {/* Right Column (5 cols) - Node App Visual Card */}
          <div class="lg:col-span-5 relative">
            <div class="glass-card rounded-3xl p-7 border border-emerald-500/30 shadow-2xl relative overflow-hidden bg-card/90 backdrop-blur-xl">
              <div class="flex items-center justify-between border-b border-border/60 pb-4 mb-5">
                <div class="flex items-center gap-3">
                  <div class="p-2 rounded-xl bg-emerald-500/20 text-emerald-400">
                    <Code class="w-4 h-4" />
                  </div>
                  <div>
                    <div class="text-xs font-black text-foreground">node app.js --port=3000</div>
                    <div class="text-[10px] text-emerald-400 font-bold">🟢 Passenger Worker Active</div>
                  </div>
                </div>
                <span class="text-[10px] font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-2.5 py-1 rounded-full">
                  NODE v20.x
                </span>
              </div>

              <div class="grid grid-cols-2 gap-3 mb-5">
                <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60">
                  <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] font-bold mb-1">
                    <Terminal class="w-3.5 h-3.5 text-emerald-400" /> Package Manager
                  </div>
                  <div class="text-lg font-black text-foreground">npm / yarn</div>
                </div>

                <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60">
                  <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] font-bold mb-1">
                    <Zap class="w-3.5 h-3.5 text-teal-400" /> App Server
                  </div>
                  <div class="text-xs font-black text-emerald-400">Phusion Passenger</div>
                </div>
              </div>

              <div class="p-4 rounded-2xl bg-gradient-to-r from-emerald-500/15 via-emerald-500/5 to-transparent border border-emerald-500/30 flex items-center justify-between">
                <div>
                  <div class="text-xs font-extrabold text-foreground">Node.js cPanel Plan</div>
                  <div class="text-[11px] text-muted-foreground">Multi-Version + Free SSL</div>
                </div>
                <div class="text-right">
                  <div class="text-lg font-black text-emerald-400">$1.99<span class="text-[10px] font-bold text-muted-foreground">/mo</span></div>
                  <span class="text-[9px] font-black uppercase bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded">READY</span>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    {/* Features Section */}
    <section class="py-20 bg-muted/30">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Why Choose HostingSpell for Node.js?</h2>
          <p class="text-muted-foreground max-w-2xl mx-auto text-lg">From simple REST APIs to full-stack Next.js applications, our cPanel Node.js hosting gives you the tools to deploy with confidence.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {features.map((feature) => (
            <FeatureCard {...feature} />
          ))}
        </div>
      </div>
    </section>

    {/* Pricing Section */}
    <section id="plans" class="py-24 bg-background border-y border-border/40">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Start with Premium Hosting for Node.js</h2>
          <p class="text-muted-foreground max-w-2xl mx-auto text-lg">Every plan includes cPanel Node.js Manager and Phusion Passenger. Deploy your app, then scale to VPS when you're ready.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {premiumPlans.map((plan) => (
            <PricingCard {...plan} />
          ))}
        </div>
      </div>
    </section>

    {/* FAQ Section */}
    <section class="py-24 bg-muted/30">
      <div class="container mx-auto px-4 max-w-3xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Frequently Asked Questions</h2>
          <p class="text-muted-foreground text-lg">Find answers to the most common questions about our Node.js hosting platform.</p>
        </div>
        
        <div class="bg-background rounded-2xl border border-border shadow-sm overflow-hidden">
          <FaqAccordion items={faqs} client:visible />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
