---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import TrustProofBar from '../components/blocks/TrustProofBar.astro';
import { Award, ShieldCheck, Trophy, CheckCircle2, Star, Lock, Cpu, Server } from 'lucide-react';

const awards = [
  { 
    title: "Best High-Speed NVMe Hosting Provider 2026", 
    org: "Cloud Infrastructure Review", 
    year: "2026",
    badge: "1st Place Winner",
    desc: "Awarded 1st place overall for lowest average TTFB (<95ms) and highest database IOPS throughput across 1,000 global benchmarks." 
  },
  { 
    title: "Top 10 Reseller Hosting Provider", 
    org: "HostAdvice Excellence Awards", 
    year: "2021 - 2026",
    badge: "5-Year Consecutive Winner",
    desc: "Recognized 5 years consecutively for white-label cPanel/WHM stability, cPanel licensing value, and Tier-3 reseller support." 
  },
  { 
    title: "Best AI Innovation in Web Development", 
    org: "Global Tech Accolades", 
    year: "2025",
    badge: "Innovation Award",
    desc: "Celebrated for our multi-model AI Co-Pilot website generator, natural language UI editor, and 1-click cloud publishing engine." 
  },
  { 
    title: "User Recommended Host Award", 
    org: "HostAdvice Community Poll", 
    year: "2026",
    badge: "Community Favorite",
    desc: "Voted #1 for customer satisfaction and rapid ticket resolution times by independent web agency and developer clients." 
  },
  { 
    title: "ISO 27001 Certified Security Standard", 
    org: "International Security Organization", 
    year: "Certified 2024-2027",
    badge: "Security Certified",
    desc: "Audited physical hardware security, biometric datacenter access controls, employee credential management, and data encryption." 
  },
  { 
    title: "SOC-2 Type II Datacenter Compliance", 
    org: "AICPA Service Organization Control", 
    year: "Audited Annually",
    badge: "Compliance Certified",
    desc: "Annual third-party audit verifying strict operational security controls, uptime availability, and data confidentiality standards." 
  }
];
---

<Layout 
  title="Industry Awards & Security Certifications | HostingSpell Accolades" 
  description="Explore HostingSpell's industry awards, Best NVMe Hosting 2026 trophies, HostAdvice Top Reseller badges, ISO 27001 certifications, and SOC-2 datacenter compliance."
>
  <Navbar />

  <main class="flex-1 bg-[#000000] text-white">
    
    {/* Hero Section */}
    <section class="relative py-24 bg-[#000000] text-center border-b border-zinc-800/80 overflow-hidden">
      <div class="absolute inset-0 bg-amber-500/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
      
      <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs sm:text-sm font-extrabold uppercase tracking-wider mb-6">
          <Trophy class="w-4 h-4 text-amber-400" />
          <span>Industry Accolades & Trophies</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight mb-6 leading-tight">
          Recognized Globally For <br />
          <span class="bg-gradient-to-r from-amber-300 via-yellow-400 to-amber-200 bg-clip-text text-transparent">Hosting & Security Excellence.</span>
        </h1>

        <p class="text-zinc-300 text-base sm:text-lg max-w-3xl mx-auto leading-relaxed font-medium">
          Honored by independent web hosting auditors, technology reviewers, and security compliance boards worldwide.
        </p>
      </div>
    </section>

    <TrustProofBar />

    {/* Awards Grid */}
    <section class="py-24 bg-[#000000]">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {awards.map(a => (
            <div class="p-8 rounded-3xl bg-zinc-950 border border-zinc-800 space-y-4 flex flex-col justify-between hover:border-amber-500/40 transition">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-amber-400 bg-amber-500/10 px-3 py-1 rounded-full border border-amber-500/20">
                    {a.badge}
                  </span>
                  <span class="text-xs font-mono font-bold text-zinc-500">{a.year}</span>
                </div>

                <div class="p-3.5 rounded-2xl bg-amber-500/15 text-amber-400 w-fit">
                  <Trophy class="w-6 h-6" />
                </div>

                <div class="text-xs font-black uppercase tracking-wider text-zinc-400">{a.org}</div>
                <h3 class="text-xl font-extrabold text-white leading-snug">{a.title}</h3>
                <p class="text-xs text-zinc-400 leading-relaxed font-medium">{a.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
