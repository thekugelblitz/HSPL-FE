---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { Error503Widget } from '../components/blocks/Error503Widget';
---

<Layout title="503 Scheduled Maintenance | HostingSpell" description="High-speed NVMe Gen-4 hardware array upgrades in progress across our global datacenters.">
  <Navbar />

  <main style="background-color: #07080A !important; color: #FFFFFF !important;" class="min-h-[85vh] relative overflow-hidden flex items-center justify-center py-16 px-4">
    {/* Ambient Gold Glow & Mesh Background */}
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-gradient-to-tr from-amber-600/25 via-orange-600/20 to-yellow-600/25 blur-[130px] pointer-events-none rounded-full"></div>
    <div class="absolute inset-0 bg-[radial-gradient(#334155_1px,transparent_1px)] [background-size:24px_24px] opacity-30 pointer-events-none"></div>

    <Error503Widget client:idle />
  </main>

  <Footer />
</Layout>
