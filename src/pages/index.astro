---
// src/pages/index.astro
// HostingSpell Homepage — High-Converting Revenue & AI Funnel (Hosting.com & DreamHost benchmarked)
// Funnel: Hook → Trust Metric Bar → Client Showcase Marquee → Use Case Bento Grid → Pain vs Solution → Pricing Browser → AI Stack → Reviews/Wall of Love → Free Migration → Guarantee Stack → FAQs → Final Conversion CTA.

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';

// Section 1: Hero (Hook with transformation)
import Hero from '../components/blocks/Hero.astro';

// Section 2: Social Proof Strip (135k+ sites, 11+ years, 12+ countries, 100% Uptime)
import SocialProofBar from '../components/blocks/SocialProofBar.astro';

// Section 3: Client Showcase Marquee (Serving Billion+ visitors for industry leaders)
import ClientShowcaseMarquee from '../components/blocks/ClientShowcaseMarquee.astro';

// Section 4: Growth Hosting Platform for Every Use Case (Bento Grid with Tabs)
import UseCaseBento from '../components/blocks/UseCaseBento.astro';

// Section 5: Problem → Solution (Why HostingSpell vs Legacy Hosts)
import ProblemSolutionGrid from '../components/blocks/ProblemSolutionGrid.astro';

// Section 6: Interactive Plan Browser (All categories & plans)
import { PlanBrowser } from '../components/pricing/PlanBrowser';

// Section 7: AI Democratization & 1-Click Apps Stack
import AiDemocratizationSection from '../components/blocks/AiDemocratizationSection.astro';

// Section 8: Customer Reviews & Wall of Love (4.8★ ratings & verified stories)
import HomepageReviews from '../components/blocks/HomepageReviews.astro';

// Section 9: Migration CTA Banner (Zero-downtime free migration)
import MigrationBanner from '../components/blocks/MigrationBanner.astro';

// Section 10: Guarantee Stack (Remove risk, handle objections)
import GuaranteeStack from '../components/blocks/GuaranteeStack.astro';

// Section 11: FAQ (Address final objections)
import FaqAccordion from '../components/blocks/FaqAccordion.astro';

// Section 12: Final Closing Conversion CTA
import FinalCta from '../components/blocks/FinalCta.astro';

import { premiumPlans, faqs } from '../lib/data';

// Top 3 FAQ items for homepage — keep it tight and high-converting
const homepageFaqs = faqs.slice(0, 3);
---

<Layout title="HostingSpell | Ultra-Fast NVMe Cloud & AI Hosting — 135,000+ Sites Powered">
  <Navbar />
  <main class="bg-background overflow-hidden">

    {/* ─── Section 1: Transformation Hero ─── */}
    <Hero />

    {/* ─── Section 2: Social Proof Strip (135k+ sites, 11+ years, 12+ countries) ─── */}
    <SocialProofBar />

    {/* ─── Section 3: Client Showcase Marquee (Serving Billion+ Visitors) ─── */}
    <ClientShowcaseMarquee />

    {/* ─── Section 4: Use Case Bento Section (Hosting.com / Dreamhost Growth Platform) ─── */}
    <UseCaseBento />

    {/* ─── Section 5: Problem → Solution (Why HostingSpell NVMe vs Slow Legacy Hosts) ─── */}
    <ProblemSolutionGrid />

    {/* ─── Section 6: Interactive Plan Browser (All Categories & Plans) ─── */}
    <section class="py-20 border-b border-border/40 bg-muted/10" id="pricing">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <PlanBrowser client:load />
      </div>
    </section>

    {/* ─── Section 7: AI Democratization (AI Studio + 1-Click AI Apps Stack) ─── */}
    <AiDemocratizationSection />

    {/* ─── Section 8: Verified Customer Reviews & Wall of Love (4.8★ Ratings) ─── */}
    <HomepageReviews />

    {/* ─── Section 9: Zero-Downtime Migration CTA Banner ─── */}
    <MigrationBanner />

    {/* ─── Section 10: 30-Day Money-Back Guarantee Stack ─── */}
    <GuaranteeStack />

    {/* ─── Section 11: Quick FAQ Answers (Top Objections Handled) ─── */}
    <section class="py-20 border-b border-border/40">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <h2 class="text-3xl font-extrabold tracking-tight mb-3">Quick Answers</h2>
          <p class="text-muted-foreground">Common questions before you get started.</p>
        </div>

        <div class="max-w-3xl mx-auto">
          <FaqAccordion faqs={homepageFaqs} />
        </div>

        <div class="mt-8 text-center">
          <a href="/contact" class="text-sm font-semibold text-muted-foreground hover:text-foreground transition-colors">
            Have more questions? Talk to our 24/7 team →
          </a>
        </div>
      </div>
    </section>

    {/* ─── Section 12: Final Closing Conversion CTA ─── */}
    <FinalCta />

  </main>
  <Footer />
</Layout>
