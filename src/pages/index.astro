---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/blocks/Hero.astro';
import DomainSearch from '../components/blocks/DomainSearch.astro';
import CostComparison from '../components/blocks/CostComparison.astro';
import { FeatureTabs } from '../components/blocks/FeatureTabs';
import ShowcasePreview from '../components/blocks/ShowcasePreview.astro';
import FeatureCard from '../components/blocks/FeatureCard.astro';
import PricingCard from '../components/blocks/PricingCard.astro';
import DatacenterMap from '../components/blocks/DatacenterMap.astro';
import MigrationBanner from '../components/blocks/MigrationBanner.astro';
import TrustProofBar from '../components/blocks/TrustProofBar.astro';
import CompetitorComparison from '../components/blocks/CompetitorComparison.astro';
import FounderGuarantee from '../components/blocks/FounderGuarantee.astro';
import { FaqAccordion } from '../components/blocks/FaqAccordion';
import { InteractiveSpeedTest } from '../components/blocks/InteractiveSpeedTest';
import { StickyMobileBuyBar } from '../components/blocks/StickyMobileBuyBar';
import { cloudPlans, premiumPlans, vpsPlans, faqs } from '../lib/data';

const features = [
  {
    title: "100% Uptime Mark",
    description: "Our cloud infrastructure guarantees maximum uptime so your website is always online.",
    icon: "Server" as const
  },
  {
    title: "Daily Automated Backups",
    description: "JetBackup 5 automated daily snapshots ensure your data is safe and easily restorable in 1-click.",
    icon: "RefreshCw" as const
  },
  {
    title: "Imunify360 AI Security",
    description: "Proactive AI defense layer blocking malware, DDoS attacks, web defacement, and brute force logins.",
    icon: "Shield" as const
  },
  {
    title: "LiteSpeed Enterprise Server",
    description: "Blazing fast 10x HTTP/3 performance with LiteSpeed web server and native LSCache plugin integration.",
    icon: "Zap" as const
  }
];

const popularCloud = cloudPlans.find(p => p.name === 'MARS') || cloudPlans[1];
const popularPremium = premiumPlans.find(p => p.name === 'PREMIUM 2') || premiumPlans[1];
const popularVps = vpsPlans.find(p => p.name === 'CONSOLUS MODEL') || vpsPlans[1];

const popularPlans = [popularCloud, popularPremium, popularVps];
---

<Layout title="HostingSpell | Next-Gen Ultra-Fast NVMe Cloud Hosting">
  <Navbar />
  <main class="bg-background overflow-hidden">
    <Hero />

    <section class="py-12 border-b border-border/40">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <InteractiveSpeedTest client:visible />
      </div>
    </section>

    <TrustProofBar />
    
    <DomainSearch />

    <section class="py-24" id="pricing">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-semibold uppercase tracking-wider mb-4">
            🔥 Flash Deals - Up to 75% OFF
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4">Transparent Pricing for Every Project</h2>
          <p class="text-muted-foreground text-base max-w-2xl mx-auto">High-performance cloud hosting engineered for developers, businesses, and agency portfolios.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
          {popularPlans.map((plan, index) => (
            <PricingCard {...plan} isPopular={index === 1} ctaText={index === 1 ? "Get Premium Plan" : "Get Started"} />
          ))}
        </div>

        <div class="mt-12 text-center">
          <a href="/pricing" class="inline-flex items-center gap-2 text-primary hover:underline font-semibold text-sm">
            <span>Explore all plans & complete feature comparison matrix &rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <MigrationBanner />

    <CostComparison />

    <CompetitorComparison />

    <FeatureTabs client:visible />

    <DatacenterMap />

    <section class="py-24 bg-muted/20 border-t border-border/40">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold mb-4">Everything You Need to Succeed</h2>
          <p class="text-muted-foreground max-w-xl mx-auto">Our cloud web hosting platform is packed with enterprise-grade features at no extra cost.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {features.map(feature => (
            <FeatureCard {...feature} />
          ))}
        </div>
      </div>
    </section>

    <FounderGuarantee />

    <ShowcasePreview />

    {/* Frequently Asked Questions */}
    <section class="py-24 border-t border-border/40">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <h2 class="text-3xl font-extrabold tracking-tight mb-4">Got Questions? We Have Answers.</h2>
          <p class="text-muted-foreground">Find answers to common questions about HostingSpell cloud hosting.</p>
        </div>

        <div class="max-w-3xl mx-auto">
          <FaqAccordion client:visible faqs={faqs} />
        </div>
      </div>
    </section>

    {/* Tech Partners Trust Badges */}
    <section class="py-14 border-t border-border/40 bg-background">
      <div class="container mx-auto px-4 max-w-screen-2xl text-center">
        <p class="text-xs font-extrabold text-muted-foreground/80 tracking-widest uppercase mb-8">Backed by World-Class Tech Partners</p>
        <div class="flex flex-wrap justify-center items-center gap-4 sm:gap-6 lg:gap-8 xl:gap-10 opacity-85 hover:opacity-100 transition-opacity text-xs sm:text-sm">
          <div class="flex items-center gap-2">
            <img src="https://cdn.simpleicons.org/cpanel/FF6C2C" alt="cPanel" class="h-5 sm:h-6 w-auto object-contain" />
            <span class="font-extrabold text-foreground whitespace-nowrap">cPanel®</span>
          </div>

          <div class="flex items-center gap-2">
            <img src="https://cdn.simpleicons.org/digitalocean/0080FF" alt="DigitalOcean" class="h-5 sm:h-6 w-auto object-contain" />
            <span class="font-extrabold text-foreground whitespace-nowrap">DigitalOcean</span>
          </div>

          <div class="flex items-center gap-2">
            <img src="/brands/linode.svg" alt="Linode" class="h-5 sm:h-6 w-auto object-contain" />
            <span class="font-extrabold text-foreground whitespace-nowrap">Linode</span>
          </div>

          <div class="flex items-center gap-2">
            <img src="https://cdn.simpleicons.org/cloudflare/F38020" alt="Cloudflare" class="h-5 sm:h-6 w-auto object-contain" />
            <span class="font-extrabold text-foreground whitespace-nowrap">Cloudflare</span>
          </div>

          <div class="flex items-center gap-2">
            <img src="https://cdn.simpleicons.org/almalinux" alt="AlmaLinux" class="h-5 sm:h-6 w-auto object-contain dark:invert" />
            <span class="font-extrabold text-foreground whitespace-nowrap">AlmaLinux</span>
          </div>

          <div class="flex items-center gap-2">
            <img src="https://cdn.simpleicons.org/ubuntu/E95420" alt="Ubuntu" class="h-5 sm:h-6 w-auto object-contain" />
            <span class="font-extrabold text-foreground whitespace-nowrap">Ubuntu</span>
          </div>

          <div class="flex items-center gap-2 whitespace-nowrap">
            <svg class="h-5 w-auto text-amber-500 fill-current shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2L2 22h20L12 2zm0 3.99L18.66 19H5.34L12 5.99z"/>
              <path d="M12 9l1.1 2.3 2.5.4-1.8 1.8.4 2.5-2.2-1.2-2.2 1.2.4-2.5-1.8-1.8 2.5-.4L12 9z"/>
            </svg>
            <span class="font-extrabold text-foreground">HostAdvice Top 10 (2021-2026)</span>
          </div>

          <div class="flex items-center gap-2 whitespace-nowrap">
            <svg class="h-5 w-auto text-emerald-400 fill-current shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2c-3.86 0-7 3.14-7 7 0 2.24 1.05 4.22 2.69 5.5l-1.69 5.5 6-3 6 3-1.69-5.5C17.95 13.22 19 11.24 19 9c0-3.86-3.14-7-7-7zm0 10.5c-1.93 0-3.5-1.57-3.5-3.5s1.57-3.5 3.5-3.5 3.5 1.57 3.5 3.5-1.57 3.5-3.5 3.5z"/>
            </svg>
            <span class="font-extrabold text-foreground">HostAdvice Recommended (2021-2026)</span>
          </div>
        </div>
      </div>
    </section>

    <StickyMobileBuyBar client:media="(max-width: 768px)" />
  </main>
  <Footer />
</Layout>
