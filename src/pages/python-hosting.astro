---
import { Button } from "@/components/ui/button";
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import PricingCard from '../components/blocks/PricingCard.astro';
import FeatureCard from '../components/blocks/FeatureCard.astro';
import { FaqAccordion } from '../components/blocks/FaqAccordion';
import { PlanComparisonTable } from '../components/blocks/PlanComparisonTable';
import { pythonPlans, faqs } from '../lib/data';
import { InteractiveSpeedTest } from '../components/blocks/InteractiveSpeedTest';
import MigrationBanner from '../components/blocks/MigrationBanner.astro';
import { Check, Cpu, Zap, Server, Terminal, ArrowRight } from 'lucide-react';

const features = [
  {
    title: "cPanel Python Manager",
    description: "Create and manage Python applications directly from cPanel. Set application root, choose Python version, and run pip install.",
    icon: "layout" as const
  },
  {
    title: "Phusion Passenger (WSGI)",
    description: "Your Python app is served via Phusion Passenger's WSGI interface. Handles process management and concurrency automatically.",
    icon: "zap" as const
  },
  {
    title: "virtualenv / venv Isolation",
    description: "Each Python application gets its own isolated virtual environment. Install different package versions per project with zero conflicts.",
    icon: "shield" as const
  },
  {
    title: "Python 3.8 – 3.12 Support",
    description: "Select from Python 3.8, 3.9, 3.10, 3.11, or 3.12 per application without any system conflicts.",
    icon: "layers" as const
  },
  {
    title: "Django, Flask & FastAPI Ready",
    description: "Deploy any WSGI-compatible Python framework. Django, Flask, FastAPI, Bottle, and Pyramid work out of the box.",
    icon: "rocket" as const
  },
  {
    title: "Scale to VPS When Ready",
    description: "Start on Premium Hosting, upgrade to a VPS when you need more power for demanding Python apps.",
    icon: "trending-up" as const
  }
];
---

<Layout 
  title="Python Hosting - Django, Flask & FastAPI | HostingSpell"
  description="Deploy Python applications including Django, Flask, and FastAPI on HostingSpell cPanel hosting. Powered by Phusion Passenger WSGI, Python Manager, virtualenv support, and easy VPS scaling."
>
  <Navbar />
  
  <main class="flex-1">
    {/* Page Hero - 2-Column Split Hero Layout */}
    <section class="relative bg-background pt-20 pb-24 border-b border-border/40 overflow-hidden">
      <div class="absolute inset-0 bg-primary/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
      <div class="absolute -top-[200px] left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-yellow-500/20 dark:bg-yellow-500/10 rounded-full blur-[100px] pointer-events-none"></div>
      
      <div class="container mx-auto px-4 max-w-screen-xl relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center text-left">
          
          {/* Left Column (7 cols) */}
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center rounded-full border border-yellow-500/30 bg-yellow-500/10 px-3.5 py-1 text-xs font-bold text-amber-400">
              <span class="flex h-2 w-2 rounded-full bg-amber-400 mr-2 animate-pulse"></span> Python 3.12 WSGI Active Engine
            </div>

            <h1 class="text-4xl sm:text-6xl lg:text-6xl font-extrabold tracking-tight leading-[1.1]">
              Deploy Python Apps <br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 via-amber-400 to-blue-400">via cPanel Manager</span>
            </h1>

            <p class="text-base sm:text-lg text-muted-foreground font-medium max-w-xl">
              Run Django, Flask, and FastAPI on cPanel's Python Manager powered by Phusion Passenger WSGI with full virtualenv isolation.
            </p>

            <ul class="space-y-3 text-xs sm:text-sm font-semibold text-foreground">
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-amber-500/15 text-amber-400 border border-amber-500/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>Django, Flask & FastAPI Out-of-the-Box Ready</span>
              </li>
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-amber-500/15 text-amber-400 border border-amber-500/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>Phusion Passenger WSGI Application Server</span>
              </li>
              <li class="flex items-center gap-2.5">
                <div class="p-1 rounded-full bg-amber-500/15 text-amber-400 border border-amber-500/30">
                  <Check class="w-3.5 h-3.5" />
                </div>
                <span>Isolated virtualenv Environments (Python 3.8 – 3.12)</span>
              </li>
            </ul>

            <div class="pt-2 flex flex-col sm:flex-row items-center gap-4">
              <a href="#plans" class="w-full sm:w-auto">
                <Button size="lg" className="w-full h-13 px-8 text-base bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold shadow-xl shadow-amber-500/25 flex items-center justify-center gap-2">
                  <span>View Python Plans</span>
                  <ArrowRight class="w-4 h-4" />
                </Button>
              </a>
              <a href="/vps" class="w-full sm:w-auto">
                <Button size="lg" variant="outline" className="w-full h-13 px-8 text-base font-extrabold hover:bg-amber-500/10 hover:text-amber-400 border-border/80">
                  Dedicated Python VPS
                </Button>
              </a>
            </div>
          </div>

          {/* Right Column (5 cols) - Python WSGI App Visual Card */}
          <div class="lg:col-span-5 relative">
            <div class="glass-card rounded-3xl p-7 border border-amber-500/30 shadow-2xl relative overflow-hidden bg-card/90 backdrop-blur-xl">
              <div class="flex items-center justify-between border-b border-border/60 pb-4 mb-5">
                <div class="flex items-center gap-3">
                  <div class="p-2 rounded-xl bg-amber-500/20 text-amber-400">
                    <Cpu class="w-4 h-4" />
                  </div>
                  <div>
                    <div class="text-xs font-black text-foreground">python passenger_wsgi.py</div>
                    <div class="text-[10px] text-emerald-400 font-bold">🟢 WSGI Worker Active</div>
                  </div>
                </div>
                <span class="text-[10px] font-black uppercase tracking-wider bg-amber-500/20 text-amber-400 border border-amber-500/30 px-2.5 py-1 rounded-full">
                  PYTHON 3.12
                </span>
              </div>

              <div class="grid grid-cols-2 gap-3 mb-5">
                <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60">
                  <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] font-bold mb-1">
                    <Terminal class="w-3.5 h-3.5 text-amber-400" /> Package Manager
                  </div>
                  <div class="text-lg font-black text-foreground">pip install</div>
                </div>

                <div class="p-3.5 rounded-2xl bg-muted/40 border border-border/60">
                  <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] font-bold mb-1">
                    <Zap class="w-3.5 h-3.5 text-blue-400" /> Virtual Env
                  </div>
                  <div class="text-xs font-black text-emerald-400">virtualenv Active</div>
                </div>
              </div>

              <div class="p-4 rounded-2xl bg-gradient-to-r from-amber-500/15 via-amber-500/5 to-transparent border border-amber-500/30 flex items-center justify-between">
                <div>
                  <div class="text-xs font-extrabold text-foreground">Python cPanel Plan</div>
                  <div class="text-[11px] text-muted-foreground">WSGI + Free SSL + Multi-Version</div>
                </div>
                <div class="text-right">
                  <div class="text-lg font-black text-amber-400">$1.99<span class="text-[10px] font-bold text-muted-foreground">/mo</span></div>
                  <span class="text-[9px] font-black uppercase bg-amber-500/20 text-amber-400 px-2 py-0.5 rounded">READY</span>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <section class="py-12 border-t border-border/40">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <InteractiveSpeedTest client:visible />
      </div>
    </section>

    {/* Features Section */}
    <section class="py-20 bg-muted/30">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Why Choose HostingSpell for Python?</h2>
          <p class="text-muted-foreground max-w-2xl mx-auto text-lg">From Django web apps to FastAPI microservices, our cPanel Python hosting is built to deploy your apps reliably without DevOps complexity.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {features.map((feature) => (
            <FeatureCard {...feature} />
          ))}
        </div>
      </div>
    </section>

    <MigrationBanner />

    {/* Pricing Section */}
    <section id="plans" class="py-24 bg-background border-y border-border/40">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Start with Premium Hosting for Python</h2>
          <p class="text-muted-foreground max-w-2xl mx-auto text-lg">Every plan includes cPanel Python Manager and Phusion Passenger WSGI. Deploy Django, Flask, or FastAPI — scale to VPS when you need more.</p>
        </div>
        
        <div class="grid grid-cols-1 max-w-md mx-auto">
          {pythonPlans.map((plan) => (
            <PricingCard {...plan} />
          ))}
        </div>
      </div>
    </section>

    <PlanComparisonTable service="python" client:visible />

    {/* FAQ Section */}
    <section class="py-24 bg-muted/30">
      <div class="container mx-auto px-4 max-w-3xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Frequently Asked Questions</h2>
          <p class="text-muted-foreground text-lg">Find answers to the most common questions about our Python hosting platform.</p>
        </div>
        
        <FaqAccordion items={faqs} client:visible />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
