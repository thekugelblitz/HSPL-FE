---
import { Button } from "@/components/ui/button";
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import PricingCard from '../components/blocks/PricingCard.astro';
import FeatureCard from '../components/blocks/FeatureCard.astro';
import { FaqAccordion } from '../components/blocks/FaqAccordion';
import { premiumPlans, faqs } from '../lib/data';

const features = [
  {
    title: "WSGI Integration",
    description: "Run Django and Flask apps natively through Phusion Passenger WSGI integration.",
    icon: "Server" as const
  },
  {
    title: "Virtual Environments",
    description: "Create isolated Python environments (virtualenv) directly from the dashboard.",
    icon: "Zap" as const
  },
  {
    title: "Python Selector",
    description: "Switch between Python 3.7, 3.8, 3.9, 3.10 and 3.11 with ease.",
    icon: "Shield" as const
  },
  {
    title: "PIP Access",
    description: "Install PIP packages globally or locally via our built-in terminal interface.",
    icon: "RefreshCw" as const
  }
];
---

<Layout 
  title="Python Hosting - Django, Flask & FastAPI Hosting via cPanel | HostingSpell"
  description="Deploy Python applications including Django, Flask, and FastAPI on HostingSpell cPanel hosting. Powered by Phusion Passenger WSGI, Python Manager, virtualenv support, and easy VPS scaling."
>
  <Navbar />
  <main class="flex-1">
    {/* Page Hero */}
    <section class="relative bg-background pt-24 pb-28 border-b border-border/40 overflow-hidden">
      <div class="absolute inset-0 bg-[#3776AB]/5 [mask-image:radial-gradient(ellipse_at_center,white,transparent)]"></div>
      <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-[#FFD43B]/20 rounded-full blur-[120px] pointer-events-none animate-in fade-in duration-1000"></div>
      <div class="absolute bottom-0 left-1/4 w-[400px] h-[400px] bg-[#3776AB]/10 rounded-full blur-[100px] pointer-events-none animate-in fade-in duration-1000 delay-300"></div>
      
      <div class="container mx-auto px-4 max-w-screen-xl text-center relative z-10">
        <div class="inline-flex items-center rounded-full border border-[#3776AB]/30 bg-[#3776AB]/10 px-3 py-1 text-sm font-semibold text-[#3776AB] mb-6 animate-in fade-in slide-in-from-bottom-4 duration-700">
          <span class="flex h-2 w-2 rounded-full bg-[#FFD43B] mr-2 animate-pulse"></span> Django & Flask Ready
        </div>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold tracking-tight mb-6 animate-in fade-in slide-in-from-bottom-6 duration-700 delay-150 fill-mode-both">
          Optimized <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#3776AB] to-[#FFD43B]">Python Hosting</span>
        </h1>
        <p class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto mb-10 animate-in fade-in slide-in-from-bottom-4 duration-700 delay-300 fill-mode-both">
          Deploy robust Python applications instantly. Full WSGI support, virtual environments, and automated dependency management.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-in fade-in slide-in-from-bottom-4 duration-700 delay-500 fill-mode-both">
          <a href="#plans">
            <Button size="lg" className="h-12 px-8 text-base bg-[#3776AB] hover:bg-[#2d618c] shadow-lg shadow-[#3776AB]/25 transition-all group overflow-hidden relative font-bold text-white">
              <span class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></span>
              <span class="relative">View Python Plans</span>
            </Button>
          </a>
          <a href="/contact">
            <Button size="lg" variant="outline" className="h-12 px-8 text-base font-bold hover:bg-[#3776AB]/10 hover:text-[#3776AB] border-border/60 transition-colors">
              Contact Sales
            </Button>
          </a>
        </div>
      </div>
    </section>

    {/* Pricing Section */}
    <section class="py-24" id="plans">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold mb-4">Python Optimized Plans</h2>
          <p class="text-muted-foreground">High-performance hosting for demanding Python web applications.</p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
          {premiumPlans.map(plan => (
            <PricingCard {...plan} />
          ))}
        </div>
      </div>
    </section>

    {/* Features Section */}
    <section class="py-24 bg-muted/30">
      <div class="container mx-auto px-4 max-w-screen-xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold mb-4">Why Choose Us for Python?</h2>
          <p class="text-muted-foreground">We provide all the tools required for a smooth Python deployment workflow.</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {features.map(feature => (
            <FeatureCard {...feature} />
          ))}
        </div>
      </div>
    </section>

    {/* FAQ Section */}
    <section class="py-24">
      <div class="container mx-auto px-4 max-w-3xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold mb-4">Python Hosting FAQ</h2>
          <p class="text-muted-foreground">Got questions? We've got answers.</p>
        </div>
        <FaqAccordion items={faqs} client:visible />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
